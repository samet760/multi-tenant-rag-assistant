@page
@model arayuz.Pages.BelgelerModel
@{
    ViewData["Title"] = "Belgelerim";
    ViewData["TamGenislik"] = true;
}

<style>
    .belge-baglantisi {
        color: var(--bs-body-color);
        text-decoration: none;
    }

    .belge-baglantisi:hover {
        text-decoration: underline;
    }
</style>

<div class="d-flex" style="height:100%;">
    <div class="border-end" style="width:260px;">
        <div class="p-3 h-100">
            @await Component.InvokeAsync("SohbetPaneli")
        </div>
    </div>
    <div class="flex-grow-1 ps-3" style="overflow-y:auto; min-width:0;">
        @if (Model.DepartmanId == null)
        {
            <h2>Belgelerim</h2>

            @if (Model.Departmanlar.Count == 0)
            {
                <p>Görüntüleyebileceğiniz bir departman bulunamadı.</p>
            }
            else
            {
                <div class="list-group" style="max-width:400px">
                    @foreach (var dep in Model.Departmanlar)
                    {
                        <a href="/Belgeler?departmanId=@dep.Id" class="list-group-item list-group-item-action">
                            @dep.Ad
                        </a>
                    }
                </div>
            }
        }
        else
        {
            <p><a href="/Belgeler">&larr; Departmanlara dön</a></p>
            <h2>@Model.SeciliDepartmanAdi</h2>

            <form method="get" class="input-group mb-3" style="max-width:400px">
                <input type="hidden" name="departmanId" value="@Model.DepartmanId" />
                <input asp-for="Ara" class="form-control" placeholder="Dosya adına göre ara" />
                <button type="submit" class="btn btn-outline-primary">Ara</button>
            </form>

            @if (!string.IsNullOrEmpty(Model.Ara))
            {
                <p><a href="/Belgeler?departmanId=@Model.DepartmanId">Temizle</a></p>
            }

            @if (Model.Liste.Count == 0)
            {
                if (string.IsNullOrEmpty(Model.Ara))
                {
                    <p>Bu departmanda erişebileceğiniz bir belge bulunamadı.</p>
                }
                else
                {
                    <p>Eşleşen belge bulunamadı.</p>
                }
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Dosya</th>
                            <th>Yükleme</th>
                            <th>Parça</th>
                            @if (User.IsInRole("yonetici"))
                            {
                                <th></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var belge in Model.Liste)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(belge.DosyaYolu))
                                    {
                                        <a href="/BelgeIndir?id=@belge.Id" target="_blank" class="belge-baglantisi">@belge.DosyaAdi</a>
                                    }
                                    else
                                    {
                                        @belge.DosyaAdi
                                    }
                                </td>
                                <td>@belge.Tarih.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@belge.ParcaSayisi</td>
                                @if (User.IsInRole("yonetici"))
                                {
                                    <td>
                                        <form method="post" asp-page-handler="Sil">
                                            <input type="hidden" name="id" value="@belge.Id" />
                                            <input type="hidden" name="departmanId" value="@Model.DepartmanId" />
                                            <button type="submit" class="btn btn-sm btn-danger"
                                                    onclick="return confirm('@belge.DosyaAdi silinsin mi?');">
                                                Sil
                                            </button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>
</div>
