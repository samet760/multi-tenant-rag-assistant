@page
@model arayuz.Pages.BelgeDuzenleModel
@{
    ViewData["Title"] = "Belgeyi Düzenle";
}

<p><a href="/Belgeler">&larr; Belgelere dön</a></p>

@if (!Model.Bulundu)
{
    <div class="alert alert-danger">@Model.Hata</div>
}
else
{
    <h2>Belgeyi Düzenle</h2>

    @if (Model.Hata != null)
    {
        <div class="alert alert-danger">@Model.Hata</div>
    }

    <form method="post" style="max-width:400px">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label">Dosya</label>
            <input type="text" value="@Model.DosyaAdi" class="form-control" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">Departman</label>
            <select asp-for="DepartmanId" class="form-select" required>
                <option value="" selected disabled>Departman seçin</option>
                @foreach (var d in Model.Departmanlar)
                {
                    <option value="@d.Id">@d.Ad</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Erişim Seviyesi</label>
            <select asp-for="ErisimSeviyesi" class="form-select" required>
                <option value="" selected disabled>Erişim seviyesi seçin</option>
                <option value="sirket">Şirket Geneli</option>
                <option value="departman">Sadece Departman</option>
            </select>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a href="/Belgeler" class="btn btn-outline-secondary">Geri</a>
        </div>
    </form>
}
