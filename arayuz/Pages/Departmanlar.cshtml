@page
@model arayuz.Pages.DepartmanlarModel
@{
    ViewData["Title"] = "Departmanlar";
}

<h2>Departmanlar</h2>

@if (!string.IsNullOrEmpty(Model.Hata))
{
    <div class="alert alert-danger">@Model.Hata</div>
}

<form method="post" asp-page-handler="Ekle" class="mb-4" style="max-width: 400px;">
    <div class="mb-2">
        <label class="form-label">Yeni departman adı</label>
        <input type="text" asp-for="YeniAd" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary btn-sm">Ekle</button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Ad</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.Liste)
        {
            <tr>
                <td>@d.Ad</td>
                <td>
                    <div class="d-flex gap-2">
                        <form method="post" asp-page-handler="YenidenAdlandir" class="d-flex gap-2">
                            <input type="hidden" name="id" value="@d.Id" />
                            <input type="text" name="ad" value="@d.Ad" class="form-control form-control-sm" style="max-width: 220px;" required />
                            <button type="submit" class="btn btn-sm btn-secondary">Yeniden adlandır</button>
                        </form>
                        <form method="post" asp-page-handler="Sil">
                            <input type="hidden" name="id" value="@d.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('@d.Ad silinsin mi?');">
                                Sil
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
