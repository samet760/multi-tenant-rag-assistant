@page
@model arayuz.Pages.IndexModel
@{
    ViewData["Title"] = "Sorgu";
}

<form method="post" id="soru-formu">
    <div class="mb-3">
        <input asp-for="Soru" class="form-control" placeholder="Sorunuzu yazın" />
    </div>
    <button type="submit" class="btn btn-primary" id="sor-dugmesi">Sor</button>
</form>

@if (!string.IsNullOrEmpty(Model.Cevap))
{
    <div class="mt-4">
        <div class="text-muted small">@Model.SorulanSoru</div>
        <div class="alert alert-secondary mt-1">
            @Model.Cevap
        </div>
    </div>
}


<script>
    document.getElementById("soru-formu").addEventListener("submit", function () {
        var dugme = document.getElementById("sor-dugmesi");
        dugme.disabled = true;
        dugme.textContent = "Bekleyin...";
    });
</script>
