@page
@model arayuz.Pages.IndexModel

@{
    ViewData["Title"] = "Sorgu";
}

<style>
    .yeni-sohbet-dugmesi .yeni-sohbet-metni {
        display: none;
        margin-left: 4px;
    }

    .yeni-sohbet-dugmesi:hover .yeni-sohbet-metni {
        display: inline;
    }

    .chat-balon {
        border-radius: 1rem;
    }

    .yaziyor-balonu .nokta {
        display: inline-block;
        font-size: 1.5rem;
        line-height: 0;
        animation: noktaYanipSon 1.4s infinite ease-in-out both;
    }

    .yaziyor-balonu .nokta:nth-child(1) {
        animation-delay: -0.32s;
    }

    .yaziyor-balonu .nokta:nth-child(2) {
        animation-delay: -0.16s;
    }

    @@keyframes noktaYanipSon {
        0%, 80%, 100% {
            opacity: 0.2;
        }

        40% {
            opacity: 1;
        }
    }
</style>

<div class="row">
    <div class="col-3">
        <a asp-page="/Index" class="btn btn-sm btn-outline-primary w-100 mb-3 yeni-sohbet-dugmesi">
            <span>+</span>
            <span class="yeni-sohbet-metni">Yeni sohbet</span>
        </a>
        <div class="list-group">
            @foreach (var s in Model.Sohbetler)
            {
                <a asp-page="/Index" asp-route-sohbetId="@s.Id"
                   class="list-group-item list-group-item-action text-truncate @(Model.SohbetId == s.Id ? "active" : "")">
                    @s.Baslik
                </a>
            }
        </div>
    </div>

    <div class="col-9">
        <div id="mesajKutusu" class="mb-3" style="height:60vh; overflow-y:auto">
            @foreach (var m in Model.Mesajlar)
            {
                if (m.Rol == "soru")
                {
                    <div class="d-flex justify-content-end mb-2">
                        <div class="alert alert-primary mb-0 chat-balon" style="max-width:70%;">@m.Metin</div>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-start mb-2">
                        <div class="alert alert-secondary mb-0 chat-balon" style="max-width:70%;">@m.Metin</div>
                    </div>
                }
            }
        </div>

        <form method="post" id="soru-formu" class="input-group">
            <input type="hidden" name="SohbetId" value="@Model.SohbetId" />
            <input asp-for="Soru" class="form-control" placeholder="Sorunuzu yazın" />
            <button type="submit" class="btn btn-primary" id="sor-dugmesi">Sor</button>
        </form>
    </div>
</div>

<script>
    (function () {
        var kutu = document.getElementById("mesajKutusu");
        kutu.scrollTop = kutu.scrollHeight;
    })();
</script>

<script>
    document.getElementById("soru-formu").addEventListener("submit", function () {
        var dugme = document.getElementById("sor-dugmesi");
        dugme.disabled = true;
        dugme.textContent = "Bekleyin...";

        var kutu = document.getElementById("mesajKutusu");
        var soruMetni = document.getElementById("Soru").value;

        var soruBalonu = document.createElement("div");
        soruBalonu.className = "d-flex justify-content-end mb-2";
        soruBalonu.innerHTML = '<div class="alert alert-primary mb-0 chat-balon" style="max-width:70%;"></div>';
        soruBalonu.querySelector("div").textContent = soruMetni;
        kutu.appendChild(soruBalonu);

        var yaziyorSatiri = document.createElement("div");
        yaziyorSatiri.className = "d-flex justify-content-start mb-2 yaziyor-satiri";
        yaziyorSatiri.innerHTML =
            '<div class="alert alert-secondary mb-0 chat-balon yaziyor-balonu" style="max-width:70%;">' +
            '<span class="nokta">.</span><span class="nokta">.</span><span class="nokta">.</span>' +
            '</div>';
        kutu.appendChild(yaziyorSatiri);

        kutu.scrollTop = kutu.scrollHeight;
    });
</script>
