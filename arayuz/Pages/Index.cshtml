@page
@model arayuz.Pages.IndexModel

@{
    ViewData["Title"] = "Sorgu";
    ViewData["TamGenislik"] = true;
    ViewData["SayfaKaydirmasiz"] = true;
}

<style>
    .chat-balon {
        border-radius: 1.25rem;
        padding: 1rem 1.4rem;
    }

    .yaziyor-balonu .nokta {
        display: inline-block;
        font-size: 1.5rem;
        line-height: 0;
        animation: noktaYanipSon 1.4s infinite ease-in-out both;
        position: relative;
        z-index: 2;
    }

    .yaziyor-balonu .nokta:nth-child(1) {
        animation-delay: -0.32s;
    }

    .yaziyor-balonu .nokta:nth-child(2) {
        animation-delay: -0.16s;
    }

    @@keyframes noktaYanipSon {
        0%, 80%, 100% {
            opacity: 0.2;
        }

        40% {
            opacity: 1;
        }
    }

    .yaziyor-balonu {
        position: relative;
        z-index: 1;
        overflow: visible;
    }

    /* Kabuk: gorunur kenarlik/arkaplan/sekil BURADA - textarea buyudukce
       kabuk (sabit yukseklik YOK) dogal olarak asagi buyur, radius SABIT
       kalir (yukseklige gore yeniden olceklenen 999px DEGIL) - coklu
       satirda "sisirilmis oval/kapsul" olusmaz, tek satirda hala belirgin
       yuvarlak/hap gibi okunur. */
    .soru-formu-kabuk {
        /* Buton flex-item DEGIL, kabugun sag-alt kosesine mutlak konumlanir
           (bkz. .soru-formu-dugme) - bu yuzden kabuk butonun konumlanma
           referansi olmasi icin position:relative olur. */
        position: relative;
        border: 1px solid var(--bs-border-color);
        border-radius: 1.75rem;
        background-color: var(--bs-body-bg);
        padding: 0.375rem 0.375rem 0.375rem 1.25rem;
        transition: border-color .15s ease-in-out;
    }

    /* --- Composer'da "tek satir / coklu satir" MODU YOKTUR ---------------
       Kutunun geometrisi (padding'ler, buton konumu, metin genisligi) metin
       kac satir olursa olsun DEGISMEZ; buyuyen tek sey textarea'nin
       yuksekligi. Bu bilincli bir tercih:

       Onceden coklu satirda textarea'nin sag padding'i 3.75rem -> 0.25rem'e
       dusuruluyordu (metin tam genisligi kullansin diye). Ama JS yuksekligi
       DAR geometride olcup GENIS geometriye uyguluyordu: 2. satira yeni
       tasmis kelime genis kutuda 1. satira geri sigiyor, sonraki tusta
       olcum genis modda yapilinca mod geri kalkiyor, metin tekrar sariyor...
       Sinirda her tusta 54px <-> 122px arasi titriyordu (olculdu: tek bir
       cumle yazarken 7 kez mod degisimi).

       Genisligi sabit tutunca bu geri besleme dongusu YAPISAL olarak
       imkansiz hale gelir ve kutu her yeni satirda tek tip ~24px'lik adimla
       buyur. Bedeli: metin en sagdaki ~56px'lik buton seridini hicbir
       satirda kullanmaz - kabul edilen takas budur. Buraya tekrar bir mod
       eklemeden once yukaridaki dongu problemini cozdugunden emin ol. */

    .soru-formu-girdi {
        /* Kendi kenarligi/arkaplani/golgesi YOK - hepsi .soru-formu-kabuk'a
           ait. Textarea sadece metni ve otomatik buyume/kaydirmayi yonetir. */
        border: none;
        border-radius: 0;
        outline: none;
        box-shadow: none;
        background: transparent;
        /* Sag padding HER SATIRDA gecerlidir (satir sayisina gore DEGISMEZ,
           bkz. yukaridaki "MODU YOKTUR" notu): mutlak konumlanan gonder
           butonu (2.5rem genislik, kabugun sag kenarindan 0.375rem icerde)
           icin guvenli bosluk ayirir (~60px, buton ile metin arasinda kucuk
           bir bosluk dahil) - metin hicbir satirda butonun altina girmez.
           Kaydirma cubugu overflow-y:auto olunca textarea'nin KENDI sag
           kenarinda (kabugun sag kenarina ~0.375rem yakin) belirir - butonun
           ayni koseyi kapladigi kisimda butonun ARKASINDA/ALTINDA kalir,
           kabuk'un uzerinde "yuzen" bos bir sutun OLUSTURMAZ. */
        padding: 0.5rem 3.75rem 0.5rem 0.25rem;
        margin: 0;
        /* Acikca verilir: JS tek satir referansini bu degerden hesaplar
           (bkz. tekSatirYuksekligi) - kalkarsa "normal" hesaplanir. */
        line-height: 1.5;
        /* TEK kaynak: ~5 satir + dikey padding. JS (otomatikBoyutlandir)
           buyume tavanini buradan, getComputedStyle(...).maxHeight ile okur -
           ikinci bir sayi ELLE tekrarlanmaz. */
        --soru-girdi-maks-yukseklik: 9rem;
        max-height: var(--soru-girdi-maks-yukseklik);
        /* SADECE .tasiyor durumunda kullanilir - bkz. asagidaki kural. */
        --soru-buton-serit: 2.625rem;
        min-width: 0;
        width: 100%;
        resize: none;
        overflow-x: hidden;
        overflow-y: hidden;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        /* #mesajKutusu'nda kullanilan AYNI ince/tema-renkli kaydirma cubugu -
           kaydirma cubugu belirince sag kenarda ince, tutarli bir sekilde
           gorunur, kalin/varsayilan tarayici cubugu gibi metni sikistirmaz. */
        scrollbar-width: thin;
        scrollbar-color: var(--bs-secondary-color) transparent;
    }

    /* site.css .form-control:focus mavi/beyaz cift box-shadow ekliyor -
       textarea'nin kendi kenarligi zaten yok ama .form-control class'i
       uzerinden bu odak suslemesi yine de gelebilir, #Soru id secici
       (class'lardan daha yuksek ozgunluk) onu gecersiz kilar. */
    #Soru:focus,
    #Soru:focus-visible {
        outline: 0;
        box-shadow: none;
    }

    /* Kaydirma cubugu (overflow-y:auto) textarea'nin KENDI kutusunun (padding
       dahil) TAM yuksekligi boyunca cizilir - padding-right/bottom bunu
       KISALTMAZ, browser scrollbar track'ini her zaman padding box'in tam
       boyunca gezdirir. Sag padding (3.75rem) sadece METNI butonun altina
       girmekten korur, kaydirma cubugunu DEGIL - cubuk textarea'nin KENDI
       sag kenarinda (kabuk'a ~0.375rem yakin) belirir, ki bu AYNI x konumu
       butonun da bulundugu yer - yani icerik tavani (9rem) asip kaydirma
       cubugu belirdiginde cubuk ile buton gorsel olarak IC ICE giriyordu.
       JS (otomatikBoyutlandir) tavan asilinca bu class'i ekler: textarea'nin
       ALTINA butonun tam oturdugu kadar bir MARGIN (padding DEGIL) birakir.
       Margin kutunun DISINDA kaldigi icin kaydirma cubugu oraya hic uzanmaz -
       kutu artik butonun USTUNDE durur, ustune binmez. Tavan da ayni miktarda
       dusurulur ki toplam yukseklik (metin + bosluk) onceki tavanla ayni
       kalsin (composer daha da uzamaz). */
    .soru-formu-girdi.tasiyor {
        max-height: calc(var(--soru-girdi-maks-yukseklik) - var(--soru-buton-serit));
        margin-bottom: var(--soru-buton-serit);
    }

    .soru-formu-girdi.soru-girdi-temizlendi {
        color: transparent;
        caret-color: transparent;
    }

    .soru-formu-dugme {
        /* Flex-item DEGIL - .soru-formu-kabuk'un (position:relative) sag-alt
           kosesine mutlak konumlanir: metin 1 satirdan 5 satira cikarken
           butonun kabuga gore konumu/boyutu HICBIR SEKILDE degismez, satir
           akisindan tamamen bagimsizdir. Isgal ettigi kose metinden
           .soru-formu-girdi'nin sabit sag padding'i ile kurtarilir. */
        position: absolute;
        right: 0.375rem;
        bottom: 0.375rem;
        z-index: 1;
        width: 2.5rem;
        height: 2.5rem;
        padding: 0;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .sor-spinner-simge {
        display: none;
    }

    #sor-dugmesi.yukleniyor .sor-ok-simge {
        display: none;
    }

    #sor-dugmesi.yukleniyor .sor-spinner-simge {
        display: inline-block;
        animation: sorSpinnerDon 0.8s linear infinite;
    }

    @@keyframes sorSpinnerDon {
        to {
            transform: rotate(360deg);
        }
    }

    #sor-dugmesi {
        background-image: linear-gradient(135deg, #f59e0b, #f97316);
        background-color: #f59e0b;
        border-color: transparent;
        color: #fff;
        box-shadow: none;
        transition: filter .15s ease-in-out, box-shadow .15s ease-in-out, border-color .15s ease-in-out;
    }

    #sor-dugmesi:hover {
        filter: brightness(1.06);
        border-color: transparent;
        color: #fff;
    }

    #sor-dugmesi:focus-visible {
        outline: 0;
        border-color: transparent;
        box-shadow: 0 0 0 0.2rem rgba(245, 158, 11, 0.45);
    }

    #sor-dugmesi:active {
        filter: brightness(0.92);
        border-color: transparent;
        color: #fff;
        box-shadow: none;
    }

    #sor-dugmesi:active:focus-visible {
        box-shadow: 0 0 0 0.2rem rgba(245, 158, 11, 0.45);
    }

    [data-bs-theme="dark"] #sor-dugmesi {
        background-image: linear-gradient(135deg, #4f46e5, #7c3aed);
        background-color: #4f46e5;
    }

    [data-bs-theme="dark"] #sor-dugmesi:focus-visible,
    [data-bs-theme="dark"] #sor-dugmesi:active:focus-visible {
        box-shadow: 0 0 0 0.2rem rgba(124, 58, 237, 0.5);
    }

    #mesajKutusu {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
        position: relative;
        z-index: 0;
        scrollbar-width: thin;
        scrollbar-color: var(--bs-secondary-color) transparent;
    }

    /* Mesaj yokken kaydiracak gercek icerik de yok - #parlama'nin (300px,
       konumu/boyutu/animasyonu HIC DEGISMEDI) kisa pencerelerde #mesajKutusu'nun
       gorunur alanindan tasan kismi, boyle bir kaydirma cubugu OLUSTURMADAN
       (overflow:hidden) sessizce kirpilir. #mesajKutusu.overflow-y:auto'nun
       KENDISI DEGISMEDI - sadece bu ID+class birlesimi, ID'den daha yuksek
       ozgunlukle, SADECE bos sohbet durumunda onu gecersiz kilar. */
    #mesajKutusu.mesaj-kutusu-bos {
        overflow-y: hidden;
    }

    .mesaj-satiri {
        width: 100%;
        max-width: 800px;
    }

    .balon-soru {
        background-color: var(--bs-secondary-bg);
        color: var(--bs-body-color);
        /* balon, ".d-flex justify-content-end" satirinin bir flex-item'i - bosluksuz
           uzun bir metin, varsayilan min-width:auto yuzunden max-width:70%'i yok
           sayip satiri yatay taşırabiliyordu. min-width:0 bu korumayi kaldirir,
           overflow-wrap:anywhere kirilacak bosluk olmasa bile metni balonun icinde
           tutar (kesme/truncate YOK, sadece satir icinde sarilir). */
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .balon-cevap {
        background-color: var(--bs-tertiary-bg);
        color: var(--bs-body-color);
        border: 1px solid var(--bs-border-color);
        /* balon-soru ile ayni sebep/cozum: ".d-flex justify-content-start"
           satirinin bir flex-item'i - min-width:0 + overflow-wrap:anywhere,
           bosluksuz uzun cevap metninin max-width:70%'i yatay tasirmasini
           onler, kesme/truncate yapmadan satir icinde sarar. */
        min-width: 0;
        overflow-wrap: anywhere;
    }

    #selamlama {
        position: absolute;
        top: calc(50% - 100px);
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1;
        text-align: center;
        width: max-content;
        max-width: 90%;
    }

    #selamlama-baslik {
        font-size: 1.6rem;
        color: var(--bs-body-color);
    }

    #selamlama-alt {
        font-size: 0.95rem;
        color: var(--bs-secondary-color);
        margin-top: 0.25rem;
    }

    #parlama {
        --parlama-1: #fbbf24;
        --parlama-2: #fb923c;
        --parlama-3: #ef4444;
        position: absolute;
        top: calc(50% + 80px);
        left: 50%;
        width: 300px;
        height: 300px;
        pointer-events: none;
        z-index: -1;
        opacity: 1;
        transform: translate(-50%, -50%);
        transition: top 1s ease, left 1s ease, right 1s ease, bottom 1s ease,
                    width 1s ease, height 1s ease, opacity 0.8s ease;
    }

    [data-bs-theme="dark"] #parlama {
        --parlama-1: #4f46e5;
        --parlama-2: #9333ea;
        --parlama-3: #7c3aed;
    }

    #parlama.parlama-gizli {
        opacity: 0;
    }

    /* GECICI TANI: collapse'in son kismindan itibaren, TAM temas noktasinda
       birakilan kucuk "enerji rezervi" - kalici dis yuzey/hale/orb DEGIL,
       sadece bir sonraki asamada cevre akisinin cikis noktasi olacak, sabit,
       yumusak bir leke (bkz. JS: temasEnerjisiOlustur). position:fixed -
       #parlama'nin GECICI temas hesabiyla AYNI viewport koordinat sistemini
       (getBoundingClientRect) kullanir, balonun kendi ic DOM agacina hic
       eklenmez (kalici dis yuzeyle KARISTIRILMASIN). */
    .temas-enerjisi {
        --temas-1: #fde047;
        --temas-2: #f97316;
        position: fixed;
        z-index: 2;
        width: 11px;
        height: 11px;
        border-radius: 50%;
        pointer-events: none;
        opacity: 0;
        filter: blur(3px);
        background: radial-gradient(circle, var(--temas-1) 0%, var(--temas-2) 55%, transparent 78%);
    }

    [data-bs-theme="dark"] .temas-enerjisi {
        --temas-1: #a78bfa;
        --temas-2: #7c3aed;
    }

    .parlama-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
    }

    /* Asama 2: #parlama.parlama-balonda (balonun ICINE kalici, kucuk/donen bir
       kopya birakan eski FLIP-sonrasi hali) ve @@keyframes parlamaSalinimKucuk
       KALDIRILDI - "balonun arkasinda kucuk bir Şey kopyasi" fikri terk edildi.
       Seyahatin sonunda #parlama artik BALONA HIC EKLENMIYOR; tamamen gizlenip
       (parlama-gizli) yerini asagidaki kabul edilmis hale/tutam sistemi aliyor
       (bkz. JS: parlamayiBalonaTasi/balonuEtkinlestir). */

    /* Sonraki mesaj yukleme parlaklik efekti (Asama 1, 4. ve son duzeltme): satir
       duzeyinde konumlandirma TAMAMEN KALDIRILDI - .yaziyor-satiri genisligi (800px'e
       kadar) balonun kendi genisligiyle AYNI degil (justify-content:start balonu sola
       yasliyor), bu yuzden satirin %50'si balonun merkeziyle CAKISMIYORDU ve parlama
       balondan uzakta/kirpilmis gorunuyordu. Cozum: parlaklik artik DOGRUDAN balonun
       (.yaziyor-balonu) kendi ICINDE, position:absolute + inset ile - otomatik olarak
       balonu takip eder, hicbir getBoundingClientRect/rect hesabi gerekmez.
       Sorun: bir cocuk, kendi ebeveyninin arka planinin ONUNE asla gecemez (z-index
       sadece KARDESLER arasi sirayi belirler) - yani parlaklik balonun ICINDE bir
       cocuksa, balonun GRI arka planinin ARKASINDA duramaz. Cozum: griyi ".sonraki-hale"
       balonunun kendisinden .yaziyor-arkaplan adli ayri, ayni boyutta bir "backdrop"
       katmanina tasidik (bkz. asagi) - boylece ucu: parlaklik (altta) -> backdrop
       (grinin kendisi, ortada) -> noktalar (ustte), hepsi ayni balonun icinde, KARDES
       olarak. Balonun kendi kutusu/padding/max-width/genisligi/yuksekligi DEGISMEDI -
       sadece arka plan RENGI backdrop katmanina tasindi (.balon-cevap DEGISTIRILMEDI,
       diger tum balonlar etkilenmez). requestAnimationFrame/canvas motoruna hic
       dokunulmaz - bu tamamen ayri, hafif bir CSS animasyonudur. */
    /* --yuzey-1/2 burada (balonun kendisinde) tanimlanir, .yaziyor-yuzey'de DEGIL -
       boylece Asama 3'te eklenen .yaziyor-akis (kardes bir SVG katmani, bkz. asagi)
       AYNI degiskenleri miras alarak kullanabilir; renkler TEK yerde tanimli kalir,
       hicbir deger degismedi/kopyalanmadi, sadece tanim yeri tasindi. */
    .yaziyor-balonu.sonraki-hale {
        --yuzey-1: 253, 224, 71;
        --yuzey-2: 249, 115, 22;
        background-color: transparent;
        border-color: transparent;
    }

    [data-bs-theme="dark"] .yaziyor-balonu.sonraki-hale {
        --yuzey-1: 167, 139, 250;
        --yuzey-2: 124, 58, 237;
    }

    /* Kirpilma duzeltmesi: #mesajKutusu'nun KENDISI DEGISTIRILMEDI (tum sohbetin
       overflow-y:auto scroll davranisi aynen korunuyor). Sorun sudur: her sonraki
       mesaj gonderiminde "kutu.scrollTop = kutu.scrollHeight" calisir ve bu satiri
       (+ onun mb-3 = ~16px marjini) #mesajKutusu'nun GORUNEN kutusunun ALT KIRPMA
       SINIRINA tam yaslar. Asama 1A'nin kendi degeri (1.5rem) korunuyordu ama Asama
       1B'nin tutam'lari (bkz. asagi, .yaziyor-tutam) bazen ~20-24px + blur kadar
       asagi dogru da tasabiliyor - bu yuzden SADECE bu satirin payi 2rem'e
       cikarildi (Asama 1A halesinin kendi degerleri DEGISMEDI). margin-bottom degil
       padding-bottom kullanildi: Bootstrap'in .mb-3 sinifi !important kullaniyor,
       margin-bottom onu ezemezdi. */
    .yaziyor-satiri.sonraki-hale {
        padding-bottom: 2rem;
    }

    /* Tamamlanmis dis enerji yuzeyi: balonun YUVARLATILMIS silueti boyunca ince,
       "doldurulmus bir kanal" hissi veren yakin bir katman. background YOK -
       yalnizca box-shadow kullanildi, cunku box-shadow HER ZAMAN border-radius'u
       (burada inherit ile balonun kendi 1.25rem'i) birebir takip eder; bu yuzden
       koseler dahil tum cevre dogal olarak yuvarlak kalir, dortgen bir parlama
       asla olusmaz. Dort ust uste binen golge katmani KASITLI OLARAK simetrik
       DEGIL (farkli x/y kaymalari + iki farkli renk) - tek duz/esit bir cizgi
       yerine hafif organik, bolgeden bolgeye yogunlugu degisen bir gorunum verir.
       Hicbir katmanin blur'u 0 DEGIL (ilk katman haric, o da opaklik ~0.2 ile
       kasitli olarak cok zayif) - bu yuzden sonuc bir "kenarlik/neon cizgi" degil,
       yumusak bir isik olarak okunur. z-index:0, .yaziyor-parlak/.yaziyor-tutam
       ile AYNI katmanda ama DOM'da onlardan SONRA (bkz. JS) - boylece hem onlarin
       UZERINDE gorunur (daha "yakin/yogun" hissi) hem de aktif bir tutam, koku bu
       yuzeyin hemen altindan/icinden cikiyormus gibi gorunur. Griyi tasiyan
       backdrop (z-index:1) hala ONUNDE durur; box-shadow zaten yalnizca kutunun
       DISINA cizildigi icin balonun ic gorunumune hicbir sekilde karismaz. */
    .yaziyor-yuzey {
        position: absolute;
        inset: -1px;
        z-index: 0;
        pointer-events: none;
        border-radius: inherit;
        box-shadow:
            0 0 0 1px rgba(var(--yuzey-1), 0.2),
            -1px 1px 3px 0 rgba(var(--yuzey-1), 0.5),
            1.5px -1px 4px 0.5px rgba(var(--yuzey-2), 0.42),
            0 1.5px 6px 1px rgba(var(--yuzey-2), 0.26);
    }

    /* MIMARI - ilk mesajin KALICI cevre yuzeyi: SADECE ilk mesaj gecisinde,
       calisma-zamaninda eklenir (bkz. JS: cevreAkisiKur/cevreAkisiCalistir).
       Sonraki mesajlarda bu SVG hic olusturulmaz. DORT <rect>, balonun
       GERCEK olcusune/kose yaricapina gore JS'ten kurulur - ikisi "govde/iz"
       (yaziyor-akis-yol: temas noktasindan buyuyen, GUCLU/BELIRGIN dolu
       kisim - BU KATMAN KALICI: %100 dolunca hicbir zaman soldurulmez/
       kaldirilmaz VE dimlenmez, ilk mesajin nihai dis derisi olarak KALIR),
       ikisi "uc" (yaziyor-akis-uc: govdenin o anki HAREKETLI ucunu takip
       eden, KISA/daha parlak bir segment - "akan enerjinin nerede oldugunu"
       okunakli kilmak icin; akis tamamlanmadan hemen once SONER, govde/iz'in
       duz nihai gorunumune karisir). stroke-dasharray/-dashoffset
       Element.animate() ile canlandirilir. overflow:visible ZORUNLU -
       SVG'nin varsayilani "hidden"dir, aksi halde stroke/drop-shadow tasan
       kisimlari kirpilirdi. Govde/iz'in alfasi (0.92, KEZ KESKIN/bulanmamis
       bir cekirdek olarak - bkz. asagi) VE opakligi (akis boyunca sabit 1)
       kasitli olarak .yaziyor-yuzey'in (sonraki mesajlarin kullandigi,
       DEGISMEYEN, cok daha soluk box-shadow katmani) gorunumunden BELIRGIN
       SEKILDE DAHA GUCLU/PARLAK tutuldu - ilk mesajin "enerji nakli" hissi
       icin gecmis rota HICBIR ZAMAN .yaziyor-yuzey'in soluk seviyesine
       "sogumaz". */
    .yaziyor-akis {
        position: absolute;
        inset: -1px;
        z-index: 1;
        pointer-events: none;
        overflow: visible;
    }

    .yaziyor-akis-yol {
        fill: none;
        stroke-width: 2.4px;
        stroke-linecap: round;
        stroke-dasharray: 0px 1px;
    }

    /* CEKIRDEK/HALE ayrimi (SADECE ilk mesajin cevre-govde/iz'i - bu iki
       sinif baska hicbir yerde kullanilmaz, bkz. cevreAkisiKur):
       govde/iz ARTIK dogrudan blur() ile bulaniklastirilmiyor - eski
       blur(2.5px), 2px'lik stroke'u neredeyse tamamen yumusak bir lekeye
       donusturuyordu (KESKIN bir cekirdek hic OLUSMUYORDU) ve blur simetrik
       yayildigi icin balonun İCİNE de disariyla AYNI miktarda tasip gri
       kutunun kendisini mor bir ic-parlamaya donusturuyordu. Bunun yerine
       stroke'un KENDI pikselleri ARTIK bulanmiyor (KESKIN/net kalir) -
       SADECE arkasina/etrafina, drop-shadow ile kucuk (1.4px, eski blur'dan
       daha DAR) bir yon-renkli hale eklendi. drop-shadow, kaynagin ALTINA
       bir golge cizer, kaynagin GORUNUR pikselini bulaniklastirmaz - bu
       yuzden "hareketli parlak uc -> arkasinda kalan keskin/guclu kablo"
       hiyerarsisi govde/iz icin de kurulmus olur ve ic-tasma yaricapi
       kuculdugu icin gri balon yuzeyine eskisinden daha az bulasir.
       --yuzey-1/2'nin KENDISI (ton) DEGISMEDI, sadece bu iki kuralin
       alfasi 0.85 -> 0.92 yukseltildi: cekirdek ARTIK bulanmadigindan,
       hareketli ucun (alfa 1) yaninda "neredeyse ayni parlaklikta"
       okunabilsin diye. .yaziyor-yuzey (sonraki mesajlarin kullandigi ayni
       degiskenler) ve .yaziyor-akis-uc-cw/ccw'nin KENDI alfa/filter'i
       ETKILENMEDI.

       RENK BIRLIGI: cw KENDI --yuzey-1, ccw KENDI --yuzey-2'yi
       kullaniyordu - iki degisken de FARKLI TONLAR (ac. temada acik
       sari/turuncu, koyu temada acik leylak/koyu mor). Sonuc: cevre
       tamamlaninca iki yarim, TEK bir enerji kablosu yerine iki AYRI
       renkte parca gibi okunuyordu. Artik cw da ccw ile AYNI --yuzey-2
       kaynagini kullaniyor (--yuzey-1/2'nin KENDI tanimlari, .yaziyor-yuzey
       gibi baska yerlerde kullanildigi icin DEGISTIRILMEDI - sadece BU
       kuralin hangi degiskene baktigi degisti). --yuzey-2, her iki temada
       da uygulamanin mevcut vurgu rengiyle (acik temada #sor-dugmesi'nin
       ikinci durak rengi #f97316, koyu temada hem #sor-dugmesi'nin ikinci
       durak rengi hem #parlama'nin ucuncu durak rengi #7c3aed) BIREBIR
       AYNI oldugu icin secildi - yeni bir renk ICAT EDILMEDI. */
    /* DIS HALE: mevcut ilk drop-shadow (1.4px/0.5 - CEKIRDEGE SIKICA
       yapisik, konumu/boyutu DEGISMEDI) korunarak, ikinci, daha genis/
       yumusak bir drop-shadow katmani EKLENDI. Yaricap 3px -> 5.5px
       (DEGISMEDI) ve alfa 0.4 -> 0.5 -> 0.75 yukseltildi: yaricapi
       buyutmek (blur/gaussian yayilma) tek basina yeterli GORUNURLUK
       artisi saglamiyordu (sabit "alfa kutlesi" daha genis alana
       yayilinca tepe yogunlugu dusuyor) - bu yuzden asil GORUNURLUK
       artisi dogrudan alfadan geliyor. CSS filter, birden fazla
       drop-shadow() fonksiyonunu zincirleyip UST USTE bindirebilir -
       YENI bir SVG elemani/katman GEREKMEDI, aynen ayni <rect>'in KENDI
       filter'ine ikinci bir golge eklendi. Sonuc: cekirdek (stroke + ilk
       golge) AYNEN eskisi gibi keskin kalirken, onun etrafinda ilk
       mesaja OZEL, kompakt/balona-yapisik ikinci bir "hale" katmani ilk
       mesajin enerji naklini daha guclu/canli hissettirir. Bu iki sinif
       SADECE ilk mesajda kullanildigindan (bkz. cevreAkisiKur) sonraki
       mesaj yuklemesi ETKILENMEDI. */
    .yaziyor-akis-cw {
        stroke: rgba(var(--yuzey-2), 0.92);
        filter: drop-shadow(0 0 1.4px rgba(var(--yuzey-2), 0.5)) drop-shadow(0 0 5.5px rgba(var(--yuzey-2), 0.75));
    }

    .yaziyor-akis-ccw {
        stroke: rgba(var(--yuzey-2), 0.92);
        filter: drop-shadow(0 0 1.4px rgba(var(--yuzey-2), 0.5)) drop-shadow(0 0 5.5px rgba(var(--yuzey-2), 0.75));
    }

    .yaziyor-akis-uc {
        fill: none;
        stroke-width: 4.5;
        stroke-linecap: round;
        stroke-dasharray: 0px 1px;
        filter: blur(1px);
    }

    /* Ucun rengi de govde/iz ile AYNI birlik icin --yuzey-2'ye hizalandi
       (bkz. yukaridaki RENK BIRLIGI notu) - alfa (1), blur(1px) ve
       tamamlanma soneme davranisi (bkz. JS cevreAkisiCalistir) HICBIR
       SEKILDE DEGISMEDI. */
    .yaziyor-akis-uc-cw {
        stroke: rgba(var(--yuzey-2), 1);
    }

    .yaziyor-akis-uc-ccw {
        stroke: rgba(var(--yuzey-2), 1);
    }

    .yaziyor-arkaplan {
        position: absolute;
        inset: -1px; /* .balon-cevap'in 1px border'i artik seffaf - orijinal kenari birebir tutmak icin telafi */
        z-index: 1;
        border-radius: inherit;
        background-color: var(--bs-tertiary-bg);
        border: 1px solid var(--bs-border-color);
        pointer-events: none;
    }

    /* Parlak katman (Asama 1A, boyut/yogunluk ayari): balonun disina yalnizca ~8px
       tasar (once 28px'ti - "kucuk bulut" gibi gorunuyordu), hafif blur(6px) ile
       en guclu gorunur parilti kenardan ~5-10px, belli belirsiz sonme ~15-18px'te
       tamamlanir. Backdrop'un (z-index:1) ALTINDA (z-index:0) kalir - bu yuzden
       sadece balonun kenarlarindan tasan kismi gorunur, merkezi (guclu renk)
       backdrop tarafindan tamamen ortulur. Uc ayri, kisa mesafede sonen
       radial-gradient lobu (primer menekse, ikincil mor, hafif mavi-menekse) =
       tek bir katı daire/halka degil, balona SIKICA yapisik, dagitik bir isik.
       Opaklik dusurulmedi (0.58->0.62) - kucuk alan kucuk gorunse de renk hala
       belirgin kalsin diye; kuculme TAMAMEN alan/blur/olcek/kayma degerlerinden. */
    .yaziyor-parlak {
        --hale-1: #fbbf24;
        --hale-2: #fb923c;
        --hale-3: #ef4444;
        position: absolute;
        inset: -8px;
        z-index: 0;
        pointer-events: none;
        filter: blur(6px);
        opacity: 0.62;
        background:
            radial-gradient(circle at 32% 60%, var(--hale-1) 0%, transparent 46%),
            radial-gradient(circle at 70% 36%, var(--hale-2) 0%, transparent 48%),
            radial-gradient(circle at 50% 76%, var(--hale-3) 0%, transparent 52%);
        animation: parlakSuzulme 7.5s ease-in-out infinite;
    }

    [data-bs-theme="dark"] .yaziyor-parlak {
        --hale-1: #7c3aed;
        --hale-2: #9333ea;
        --hale-3: #4f46e5;
    }

    /* Duzensiz, esit-olmayan zaman noktalari (%14, %32, %51, %69, %86) kasitli -
       simetrik bir "nefes alma"/pulse hissi vermesin. Surukleme araligi daraltildi
       (once ~ -9px..10px yatay/-8px..8px dikey idi -> simdi ~ -5px..5px yatay/
       -4px..4px dikey) ve scale sapmasi da daraltildi (once ~%6-9 -> simdi ~%3-5)
       - hale artik balona SIKICA yapisik kalirken yine de goze carpar sekilde
       suzuluyor. background-position kaymalari da orantili olarak kucultuldu.
       100% ve 0% AYNI degerler - donguyu goze carpan bir sicrama olmadan kapatir. */
    @@keyframes parlakSuzulme {
        0% {
            transform: translate(-2px, 2px) scale(1.015, 0.985);
            background-position: 0% 0%, 0% 0%, 0% 0%;
            opacity: 0.6;
        }

        14% {
            transform: translate(-5px, -1px) scale(0.975, 1.03);
            background-position: -5% 3%, 4% -4%, -3% 3%;
            opacity: 0.76;
        }

        32% {
            transform: translate(3px, -4px) scale(1.045, 0.965);
            background-position: 5% -4%, -4% 4%, 4% -2%;
            opacity: 0.68;
        }

        51% {
            transform: translate(5px, 3px) scale(0.965, 1.05);
            background-position: 3% 4%, -5% -1%, 2% 4%;
            opacity: 0.82;
        }

        69% {
            transform: translate(5px, 2px) scale(1.035, 0.985);
            background-position: 4% 2%, 3% 3%, -3% -2%;
            opacity: 0.64;
        }

        86% {
            transform: translate(-4px, -3px) scale(0.98, 1.025);
            background-position: -3% -4%, -2% 4%, 4% -1%;
            opacity: 0.78;
        }

        100% {
            transform: translate(-2px, 2px) scale(1.015, 0.985);
            background-position: 0% 0%, 0% 0%, 0% 0%;
            opacity: 0.6;
        }
    }

    /* Asama 1B/1C - plazma tutamlari: halenin (.yaziyor-parlak) KENDISI
       DEGISTIRILMEDI (boyut/renk/yogunluk/surukleme aynen Asama 1A'daki gibi). Uc
       YENIDEN KULLANILABILIR "tutam" katmani var - ARTIK SABIT bir @@keyframes
       koreografisi YOK (Asama 1B'de vardi, tekrar eden/tahmin edilebilir oldugu
       icin Asama 1C'de kaldirildi). Konum/boyut/gradyan/yon/sure/gecikme artik
       JS tarafindan HER olayda yeniden rastgelestirilir (bkz. asagi,
       yaziyorTutamlariBaslat, Element.animate() ile). Bu kural sadece PAYLASILAN,
       degismeyen temelleri tasir: mutlak konumlandirma, blur, baslangic opakligi
       (0 = havuzda beklerken gorunmez), daire/elips serbestligi icin border-radius,
       ve tema-duyarli renk degiskenleri (JS bunlari getComputedStyle ile okur, boylece
       renk mantigi TEK yerde/CSS'te kalir). Hepsi ayni z-index:0 katmaninda
       (.yaziyor-parlak ile ayni seviye, backdrop'un/noktalarin HALA gerisinde) -
       stacking mimarisi Asama 1A'dakiyle birebir ayni. */
    .yaziyor-tutam {
        --tutam-1: #fde047;
        --tutam-2: #fb923c;
        position: absolute;
        z-index: 0;
        pointer-events: none;
        filter: blur(5px);
        opacity: 0;
        border-radius: 50%;
        will-change: transform, opacity;
    }

    [data-bs-theme="dark"] .yaziyor-tutam {
        --tutam-1: #a78bfa;
        --tutam-2: #7c3aed;
    }

    /* Asama 2: sadece ILK mesaj gecisinde, balonuEtkinlestir() tarafindan
       calisma-zamaninda eklenen sarmalayici. .yaziyor-parlak/.yaziyor-tutam'in
       KENDI opacity/transform'u zaten kendi animasyonlariyla (parlakSuzulme,
       Element.animate() tutam olaylari) surekli degistigi icin, carprazlama
       (0 -> 1) icin AYRI bir katman gerekiyor - dogrudan onlarin opacity'sine bir
       transition eklemek, calisan animasyonlarla yarisir ve gorunmez kalirdi.
       position YOK (statik) - bu yuzden icindeki position:absolute katmanlarin
       containing block'u degismez, hala .yaziyor-balonu'dur (Asama 1A/1C'deki
       gibi). Sonraki mesajlarda bu sarmalayici hic kullanilmaz/eklenmez. */
    .yaziyor-enerji {
        pointer-events: none;
    }

    @@media (prefers-reduced-motion: reduce) {
        .yaziyor-parlak {
            animation: none;
        }
    }
</style>

<div class="d-flex" style="height:100%; min-height:0; overflow:hidden;">
    <div class="border-end" style="width:260px;">
        <div class="p-3 h-100">
            @await Component.InvokeAsync("SohbetPaneli")
        </div>
    </div>
    <div class="flex-grow-1 ps-3 d-flex flex-column" style="min-width:0; min-height:0; overflow:hidden;">
        <div class="d-flex justify-content-end mb-2" style="flex-shrink:0;">
            <select id="departman-secici" class="form-select form-select-sm" style="width:auto; min-width:200px;"
                    aria-label="Departman seçin">
                <option value="" disabled selected="@(Model.DepartmanId == null)">Departman seçin</option>
                @foreach (var d in Model.Departmanlar)
                {
                    <option value="@d.Id" selected="@(Model.DepartmanId == d.Id)">@d.Ad</option>
                }
            </select>
        </div>

        <div id="mesajKutusu" class="mb-4 @(Model.Mesajlar.Count == 0 ? "mesaj-kutusu-bos" : "")">
            @if (Model.Mesajlar.Count == 0)
            {
                <div id="selamlama">
                    <div id="selamlama-baslik"></div>
                    <div id="selamlama-alt">Nasıl yardımcı olabilirim?</div>
                </div>
            }
            <div id="parlama" class="@(Model.Mesajlar.Count > 0 ? "parlama-gizli" : "")">
                <canvas class="parlama-canvas" aria-hidden="true"></canvas>
            </div>
            @foreach (var m in Model.Mesajlar)
            {
                if (m.Rol == "soru")
                {
                    <div class="d-flex justify-content-end mb-3 mesaj-satiri">
                        <div class="alert mb-0 chat-balon balon-soru" style="max-width:70%;">@m.Metin</div>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-start mb-3 mesaj-satiri">
                        <div class="alert mb-0 chat-balon balon-cevap" style="max-width:70%;">@m.Metin</div>
                    </div>
                }
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.Hata))
        {
            <div class="alert alert-danger mx-auto mb-2 px-3" style="max-width:800px; width:100%;" role="alert">@Model.Hata</div>
        }

        <form method="post" id="soru-formu" class="mx-auto mb-5 px-3" style="max-width:800px; width:100%; flex-shrink:0;">
            <input type="hidden" name="SohbetId" value="@Model.SohbetId" />
            <input type="hidden" name="DepartmanId" id="departman-id-girdi" value="@Model.DepartmanId" />
            <div class="soru-formu-kabuk">
                <textarea asp-for="Soru" class="form-control soru-formu-girdi" placeholder="Sorunuzu yazın" autocomplete="off" rows="1" maxlength="@arayuz.Pages.IndexModel.SoruMaksUzunluk" required></textarea>
                <button type="submit" class="btn btn-primary soru-formu-dugme" id="sor-dugmesi" aria-label="Soruyu gönder" title="Soruyu gönder">
                    <i class="bi bi-arrow-up-short sor-ok-simge" aria-hidden="true"></i>
                    <i class="bi bi-arrow-clockwise sor-spinner-simge" aria-hidden="true"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    (function () {
        var kutu = document.getElementById("mesajKutusu");
        kutu.scrollTop = kutu.scrollHeight;
    })();
</script>

<script>
    (function () {
        var baslik = document.getElementById("selamlama-baslik");
        if (!baslik) {
            return;
        }

        var saat = new Date().getHours();
        var metin;

        if (saat >= 5 && saat < 12) {
            metin = "Günaydın";
        } else if (saat >= 12 && saat < 18) {
            metin = "İyi günler";
        } else if (saat >= 18 && saat < 22) {
            metin = "İyi akşamlar";
        } else {
            metin = "İyi geceler";
        }

        baslik.textContent = metin;
    })();
</script>

<script>
    (function () {
        var parlama = document.getElementById("parlama");
        var canvas = parlama && parlama.querySelector(".parlama-canvas");
        if (!parlama || !canvas) {
            return;
        }
        var baglam = canvas.getContext("2d");

        var azaltilmisHareket = window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // Dusuk cozunurluklu skaler alan icin kucuk, ayri bir tuval (bkz. alanDegerlendir/boyutlandir).
        // 72 gorunur pixelasyona yol aciyordu; 144 hala ucuz ama belirgin sekilde daha pürüzsüz.
        var GRID_W = 144;
        var GRID_H = 144;
        var ESIK = 1;
        var ESIK_YUMUSAKLIGI = 0.35;
        var ALAN_HEDEF_ARALIGI = 1000 / 30; // pahali alan hesaplamasi icin ~30fps hedefi

        // Govde/parlama/kontur yankilari eski kare sinirinda kirpiliyordu. Fizik/parcacik
        // uzayi HER ZAMAN mantiksal alanW/alanH icinde kalir (motion/size DEGISMEZ) - sadece
        // render asamasinda bu oran kadar seffaf, tasan bir dolgu payi eklenir (bkz.
        // boyutlandir, pasoCiz, yankilariCiz, gradyanOlustur).
        var DOLGU_ORANI = 0.35;
        var alanW = 0, alanH = 0, dolguX = 0, dolguY = 0;

        var kucukTuval = document.createElement("canvas");
        kucukTuval.width = GRID_W;
        kucukTuval.height = GRID_H;
        var kucukBaglam = kucukTuval.getContext("2d");
        var alanVerisi = kucukBaglam.createImageData(GRID_W, GRID_H);

        var geciciTuval = document.createElement("canvas");
        var geciciBaglam = geciciTuval.getContext("2d");

        // Cekirdek + tandril zincirleri (bkz. parcaciklariBaslat) - tumu ayni duz listede
        // tutulur ki alanDegerlendir hicbir degisiklik gerektirmeden onlari okuyabilsin.
        var tumParcaciklar = [];
        var baglar = [];   // aktif yay baglantilari: {a, b, dogalMesafe, gerginlikSuresi, kopmaSuresi}
        var uclar = [];    // her tandrilin sabit "uc" parcacigi - guclu itkilerin hedefi
        var cekirdek = null;

        var YAY_SERTLIGI = 9;
        var GERME_ESIGI = 2.4; // dogal mesafenin kac kati asilirsa kopma sayaci islemeye baslar

        var sonrakiUcImpulsu = 0;
        var aktifVorteks = null;
        var sonrakiVorteksKontrolu = 0;
        var esikHedef = 1;
        var sonrakiEsikKarari = 0;

        var sonKareZamani = 0;
        var sonAlanZamani = 0;
        // detParlamaDondu: TANI (kullanici geri bildirimi, on ikinci tur -
        // "mesaj gittigi anda baloncugun bi kismi kirmizi bi kismi turuncu
        // oluyor", acik temada) - handoff aninda (detMorphBaslat) #parlama
        // (ESKI, prosedurel top) ile YENI deterministik canvas ~100ms
        // (DET_GECIS_SURESI) boyunca CAPRAZ SOLUYOR (biri 1->0, digeri 0->1
        // opaklik). #parlama'nin KENDI gradyani (gradyanOlustur) SABIT bir
        // ekran-uzayi kosegeni (sol-ust->sag-alt) kullanir; YENI canvas'in
        // gradyani ISE gercek seyahat yonune (detDirX/Y, mesaj kutusuna
        // dogru) hizalanir - bu iki eksen SEYAHAT YONUNE gore CAKISMAZ (asagi-
        // saga giden bir seyahat DISINDA). USTELIK #parlama'nin dongu()'su bu
        // ~100ms boyunca fizik/parcacik/gradyan'i HER KAREDE yeniden
        // hesaplamaya DEVAM ediyordu (parlama-gizli sinifi setTimeout ile
        // GECIKMELI ekleniyor, "solurken canli gorunsun" diye) - yani iki
        // FARKLI eksenli gradyan, biri SABIT durmayip SUREKLI titreşerek,
        // ~100ms CAKISIYORDU - "bi kismi kirmizi bi kismi turuncu" ani/lekeli
        // gorunumun sebebi bu. Cozum: detMorphBaslat, opaklik solmasini
        // baslattigi ANDA bu bayragi true yapar - dongu() ARTIK yeniden
        // CIZMEZ (fizik de atlanir), #parlama SON haliyle (donmus tek kare)
        // solur - iki eksen arasindaki uyusmazlik hala var ama ARTIK
        // TITRESMEDEN, KISA (~100ms) statik bir capraz-solma olarak
        // gorunur, cok daha az goze batar.
        var detParlamaDondu = false;

        // MANYETIK CEKIM (SADECE ilk mesaj Şey-seyahati sirasinda aktif -
        // bkz. asagidaki window.__parlamaManyetikBaslat/manyetikKuvvetiUygula).
        // Varsayilan durumda "aktif:false" - idle govde ve sonraki mesajlar
        // bu mekanizmayi HICBIR ZAMAN tetiklemez, guc() daima 0 doner ve
        // manyetikKuvvetiUygula() erken cikar (no-op). yonX/yonY EKRAN
        // uzayinda balonun (temas noktasinin) bulundugu YONE dogru birim
        // vektordur - #parlama pre-contact fazda hic dondurulmedigi icin
        // (rotate() SADECE temas SONRASI, emilim fazinda baslar) bu, tuvalin
        // KENDI yerel eksenleriyle birebir hizali kabul edilir.
        var manyetik = { aktif: false, yonX: 0, yonY: 0, baslangicZamani: 0, sure: 1 };

        // MANYETIK_BASLANGIC_ORANI: seyahatin ilk bu orani boyunca cekim
        // SIFIRDIR (idle karakter buyuk olcude korunur, "~%50-55 normal"
        // hedefi). Kalan dilimde smoothstep ile 0'dan 1'e sicramasiz
        // yukselir - orta kisimda (~%25-30) ACIKCA GORULUR hale gelir, son
        // ~%15-20'de tepe degerine (guc≈1) ulasilmis olur. ONCEKI deger
        // (0.57) ile birlikte kuvvet sabitleri de dusuktu (bkz. asagi) -
        // sonuc pratikte "son birkac karede" farkedilen, cok hafif bir
        // etkiydi. Baslangic biraz erkene (0.52) cekildi VE kuvvetler
        // asagida belirgin sekilde artirildi - asil GORUNURLUK farki
        // BURADAN (siddet), sadece baslangic oranindan degil geliyor.
        var MANYETIK_BASLANGIC_ORANI = 0.52;
        // MANYETIK_ON_ORANI_MIN/MAX: bir parcacigin merkeze göre yon
        // dogrultusundaki konumuna (align, -1..1) gore ne kadar guclu
        // cekildigini olcekler - align=-1 (tam ARKA) icin MIN, align=+1
        // (tam ON/lider) icin MAX kullanilir, ikisi arasinda DOGRUSAL
        // geciş. MIN sifirin ustunde tutulur (0 degil) ki "butun kutlenin"
        // cekildigi hissi korunsun; MAX ile arasindaki fark on tarafin
        // GERGIN/uzayan, arka tarafin nispeten SAKIN/kompakt kalmasini
        // saglar - iki AYRI, sabit lob DEGIL, HANGI parcaciklarin "on"da
        // oldugu her zaman o anki prosedurel geometriye baglidir.
        var MANYETIK_ON_ORANI_MIN = 0.18;
        var MANYETIK_ON_ORANI_MAX = 1.0;
        // MANYETIK_TANDRIL_KUVVETI/MANYETIK_CEKIRDEK_KUVVETI: taban kuvvet
        // olcekleri (alanW ile carpilir, merkezVeSinirKuvvetiUygula'nin
        // KENDI sabitleriyle (34/0.9) AYNI olcekte, ama DEGISTIRILMEDEN).
        // Onceki degerler (2.6/0.5) net bir gorsel fark yaratmaya YETMIYORDU -
        // burada BELIRGIN sekilde yukseltildi (yaklasik 2 kat) ki cekim
        // normal oynatma hizinda ACIKCA GORULEBILSIN. Cekirdek carpani
        // yine de tandrilden dusuk tutuldu - cekirdek ZATEN cok guclu bir
        // merkeze-donus kuvvetine (k=34) sahip, bu yuzden bu artan kuvvet
        // bile onu SINIRLI (yay-dengesi) bir mesafe kaydirir - govde
        // kontrolsuzce firlamaz.
        var MANYETIK_TANDRIL_KUVVETI = 5.5;
        var MANYETIK_CEKIRDEK_KUVVETI = 0.85;
        // MANYETIK_YAN_KUVVETI: yon vektorune DIK (90 derece) bir kuvvet -
        // her tandril parcacigi KENDI SABIT manyetikYan katsayisina (bkz.
        // parcacikOlustur, -1..1 rastgele) göre SOLA ya da SAGA, FARKLI
        // miktarlarda itilir. "agirlik" (on/arka pay) ile CARPILDIGI icin
        // bu yanal itki ON tarafta yogunlasir - govdenin balona-BAKAN
        // tarafinda DUZENSIZ, birbirinden farkli "omuz"/lob cikintilari
        // olusturur (sabit iki lob DEGIL - HER seyahatte hangi parcaciklarin
        // ne kadar yana ittigi rastgele/prosedureldir). Sadece tandril
        // parcaciklarina uygulanir (cekirdek MERKEZDE, hizali kalmali).
        var MANYETIK_YAN_KUVVETI = 3.2;

        // Kontur yankilari: mevcut siluetin (kucukTuval) donmus, kucuk anlik goruntuleri -
        // yeni bir sekil UYDURULMAZ, sadece o anki govde formu disari dogru yonlu bir
        // sekilde genisletilip bulaniklastirilir ve soner (bkz. yankiOlustur/yankilariCiz).
        var yankilar = [];
        var sonrakiYankiZamani = 0;
        var YANKI_SOGUMA_MS = 550; // enerjik olmayan normal hareket surekli yanki tetiklemesin

        // 1) Kurulum: tuval boyutunu #parlama'nin gercek gorunen kutusundan al.
        // devicePixelRatio kasitli olarak sinirlanir (netlik icin makul bir tavanla) - bu
        // kucuk, susleyici bir gorsel, tam retina cozunurlugu gereksiz maliyet demektir.
        //
        // Canvas'in kendisi #parlama'dan DOLGU_ORANI kadar daha buyuk cizilir ve negatif
        // left/top ile disariya tasirilir, boylece #parlama'nin kendi layout kutusu
        // (clientWidth/clientHeight, getBoundingClientRect - reparenting/loading kodunun
        // guvendigi seyler) hicbir sekilde degismez; sadece render icin fazladan seffaf
        // alan acilir. Fizik hala mantiksal alanW/alanH uzerinde calisir, bu yuzden gorunen
        // boyut/hareket AYNI kalir - degisen sadece tasmaya izin verilen kirpma sinirlaridir.
        function boyutlandir() {
            var dpr = Math.min(window.devicePixelRatio || 1, 2);
            var genislikCss = parlama.clientWidth || 300;
            var yukseklikCss = parlama.clientHeight || 300;
            var dolguXCss = genislikCss * DOLGU_ORANI / 2;
            var dolguYCss = yukseklikCss * DOLGU_ORANI / 2;

            canvas.style.left = (-dolguXCss) + "px";
            canvas.style.top = (-dolguYCss) + "px";
            canvas.style.right = "auto";
            canvas.style.bottom = "auto";
            canvas.style.width = (genislikCss + dolguXCss * 2) + "px";
            canvas.style.height = (yukseklikCss + dolguYCss * 2) + "px";

            alanW = Math.round(genislikCss * dpr);
            alanH = Math.round(yukseklikCss * dpr);
            dolguX = Math.round(dolguXCss * dpr);
            dolguY = Math.round(dolguYCss * dpr);

            canvas.width = alanW + dolguX * 2;
            canvas.height = alanH + dolguY * 2;
            geciciTuval.width = canvas.width;
            geciciTuval.height = canvas.height;

            baglam.imageSmoothingEnabled = true;
            geciciBaglam.imageSmoothingEnabled = true;
        }

        // Tek bir parcacik: cekirdek ya da bir tandril zincirinin bir halkasi.
        // "durum" gorsel/davranissal degil, salt fizik amaclidir: hangi kuvvetlerin
        // uygulanacagini ve yaricabin nasil hedeflenecegini belirler.
        function parcacikOlustur(x, y, r, tur) {
            return {
                tur: tur, // "cekirdek" | "tandril"
                durum: tur === "cekirdek" ? "cekirdek" : "bagli", // "cekirdek" | "bagli" | "serbest"
                x: x, y: y, vx: 0, vy: 0, fx: 0, fy: 0,
                r: r, rTaban: r, rHedef: r, rMin: r * 0.3, rMax: r * 1.35,
                proksimalKenar: null,
                sonrakiZayifKuvvet: 0,
                sonrakiYaricapKarari: 0,
                serbestKaderi: null, // "kaybol" | "geriDon" - kopunca rastgele atanir
                // manyetikYan: PARCACIK basina SABIT, -1..1 rastgele katsayi -
                // SADECE manyetikKuvvetiUygula() tarafindan (guc>0 iken, yani
                // SADECE ilk mesaj seyahatinin son diliminde) okunur; baska
                // HICBIR yerde kullanilmadigi icin idle/normal fizigi ETKILEMEZ.
                // Farkli parcaciklarin farkli/rastgele bu katsayiya sahip olmasi,
                // manyetik cekim sirasinda govdenin DUZENSIZ/asimetrik "omuz"
                // lobu olusturmasini saglar (sabit bir sablon degil).
                manyetikYan: Math.random() * 2 - 1
            };
        }

        // Iki parcacik arasinda yumusak bir yay baglantisi kurar. "b" tarafi "a"ya
        // (merkeze daha yakin olana) bagli kabul edilir; proksimalKenar bu yuzden b'ye yazilir.
        function kenarOlustur(a, b, dogalMesafe) {
            var kenar = {
                a: a, b: b, dogalMesafe: dogalMesafe,
                gerginlikSuresi: 0, kopmaSuresi: 0.35 + Math.random() * 0.4
            };
            b.proksimalKenar = kenar;
            b.durum = "bagli";
            return kenar;
        }

        // 2) Baslangic durumu: 1 cekirdek + 4 tandril (her biri cekirdek -- p1 -- p2 -- p3 -- uc
        // seklinde 4 halkalik bir zincir). Halkalar birbirini gorunmez yay baglantilariyla takip eder.
        function parcaciklariBaslat() {
            var w = alanW;
            var merkezX = alanW / 2, merkezY = alanH / 2;
            var simdi = performance.now();
            var dogalMesafe = w * 0.075;

            cekirdek = parcacikOlustur(merkezX, merkezY, w * 0.17, "cekirdek");
            cekirdek.rMin = w * 0.15;
            cekirdek.rMax = w * 0.19;
            cekirdek.sonrakiYaricapKarari = simdi + 1800 + Math.random() * 1400;

            tumParcaciklar = [cekirdek];
            baglar = [];
            uclar = [];

            var tandrilSayisi = 4;
            var zincirUzunlugu = 4;

            for (var t = 0; t < tandrilSayisi; t++) {
                var aci = (Math.PI * 2 * t) / tandrilSayisi + Math.random() * 0.6;
                var onceki = cekirdek;

                for (var k = 0; k < zincirUzunlugu; k++) {
                    var mesafe = w * 0.05 + k * 2; // baslangicta cekirdege yakin, ic ice
                    var p = parcacikOlustur(
                        merkezX + Math.cos(aci) * mesafe,
                        merkezY + Math.sin(aci) * mesafe,
                        w * 0.045, "tandril");
                    p.sonrakiZayifKuvvet = simdi + 400 + Math.random() * 700;

                    baglar.push(kenarOlustur(onceki, p, dogalMesafe));
                    tumParcaciklar.push(p);
                    onceki = p;
                }

                uclar.push(onceki);
            }
        }

        // 3a) Komsu parcaciklar arasindaki yay kuvveti: dogal mesafeden uzaklasmis her
        // baglanti, iki ucunu da (Newton'un ucuncu yasasi geregi) birbirine dogru ceker/iter.
        // Sertligi dusuk tutuldugu icin zincir kolayca gerilir ve kavis alabilir - rijit degildir.
        function yayKuvvetleriUygula() {
            for (var i = 0; i < baglar.length; i++) {
                var k = baglar[i];
                var dx = k.b.x - k.a.x, dy = k.b.y - k.a.y;
                var mesafe = Math.sqrt(dx * dx + dy * dy) || 0.001;
                var kuvvet = (mesafe - k.dogalMesafe) * YAY_SERTLIGI;
                var ux = dx / mesafe, uy = dy / mesafe;

                k.a.fx += ux * kuvvet; k.a.fy += uy * kuvvet;
                k.b.fx -= ux * kuvvet; k.b.fy -= uy * kuvvet;
            }
        }

        // 3b) Her parcacik icin hafif bir merkeze meyil (cekirdek icin cok daha guclu -
        // bu, cekirdegin sabit kalmasini saglayan asil mekanizmadir) ve sinirin otesinde
        // giderek guclenen, sert olmayan bir geri cagirma (duvar sekmesi degil).
        //
        // MANYETIK CEKIRDEK ESNEKLIGI (tani sonrasi eklendi): cekirdegin
        // normal sertligi (34) manyetikGuc(zamanMs) SIFIRKEN (idle, onset-
        // oncesi, temas SONRASI - __parlamaManyetikBitir cagrildiktan
        // sonra - ve sonraki mesajlar; guc() bu durumlarin HEPSINDE 0
        // doner) DEGISMEDEN kalir. SADECE ilk mesaj manyetik cekimi aktifken,
        // guc 0->1 yukseldikce cekirdegin merkeze-donus sertligi 34'ten ~10'a
        // dogru SICRAMASIZ azalir - tani, AYNI manyetik kuvvetin (bkz.
        // manyetikKuvvetiUygula, DEGISTIRILMEDI) k=34 karsisinda cekirdegi
        // sadece ~4.4px kaydirdigini, bunun govdenin en baskin/en genis
        // parcacigi oldugu icin siluetin gozle gorulur sekilde degismesine
        // yetmedigini gostermisti. Tandril sertligi (0.9), yay sertligi,
        // yirtilma esikleri VE manyetik kuvvet buyuklukleri/yonu HICBIR
        // SEKILDE degistirilmedi - burada SADECE cekirdegin BU fonksiyondaki
        // KENDI direnc sabiti manyetikGuc()'a bagli hale getirildi.
        function merkezVeSinirKuvvetiUygula(zamanMs) {
            var merkezX = alanW / 2, merkezY = alanH / 2;
            var sinirYaricap = alanW * 0.48;
            var cekirdekSertligi = 34 - (34 - 10) * manyetikGuc(zamanMs);

            for (var i = 0; i < tumParcaciklar.length; i++) {
                var p = tumParcaciklar[i];
                var dx = merkezX - p.x, dy = merkezY - p.y;
                var mesafe = Math.sqrt(dx * dx + dy * dy);
                var k = p.tur === "cekirdek" ? cekirdekSertligi : 0.9;

                p.fx += dx * k;
                p.fy += dy * k;

                if (mesafe > sinirYaricap) {
                    var asiri = mesafe - sinirYaricap;
                    p.fx += (dx / (mesafe || 1)) * asiri * 35;
                    p.fy += (dy / (mesafe || 1)) * asiri * 35;
                }
            }
        }

        // 3c) Duzensiz araliklarla, her (cekirdek disi) parcacigin hizina kucuk, rastgele
        // yonlu bir itki eklenir - konum degil hiz degisir, bu yuzden hareket sarsintili degil akicidir.
        function zayifKuvvetleriUygula(zamanMs) {
            for (var i = 0; i < tumParcaciklar.length; i++) {
                var p = tumParcaciklar[i];
                if (p.tur === "cekirdek" || zamanMs < p.sonrakiZayifKuvvet) {
                    continue;
                }
                var aci = Math.random() * Math.PI * 2;
                var guc = alanW * (0.08 + Math.random() * 0.14);
                p.vx += Math.cos(aci) * guc;
                p.vy += Math.sin(aci) * guc;
                p.sonrakiZayifKuvvet = zamanMs + 400 + Math.random() * 700;
            }
        }

        // 3d) Ongorulemeyen araliklarla, rastgele bir tandril ucuna guclu bir itki uygulanir.
        // Buyukluk genis bir aralikta rastgeledir - bazen kucuk bir sicrayis, bazen govdeyi
        // gercekten uzaklara gerecek kadar dramatik. Zincirin geri kalani onu gecikmeli takip eder.
        function ucImpulsuUygula(zamanMs) {
            if (zamanMs < sonrakiUcImpulsu) {
                return;
            }
            var hedef = uclar[Math.floor(Math.random() * uclar.length)];
            var aci = Math.random() * Math.PI * 2;
            var guc = alanW * (0.4 + Math.random() * 1.8);

            // Belirgin sekilde guclu darbelerde, darbenin kendi yonunu ("aci") kontur
            // yankisinin yonlu egilimi olarak kullan - dalganin nereden geldigi belli olsun.
            var gucOrani = (guc / alanW - 0.4) / 1.8;
            if (gucOrani > 0.35) {
                yankiOlustur(zamanMs, Math.cos(aci), Math.sin(aci), gucOrani);
            }

            hedef.vx += Math.cos(aci) * guc;
            hedef.vy += Math.sin(aci) * guc;
            sonrakiUcImpulsu = zamanMs + 1800 + Math.random() * 2700;
        }

        // 3e) Ara sira, gecici bir "vorteks" penceresi acilir: merkez veya rastgele bir
        // parcacigin o anki konumu etrafinda, yakindaki parcaciklara teget (radyal degil)
        // yonde bir kuvvet uygulanir - bu, kollarin duz degil kavisli/donerek hareket
        // etmesini saglar. Etkinken bile sadece yakin parcaciklari, mesafeyle azalarak etkiler.
        function vortexKuvvetiUygula(zamanMs) {
            if (aktifVorteks && zamanMs > aktifVorteks.bitis) {
                aktifVorteks = null;
            }

            if (!aktifVorteks && zamanMs >= sonrakiVorteksKontrolu) {
                var merkezdeMi = Math.random() < 0.5;
                var kaynak = merkezdeMi
                    ? { x: alanW / 2, y: alanH / 2 }
                    : tumParcaciklar[Math.floor(Math.random() * tumParcaciklar.length)];

                aktifVorteks = {
                    x: kaynak.x, y: kaynak.y,
                    bitis: zamanMs + 600 + Math.random() * 1000,
                    yon: Math.random() < 0.5 ? 1 : -1,
                    guc: alanW * (0.5 + Math.random() * 0.8),
                    yaricap: alanW * 0.5
                };
                sonrakiVorteksKontrolu = aktifVorteks.bitis + 800 + Math.random() * 1800;
            }

            if (!aktifVorteks) {
                return;
            }

            for (var i = 0; i < tumParcaciklar.length; i++) {
                var p = tumParcaciklar[i];
                var dx = p.x - aktifVorteks.x, dy = p.y - aktifVorteks.y;
                var mesafe = Math.sqrt(dx * dx + dy * dy);
                if (mesafe > aktifVorteks.yaricap || mesafe < 1) {
                    continue;
                }
                var etki = 1 - mesafe / aktifVorteks.yaricap;
                var tx = -dy / mesafe, ty = dx / mesafe; // yaricap vektorune dik (teget) yon
                var kuvvet = aktifVorteks.guc * etki * aktifVorteks.yon;
                p.fx += tx * kuvvet;
                p.fy += ty * kuvvet;
            }
        }

        // 3e-bis) Manyetik cekim gucu: manyetik.baslangicZamani'ndan bu yana
        // gecen sureyi manyetik.sure'ye orantilar, MANYETIK_BASLANGIC_ORANI'na
        // kadar 0 dondurur, sonrasinda smoothstep (3t^2-2t^3) ile SICRAMASIZ
        // 0 -> 1 yukselir. manyetik.aktif false iken (idle/sonraki mesajlar)
        // HER ZAMAN 0 doner.
        function manyetikGuc(zamanMs) {
            if (!manyetik.aktif) {
                return 0;
            }
            var t = (zamanMs - manyetik.baslangicZamani) / manyetik.sure;
            if (t <= MANYETIK_BASLANGIC_ORANI) {
                return 0;
            }
            if (t >= 1) {
                return 1;
            }
            var ilerleme = (t - MANYETIK_BASLANGIC_ORANI) / (1 - MANYETIK_BASLANGIC_ORANI);
            return ilerleme * ilerleme * (3 - 2 * ilerleme);
        }

        // 3e-bis) Manyetik cekim kuvveti: guc<=0 iken TAMAMEN no-op (idle/
        // sonraki mesajlar boylece HICBIR SEKILDE etkilenmez). guc>0 iken
        // HER parcaciga (cekirdek DAHIL) manyetik.yonX/Y dogrultusunda bir
        // EKSEN kuvveti uygular; siddet, o parcacigin merkeze göre yon
        // dogrultusundaki konumuna (align, -1..1'e normallestirilmis) göre
        // DOGRUSAL olarak degisir - "on" (align>0) parcaciklar MANYETIK_
        // ON_ORANI_MAX'a, "arka" (align<0) parcaciklar MANYETIK_ON_ORANI_
        // MIN'e yakin bir carpanla cekilir. AYRICA, SADECE tandril
        // parcaciklarina, yon'a DIK bir YANAL kuvvet uygulanir - her
        // parcacigin KENDI SABIT manyetikYan katsayisiyla (-1..1,
        // parcacikOlustur'de atanir) ve AYNI on/arka agirlikla olceklenir,
        // boylece govdenin balona-BAKAN tarafinda DUZENSIZ/asimetrik
        // "omuz" cikintilari (bir kismi sola, bir kismi saga, FARKLI
        // miktarlarda) belirir - sabit iki lob DEGIL. Govdenin BAGLANTI
        // TOPOLOJISI (yayKuvvetleriUygula/baglariKopart/yenidenBaglan)
        // HICBIR SEKILDE degistirilmedi - bu, var olan govdeye eklenen
        // BASKA BIR KUVVET SINIFIDIR (vortexKuvvetiUygula ile ayni
        // duzeyde); govde nadiren dogal kopma/yeniden-baglanma yasayabilir
        // (HER ZAMAN oldugu gibi, bu davranis DEGISTIRILMEDI), ama YENI bir
        // parca/nesne YARATILMAZ.
        function manyetikKuvvetiUygula(zamanMs) {
            var guc = manyetikGuc(zamanMs);
            if (guc <= 0) {
                return;
            }

            var merkezX = alanW / 2, merkezY = alanH / 2;
            var yarim = (alanW / 2) || 1;
            // yon'a dik birim vektor (90 derece dondurulmus) - yanal/omuz
            // kuvveti icin.
            var dikX = -manyetik.yonY, dikY = manyetik.yonX;

            for (var i = 0; i < tumParcaciklar.length; i++) {
                var p = tumParcaciklar[i];
                var dx = p.x - merkezX, dy = p.y - merkezY;
                var align = (dx * manyetik.yonX + dy * manyetik.yonY) / yarim;
                align = Math.max(-1, Math.min(1, align));

                var agirlik = 0.5 + 0.5 * align; // 0 (tam arka) .. 1 (tam on)
                var oran = MANYETIK_ON_ORANI_MIN + (MANYETIK_ON_ORANI_MAX - MANYETIK_ON_ORANI_MIN) * agirlik;
                var tabanKuvvet = p.tur === "cekirdek" ? MANYETIK_CEKIRDEK_KUVVETI : MANYETIK_TANDRIL_KUVVETI;
                var kuvvet = guc * oran * tabanKuvvet * alanW;

                p.fx += manyetik.yonX * kuvvet;
                p.fy += manyetik.yonY * kuvvet;

                if (p.tur === "tandril") {
                    var yanKuvvet = guc * agirlik * p.manyetikYan * MANYETIK_YAN_KUVVETI * alanW;
                    p.fx += dikX * yanKuvvet;
                    p.fy += dikY * yanKuvvet;
                }
            }
        }

        // 3f) Yirtilma: bir baglantinin uzunlugu, dogal mesafesinin GERME_ESIGI katini
        // asarsa bir sayac islemeye baslar; bu durum yeterince uzun surerse (kenara ozel,
        // rastgele belirlenmis bir sure) baglanti TAMAMEN kopar. Bu, gecerli parcacik
        // geometrisinden doner - hicbir yerde "simdi kop" diye zamanli bir olay yoktur.
        function baglariKopart(zamanMs, dt) {
            for (var i = baglar.length - 1; i >= 0; i--) {
                var k = baglar[i];
                var dx = k.b.x - k.a.x, dy = k.b.y - k.a.y;
                var mesafe = Math.sqrt(dx * dx + dy * dy) || 1;

                if (mesafe > k.dogalMesafe * GERME_ESIGI) {
                    k.gerginlikSuresi += dt;
                } else {
                    k.gerginlikSuresi = Math.max(0, k.gerginlikSuresi - dt * 2);
                }

                if (k.gerginlikSuresi >= k.kopmaSuresi) {
                    // Kopan baglantinin ekseni boyunca (proksimalden distale) yonlu bir
                    // kontur yankisi baslat - yirtilma da "enerjik" bir olay kabul edilir.
                    yankiOlustur(zamanMs, dx / mesafe, dy / mesafe, 0.45);

                    baglar.splice(i, 1);
                    k.b.proksimalKenar = null;
                    serbestBirakZincirGrubu(k.b);
                }
            }
        }

        // Kopan bir baglantinin distal (uc) tarafindaki tum zinciri "serbest damla grubu"
        // yapar - aralarindaki kendi baglantilari bozulmaz, sadece cekirdege giden yol kesilir.
        // Her serbest parcacik, kendine ozgu rastgele bir kaderle (kaybol / geri don) kaybolur
        // ya da govdeye don meyilli hale gelir - hepsi ayni davranmaz.
        function serbestBirakZincirGrubu(baslangic) {
            var kuyruk = [baslangic];
            while (kuyruk.length) {
                var p = kuyruk.shift();
                p.durum = "serbest";
                p.serbestKaderi = Math.random() < 0.5 ? "kaybol" : "geriDon";
                for (var i = 0; i < baglar.length; i++) {
                    if (baglar[i].a === p) {
                        kuyruk.push(baglar[i].b);
                    }
                }
            }
        }

        // 3g) Yeniden baglanma: proksimal baglantisi olmayan (cekirdek disi) her parcacik,
        // en yakin diger parcacigini arar; yeterince yaklasirsa YENI bir yay baglantisi kurulur.
        // Bu, bir ucun cekirdege, baska bir tandrile ya da bagimsiz bir damlaya "dokunup"
        // yeni bir sivi kopru olusturmasini saglar - kopru hicbir yerde elle cizilmez.
        function yenidenBaglan() {
            var esikMesafe = alanW * 0.075 * 1.25;

            for (var i = 0; i < tumParcaciklar.length; i++) {
                var p = tumParcaciklar[i];
                if (p.tur === "cekirdek" || p.proksimalKenar) {
                    continue;
                }

                var enYakin = null, enYakinMesafe = Infinity;
                for (var j = 0; j < tumParcaciklar.length; j++) {
                    var aday = tumParcaciklar[j];
                    if (aday === p) {
                        continue;
                    }
                    var dx = aday.x - p.x, dy = aday.y - p.y;
                    var mesafe = Math.sqrt(dx * dx + dy * dy);
                    if (mesafe < enYakinMesafe) {
                        enYakinMesafe = mesafe;
                        enYakin = aday;
                    }
                }

                if (enYakin && enYakinMesafe < esikMesafe) {
                    baglar.push(kenarOlustur(enYakin, p, alanW * 0.075));
                }
            }
        }

        // 3h) Yaricap guncellemesi: bagli tandril halkalari, KENDI proksimal baglantilarinin
        // ne kadar gerildigine gore hedef yaricaplarini surekli/yumusak sekilde kucultur -
        // bu, kalin daire dizileri yerine ince sivi boyunlar olusmasini saglar. Serbest
        // damlalar kendi kaderlerine (kaybolma/kurtulma) gore buyur ya da kuculur.
        function yaricaplariGuncelle(zamanMs, dt) {
            for (var i = 0; i < tumParcaciklar.length; i++) {
                var p = tumParcaciklar[i];

                if (p.tur === "tandril" && p.durum === "bagli" && p.proksimalKenar) {
                    var k = p.proksimalKenar;
                    var dx = k.b.x - k.a.x, dy = k.b.y - k.a.y;
                    var mesafe = Math.sqrt(dx * dx + dy * dy);
                    var gerginlik = mesafe / k.dogalMesafe;
                    var oran = 1.3 - Math.min(1, Math.max(0, gerginlik - 1)) * 0.85;
                    p.rHedef = Math.max(p.rMin, Math.min(p.rMax, p.rTaban * oran));
                } else if (p.durum === "serbest") {
                    p.rHedef = p.serbestKaderi === "kaybol" ? p.rMin * 0.3 : p.rTaban;
                } else if (p.tur === "cekirdek" && zamanMs >= p.sonrakiYaricapKarari) {
                    p.rHedef = p.rMin + Math.random() * (p.rMax - p.rMin);
                    p.sonrakiYaricapKarari = zamanMs + 1800 + Math.random() * 1400;
                }

                p.r += (p.rHedef - p.r) * Math.min(1, dt * 2.2);
            }
        }

        // 3i) Esik surdirimi: ESIK, kucuk bir bant icinde (yaklasik 0.88-1.16) yavasca ve
        // duzensiz araliklarla yeni bir hedefe dogru surunur - basit bir sinus dongusu degil.
        // Dusuk ESIK kopruleri daha uzun tutar (yuzey gerilimi zayifmis gibi); yuksek ESIK
        // ince koprulerin daha kolay kopmasina yol acar (yuzey gerilimi guclumus gibi).
        function esigiGuncelle(zamanMs, dt) {
            if (zamanMs >= sonrakiEsikKarari) {
                esikHedef = 0.88 + Math.random() * 0.28;
                sonrakiEsikKarari = zamanMs + 1500 + Math.random() * 2500;
            }
            ESIK += (esikHedef - ESIK) * Math.min(1, dt * 0.5);
        }

        // 3) Fizik dongusu: kuvvetleri biriktir -> hizi entegre et -> konumu entegre et ->
        // yirtilma/yeniden-baglanma/yaricap/esik guncellemelerini uygula. Hicbir yerde
        // "kopru/kopma/vb." adinda ozel, zamanli bir davranis kodlanmaz - sadece parcacik
        // geometrisi ve kuvvetler degisir; gorunen sonuc (uzama, kopru, kopma, birlesme)
        // tamamen alanDegerlendir'in bu geometriyi her karede yeniden yorumlamasindan dogar.
        function fizigiGuncelle(zamanMs, dt) {
            for (var i = 0; i < tumParcaciklar.length; i++) {
                tumParcaciklar[i].fx = 0;
                tumParcaciklar[i].fy = 0;
            }

            yayKuvvetleriUygula();
            merkezVeSinirKuvvetiUygula(zamanMs);
            vortexKuvvetiUygula(zamanMs);
            manyetikKuvvetiUygula(zamanMs);

            for (var j = 0; j < tumParcaciklar.length; j++) {
                var p = tumParcaciklar[j];
                p.vx += p.fx * dt;
                p.vy += p.fy * dt;
                var sonum = Math.pow(0.05, dt); // kare hizindan bagimsiz surtunme
                p.vx *= sonum;
                p.vy *= sonum;
            }

            zayifKuvvetleriUygula(zamanMs);
            ucImpulsuUygula(zamanMs);

            for (var m = 0; m < tumParcaciklar.length; m++) {
                var pp = tumParcaciklar[m];
                pp.x += pp.vx * dt;
                pp.y += pp.vy * dt;
            }

            baglariKopart(zamanMs, dt);
            yenidenBaglan();
            yaricaplariGuncelle(zamanMs, dt);
            esigiGuncelle(zamanMs, dt);
        }

        // 4) Alan: dusuk cozunurluklu izgeranin her hucresi icin tum parcaciklarin
        // toplam metaball katkisini hesaplar (r^2/mesafe^2), (yavasca surunen) esik
        // etrafinda yumusatilmis bir alfaya cevirir ve kucuk tuvale yazar. Bu fonksiyon
        // parcaciklarin nereden geldigini (cekirdek/tandril/serbest) bilmez - sadece
        // duz bir x/y/r listesi okur, bu yuzden yeni hareket modeliyle degismeden calisir.
        function alanDegerlendir() {
            var veri = alanVerisi.data;
            var idx = 0;

            for (var gy = 0; gy < GRID_H; gy++) {
                var py = (gy + 0.5) / GRID_H * alanH;
                for (var gx = 0; gx < GRID_W; gx++) {
                    var px = (gx + 0.5) / GRID_W * alanW;
                    var toplam = 0;

                    for (var n = 0; n < tumParcaciklar.length; n++) {
                        var nuk = tumParcaciklar[n];
                        var dx = px - nuk.x;
                        var dy = py - nuk.y;
                        toplam += (nuk.r * nuk.r) / (dx * dx + dy * dy + 1);
                    }

                    var t = (toplam - (ESIK - ESIK_YUMUSAKLIGI)) / (2 * ESIK_YUMUSAKLIGI);
                    t = t < 0 ? 0 : (t > 1 ? 1 : t);
                    var alfa = t * t * (3 - 2 * t);

                    veri[idx] = 255;
                    veri[idx + 1] = 255;
                    veri[idx + 2] = 255;
                    veri[idx + 3] = Math.round(alfa * 255);
                    idx += 4;
                }
            }

            kucukBaglam.putImageData(alanVerisi, 0, 0);
        }

        // 5) Tema: CSS degiskenlerini oku, tek bir gradyan olustur (nukleus basina renk YOK).
        function gradyanOlustur() {
            var stil = getComputedStyle(parlama);
            var renk1 = stil.getPropertyValue("--parlama-1").trim();
            var renk2 = stil.getPropertyValue("--parlama-2").trim();
            var renk3 = stil.getPropertyValue("--parlama-3").trim();

            var g = baglam.createLinearGradient(
                dolguX + alanW * 0.25, dolguY + alanH * 0.25,
                dolguX + alanW * 0.75, dolguY + alanH * 0.75);
            g.addColorStop(0, renk1);
            g.addColorStop(0.55, renk2);
            g.addColorStop(1, renk3);
            return g;
        }

        // Kucuk alan tuvalini (duzgun olceklenerek) gecici tam boy tuvale cizer,
        // gradyani "source-in" ile o maskenin icinden gecirir, sonra hedefe (ana tuvale)
        // AYRI, kendi icinde tutarli bir goruntu olarak bindirir - iki gecis birbirine karismaz.
        function pasoCiz(buyume, bulanikPx, alfa, gradyan) {
            geciciBaglam.clearRect(0, 0, geciciTuval.width, geciciTuval.height);
            geciciBaglam.save();
            if (bulanikPx > 0) {
                geciciBaglam.filter = "blur(" + bulanikPx + "px)";
            }
            geciciBaglam.drawImage(kucukTuval, 0, 0, GRID_W, GRID_H,
                dolguX - buyume / 2, dolguY - buyume / 2, alanW + buyume, alanH + buyume);
            geciciBaglam.filter = "none";
            geciciBaglam.globalCompositeOperation = "source-in";
            geciciBaglam.fillStyle = gradyan;
            geciciBaglam.fillRect(0, 0, canvas.width, canvas.height);
            geciciBaglam.restore();

            baglam.save();
            baglam.globalAlpha = alfa;
            baglam.drawImage(geciciTuval, 0, 0);
            baglam.restore();
        }

        // Su anki alan tuvalinin (kucukTuval) DONMUS bir kopyasini alir. Bu, bir yanki
        // olayinin kaynagi olan gercek siluettir - ayri, uydurulmus bir sekil degildir.
        function silvetSnapshotAl() {
            var t = document.createElement("canvas");
            t.width = GRID_W;
            t.height = GRID_H;
            t.getContext("2d").drawImage(kucukTuval, 0, 0);
            return t;
        }

        // Bir enerjik olay etrafinda 1-3 kontur yankisi katmani olusturur. Katmanlarin
        // hepsi AYNI donmus siluet anlik goruntusunu paylasir (tek bir bozulmadan yayilan
        // kisa bir dizi hissi versin diye); sadece olcek/kayma/bulaniklik/gecikme/opaklik
        // katman indeksine gore kademeli olarak artar/azalir. "yonX/yonY" normallestirilmis
        // bir yon vektorudur - genisleme bu yonde daha belirgin olur (bkz. yankilariCiz).
        function yankiOlustur(zamanMs, yonX, yonY, guc) {
            if (zamanMs < sonrakiYankiZamani) {
                return;
            }
            sonrakiYankiZamani = zamanMs + YANKI_SOGUMA_MS;

            guc = Math.max(0, Math.min(1, guc));
            var anlikGoruntu = silvetSnapshotAl();
            var katmanSayisi = guc > 0.65 ? 3 : (guc > 0.4 ? 2 : 1);

            for (var k = 0; k < katmanSayisi; k++) {
                yankilar.push({
                    tuval: anlikGoruntu,
                    baslangicZamani: zamanMs + k * (55 + Math.random() * 45),
                    omur: 420 + k * 110 + Math.random() * 220,
                    yonX: yonX, yonY: yonY,
                    olcekBitis: 1.2 + k * 0.16 + Math.random() * 0.12,
                    kaymaBitis: alanW * (0.05 + k * 0.045),
                    bulanikBitis: alanW * (0.018 + k * 0.014),
                    alfaBaslangic: (0.24 - k * 0.06) * (0.55 + guc * 0.45)
                });
            }
        }

        // Kontur yankilarini cizer: her katman, donmus siluet anlik goruntusunun olceklenip
        // (merkezden disariya) YONLU olarak kaydirilmis, giderek bulaniklastirilan ve solan
        // bir kopyasidir - ne dolu bir daire, ne de ortalanmis bir halka. Omru dolanlar
        // burada listeden temizlenir; ayrica yeni bir per-frame guncelleme dongusune gerek yoktur.
        function yankilariCiz(zamanMs) {
            if (!yankilar.length) {
                return;
            }

            var renk = getComputedStyle(parlama).getPropertyValue("--parlama-2").trim();
            var merkezX = dolguX + alanW / 2, merkezY = dolguY + alanH / 2;

            for (var i = yankilar.length - 1; i >= 0; i--) {
                var y = yankilar[i];
                var gecenSure = zamanMs - y.baslangicZamani;

                if (gecenSure >= y.omur) {
                    yankilar.splice(i, 1);
                    continue;
                }
                if (gecenSure < 0) {
                    continue; // katman gecikmesi henuz dolmadi
                }

                var t = gecenSure / y.omur;
                var yayilma = 1 - Math.pow(1 - t, 2); // hizli acilir, sonra yavaslar
                var olcek = 1 + (y.olcekBitis - 1) * yayilma;
                var kayma = y.kaymaBitis * yayilma;
                var bulanik = y.bulanikBitis * yayilma;
                var sonum = Math.pow(1 - t, 1.2);
                var alfa = y.alfaBaslangic * sonum;
                if (alfa <= 0.006) {
                    continue;
                }

                var genislik = alanW * olcek;
                var yukseklik = alanH * olcek;
                var hedefX = merkezX - genislik / 2 + y.yonX * kayma;
                var hedefY = merkezY - yukseklik / 2 + y.yonY * kayma;

                geciciBaglam.clearRect(0, 0, geciciTuval.width, geciciTuval.height);
                geciciBaglam.save();
                if (bulanik > 0.5) {
                    geciciBaglam.filter = "blur(" + bulanik + "px)";
                }
                geciciBaglam.drawImage(y.tuval, 0, 0, GRID_W, GRID_H, hedefX, hedefY, genislik, yukseklik);
                geciciBaglam.filter = "none";
                geciciBaglam.globalCompositeOperation = "source-in";
                geciciBaglam.fillStyle = renk;
                geciciBaglam.fillRect(0, 0, canvas.width, canvas.height);
                geciciBaglam.restore();

                baglam.save();
                baglam.globalAlpha = alfa;
                baglam.drawImage(geciciTuval, 0, 0);
                baglam.restore();
            }
        }

        // 6) Render: once kontur yankilari (varsa), sonra kucuk/basit bir parlama gecisi
        // (bulanik, dusuk alfa, hafifce buyutulmus), sonra tanimli ana govde - ikisi de
        // AYNI alan tuvalinden turetilir. Boylece yankilar govdenin ARKASINDAN yayilir.
        function sivyiCiz(zamanMs) {
            var gradyan = gradyanOlustur();
            baglam.clearRect(0, 0, canvas.width, canvas.height);
            yankilariCiz(zamanMs);
            pasoCiz(alanW * 0.08, Math.round(alanW * 0.03), 0.3, gradyan);
            pasoCiz(0, 0, 1, gradyan);
        }

        // 7) Ana dongu: gercek gecen zamana (dt) dayali fizik, #parlama gizliyken atlanir,
        // pahali alan/render adimi ~30fps'e sinirlanir, fizik ise her kare guncellenir.
        function dongu(zamanMs) {
            if (parlama.classList.contains("parlama-gizli") || detParlamaDondu) {
                sonKareZamani = 0; // gorunur oldugunda dt sicramasi yasanmasin
                requestAnimationFrame(dongu);
                return;
            }

            var dt = sonKareZamani ? (zamanMs - sonKareZamani) / 1000 : 0;
            dt = Math.min(dt, 0.05);
            sonKareZamani = zamanMs;

            fizigiGuncelle(zamanMs, dt);

            if (zamanMs - sonAlanZamani >= ALAN_HEDEF_ARALIGI) {
                sonAlanZamani = zamanMs;
                alanDegerlendir();
                sivyiCiz(zamanMs);
            }

            requestAnimationFrame(dongu);
        }

        boyutlandir();
        window.addEventListener("resize", boyutlandir);
        parcaciklariBaslat();
        sonrakiUcImpulsu = performance.now() + 1500 + Math.random() * 2000;
        sonrakiVorteksKontrolu = performance.now() + 1200 + Math.random() * 1500;

        if (azaltilmisHareket) {
            // Tek, statik bir kare: surekli simulasyon calistirilmaz.
            fizigiGuncelle(performance.now(), 0);
            alanDegerlendir();
            sivyiCiz(performance.now());
        } else {
            requestAnimationFrame(dongu);
        }

        // Disariya acilan TEK kanca: SADECE ilk mesaj Şey-seyahati (bkz.
        // parlamayiBalonaTasi, ayri bir <script> blogunda/global kapsamda)
        // bu fonksiyonu, kendi seyahatSure'siyle TAM AYNI anda cagirir -
        // baska HICBIR cagiran YOK, bu yuzden idle/sonraki-mesaj davranisi
        // ETKILENMEDI. yonX/yonY: EKRAN uzayinda, balonun/temas noktasinin
        // bulundugu yone dogru vektor (birim olmasi ZORUNLU degil, burada
        // normallestirilir). sure: manyetik cekimin 0 -> guclu araligini
        // kat edecegi ms - cagiran taraf seyahatSure'yi verir, boylece
        // cekim tam temas anina denk gelecek sekilde tepe noktasina ulasir.
        window.__parlamaManyetikBaslat = function (yonX, yonY, sure) {
            var uzunluk = Math.sqrt(yonX * yonX + yonY * yonY) || 1;
            manyetik.aktif = true;
            manyetik.yonX = yonX / uzunluk;
            manyetik.yonY = yonY / uzunluk;
            manyetik.baslangicZamani = performance.now();
            manyetik.sure = Math.max(1, sure);
        };

        // Manyetik cekimi NOTRE dondurur - parlamayiBalonaTasi, temas anindan
        // (seyahatSure sonra calisan ZATEN VAR OLAN setTimeout icinde) bunu
        // cagirir. Boylece "aktif" durumu, seyahat/temas fazi disina asla
        // TASMAZ - #parlama zaten bu andan sonra sadece emilir/görünmez olur
        // ve BASKA hicbir sey (idle, sonraki mesaj) onu yeniden BASLATMADIGI
        // icin bu, gecici seyahat durumunun kaza sonucu miras kalmayacagini
        // GARANTI eden ek bir guvenlik adimidir.
        window.__parlamaManyetikBitir = function () {
            manyetik.aktif = false;
        };
    })();
</script>

<script>
    // GECICI TANI: temas noktasinda birakilan kucuk "enerji rezervi"
    // elemanini olusturur ve (0.55 -> 1 olcek, 0 -> 1 opaklik) yumusakca
    // belirmesini saglar - SONRA HICBIR SEKILDE gizlenmez/kaldirilmaz (bu
    // asama icin kalici kalmasi istendi). Renkler JS'te SABITLENMEZ - CSS
    // (.temas-enerjisi / [data-bs-theme=dark] .temas-enerjisi) tema-duyarli
    // --temas-1/--temas-2 degiskenlerini zaten tasir, bu yuzden burada
    // sadece konum/boyut/animasyon islenir.
    function temasEnerjisiOlustur(x, y, sure) {
        var el = document.createElement("span");
        el.className = "temas-enerjisi";
        el.setAttribute("aria-hidden", "true");
        el.style.left = x + "px";
        el.style.top = y + "px";
        document.body.appendChild(el);

        if (!el.animate) {
            el.style.opacity = "1";
            el.style.transform = "translate(-50%, -50%) scale(1)";
            return el;
        }

        el.animate(
            [
                { transform: "translate(-50%, -50%) scale(0.55)", opacity: 0 },
                { transform: "translate(-50%, -50%) scale(1)", opacity: 1 }
            ],
            { duration: sure, easing: "ease-out", fill: "forwards" }
        );
        return el;
    }

    // Buyuk merkezi Şey'i TEK, surekli bir WAAPI animasyonuyla (konum + olcek +
    // opaklik AYNI kare dizisinde) yukleme balonunun GERCEK yuvarlatilmis
    // yuzeyindeki EN YAKIN temas noktasina tasir; TEMAS ANINDA (pTemas =
    // seyahatSure/toplamSure) hem EMILIM (absorpsiyon, eskiki adiyla
    // "collapse") baslar hem de AYNI anda cevre akisi (cevreAkisiKur ile EN
    // BASTA kurulmus akis nesnesi, yeniden hesaplanmadan) tetiklenir -
    // ikisi TEK bir paylasilan p (0 -> 1) ilerlemesiyle, TAM fillSuresi
    // boyunca BIRLIKTE surer ve BIRLIKTE tamamlanir (collapseSure artik
    // fillSuresi'ne esitlendi - eskiden 160ms'lik bagimsiz, cok daha kisa
    // bir faz, cevre akisindan onlarca kare erken bitiyordu). Emilim govdeyi
    // (rotate/scale/rotate deseniyle, balona-BAKAN kenar her p'de temas
    // noktasina SABIT) surekli/monoton kucultup temas noktasina ceker;
    // opaklik yalnizca son ~%20'de duser (tek basina bir "opacity-fade"
    // DEGIL). Akis, s0'dan saat yonu + saat yonunun tersine IKI cephe
    // (govde/iz BUYUR, "uc" katmanlari daha parlak/HAREKETLI iki uc olarak
    // govdenin onunde kosar) balonun karsi noktasinda AYNI p=1 aninda
    // bulusur, hale (enerjiKatmaniniEkle/enerjiyiCrossfadeEt) fillSuresi'nin
    // son %20'sinde normal siddetine ulasir, temas rezervi
    // (temasEnerjisiOlustur) akisla senkron dogar ve hizla soner, akis
    // tamamlaninca (fillSuresi sonunda, emilim de TAM O ANDA biter) rastgele
    // tutamlar (yaziyorTutamlariBaslat) baslar - hicbir ayri "final skin"
    // katmani eklenmez.
    function parlamayiBalonaTasi(parlama, hedefBalon, satir) {
        var azaltilmisHareket = window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        if (azaltilmisHareket) {
            // Hareketi azalt tercih edilmisse seyahat/temas/akis gorseli YOK -
            // dogrudan gizle, ama kabul edilmis SON DURUMA (kalici dis yuzey +
            // hale + tutam) yine de gec - reduced-motion kullanicisi sonsuza
            // kadar "cikri" bir yaziyor balonunda kalmasin.
            parlama.classList.add("parlama-gizli");
            balonuEtkinlestir(hedefBalon, satir);
            return;
        }

        // ONEMLI: baslangic, asagida absolute->fixed geciste "su an gorunen
        // konumla BIREBIR ayni noktaya" sabitlemek icin kullanilir (bkz.
        // asagidaki yorum) - bu yuzden BURADA, kullanilmadan hemen once,
        // TAZE olculmek ZORUNDA. Daha erken (orn. cagiran kodda, bir
        // scroll'dan once) olculup buraya tasinirsa, bu satirla o kullanim
        // arasinda gecen HERHANGI bir layout degisikligi (scroll dahil)
        // #parlama'yi gercekten gorundugu yerden FARKLI bir noktaya
        // "dondurur" ve gorunur bir sicramaya/yanlis konuma yol acar.
        var baslangic = parlama.getBoundingClientRect();
        var hedef = hedefBalon.getBoundingClientRect();

        var baslangicMerkezX = baslangic.left + baslangic.width / 2;
        var baslangicMerkezY = baslangic.top + baslangic.height / 2;
        var hedefMerkezX = hedef.left + hedef.width / 2;
        var hedefMerkezY = hedef.top + hedef.height / 2;

        // Disariya dogru birim normal: balon merkezinden, Şey'in GELDIGI yone.
        var yonX = baslangicMerkezX - hedefMerkezX;
        var yonY = baslangicMerkezY - hedefMerkezY;
        var yonUzunluk = Math.sqrt(yonX * yonX + yonY * yonY) || 1;
        yonX /= yonUzunluk;
        yonY /= yonUzunluk;

        // Balonun GERCEK yuvarlatilmis yuzeyindeki en yakin temas noktasi
        // (mevcut, sayisal getPointAtLength hesabi - DEGISMEDI). Cevre akis
        // SVG'si burada EN BASTA kurulur (henuz gorunmez - .yaziyor-akis-yol'un
        // dinlenme hali stroke-dasharray:0px 1px) ve ARTIK ERKEN KALDIRILMIYOR -
        // collapse bitince AYNI akis nesnesi (s0/temasX/temasY DAHIL) asagida
        // cevreAkisiCalistir'e verilecek. Boylece iki yonlu akisin baslangic
        // noktasi, Şey'in temas/collapse icin kullandigi noktayla PIKSEL PIKSEL
        // AYNI olur - ikinci bir hesaplama YOK, sicrama YOK.
        var akis = cevreAkisiKur(hedefBalon, hedef, yonX, yonY);

        // IDLE_GORUNUR_PX: #parlama 300x300px'lik bir sunum kutusu ama bu
        // kutunun BUYUK KISMI seffaf bosluktur - fiziksel olarak "govde"
        // sayilan tek sey merkezi cekirdektir (bkz. parcaciklariBaslat:
        // "cekirdek = parcacikOlustur(..., w * 0.17, 'cekirdek')", w=alanW,
        // alanW #parlama'nin clientWidth'ine (300px) 1:1 karsilik gelir -
        // devicePixelRatio hem fizik uzayina hem tuval CSS boyutuna ayni
        // oranda uygulandigi icin birbirini goturur). Yani idle/scale-1
        // durumunda GERCEKTEN goze carpan/"katı" govde capi yaklasik
        // 2 * 0.17 * 300 = 102px'tir - 300px DEGIL. Onceki hata BUNU
        // gormezden gelip dogrudan 300px'ten olcek turetmekti (30/300=0.10),
        // bu da cekirdegi ezip tandrilleri (ince flamalari) gorunmez
        // kilarak Şey'i "kucuk yuvarlak nokta"ya indirgiyordu.
        var IDLE_GORUNUR_PX = 2 * 0.17 * 300;

        // ONCEKI_TEMAS_OLCEGI: bir onceki tani asamasinin temas olcegi
        // (45px hedef / IDLE_GORUNUR_PX). YENI bir 300px/footprint olcum
        // sistemi ICAT EDILMEDI - MEVCUT bu olcek, asagida SADECE bir
        // carpanla kucultuluyor.
        var ONCEKI_HEDEF_GORUNUR_PX = 45;
        var ONCEKI_TEMAS_OLCEGI = ONCEKI_HEDEF_GORUNUR_PX / IDLE_GORUNUR_PX;

        // KUCULTME_ORANI: mevcut temas olcegini %55-65 araligina indirger -
        // muhafazakar/orta bir deger (0.60): hem "kucuk yuvarlak nokta"ya
        // donme riskini (asiri kucultme) hem yetersiz kucultme riskini
        // dengeler.
        var KUCULTME_ORANI = 0.60;
        var temasOlcegi = ONCEKI_TEMAS_OLCEGI * KUCULTME_ORANI;

        // govdeYaricapi(olcek): verilen olcekte GERCEKTEN gorunur yaricap
        // (IDLE_GORUNUR_PX ile AYNI oranti korunarak). Hem temas anindaki
        // hem de (daha kucuk) collapse yaricaplari icin kullanilir - govde
        // HANGI olcekte olursa olsun, balona-BAKAN kenari boylece HER ZAMAN
        // matematiksel olarak ayni temas noktasinda kalir (dx/dy = temasDx/Y
        // + yon * govdeYaricapi(olcek); kenar = merkez - yon*yaricap =
        // temas noktasi, SABIT - olcek ne olursa olsun sadelesir).
        function govdeYaricapi(olcek) {
            return IDLE_GORUNUR_PX * olcek / 2;
        }
        var temasYaricapi = govdeYaricapi(temasOlcegi);

        var temasDx = akis.temasX - baslangicMerkezX;
        var temasDy = akis.temasY - baslangicMerkezY;
        var dx = temasDx + yonX * temasYaricapi;
        var dy = temasDy + yonY * temasYaricapi;
        var mesafe = Math.sqrt(dx * dx + dy * dy);

        var seyahatSure = Math.max(650, Math.min(950, 650 + mesafe * 0.35));

        // fillSuresi: cevre akisinin (cevreAkisiCalistir, asagida) %0'dan
        // %100'e dolma suresi - DEGERI DEGISMEDI (750ms), sadece tanimi
        // yukari tasindi ki emilim (collapseSure) fazi da AYNI degeri
        // paylassin (bkz. asagi).
        var fillSuresi = 750;

        // Emilim (absorpsiyon): temastan HEMEN sonra baslar ve ARTIK
        // cevre-akisiyla (fillSuresi) TAM AYNI sureyi kapsar - eskiden sabit
        // 160ms'lik, cevre akisindan bagimsiz kisa bir "collapse" fazi idi;
        // bu YUZDEN govde cevre %100 dolmadan cok once gorunmez oluyordu.
        // toplamSure = seyahat + emilim; pTemas, kare dizisindeki seyahat-
        // fazi offsetlerini (0..pTemas) TEK, surekli animasyonun toplam
        // suresine gore yeniden olcekler - DEGISMEDI.
        var collapseSure = fillSuresi;
        var toplamSure = seyahatSure + collapseSure;
        var pTemas = seyahatSure / toplamSure;

        // Teget yonu: rotate(tegetAci) scale(sx,sy) rotate(-tegetAci) deseni
        // icin - bu rotasyondan SONRA sy ekseni disariya-dogru normal (yon)
        // ile hizalanir (asagidaki govdeYaricapi cagrilari HEP sy'ye gore
        // hesaplanir). Onceden kabul edilmis AYNI formul - collapse fazinda
        // yeniden kullanildi, yeniden icat edilmedi.
        var tegetAci = Math.atan2(yonX, -yonY) * 180 / Math.PI;

        parlama.classList.remove("parlama-gizli");

        // Once, gorunen konumuyla BIREBIR ayni noktaya sabitleyerek absolute'tan
        // fixed'e gec (koordinat sistemi degismez, sicrama olmaz).
        parlama.style.transition = "none";
        parlama.style.position = "fixed";
        parlama.style.top = baslangicMerkezY + "px";
        parlama.style.left = baslangicMerkezX + "px";
        parlama.style.zIndex = "3";

        // 1 -> temasOlcegi arasinda yumusak kuculme (seyahat fazi, DEGISMEDI -
        // sadece offsetleri pTemas ile yeniden olceklendi).
        function olcekAra(f) {
            return 1 - (1 - temasOlcegi) * f;
        }

        // RETAIN_ORANI: son ~%20 yaklasmada tekduze kuculmeyi hafifletip
        // temasta ESKI temasOlcegi'nden ~%15-25 daha dolgun bir govde
        // birakmak icin - "kucuk mor sprite" izlenimini duzeltir.
        // temasOlcegi/dx/dy/mesafe/seyahatSure HICBIR SEKILDE etkilenmez.
        // temasOlcegiKorunmus artik SADECE pTemas*0.88 karesinde DEGIL,
        // asagidaki TUM emilim (p=0..1) egrisinin taban buyuklugu olarak da
        // kullanilir (emilimOlcekSy/emilimOlcekSx) - govde temas anindan
        // itibaren bu dolgun buyuklukten baslayip emilir, dogrudan
        // KUCULTULMUS temasOlcegi'nden degil.
        var RETAIN_ORANI = 1.20;
        var temasOlcegiKorunmus = temasOlcegi * RETAIN_ORANI;

        // olcekAraKorunmus(f): f=1'de ULASILAN HEDEF (temasOlcegiKorunmus)
        // DEGISMEDI - SADECE egrinin SEKLI dogrusaldan (f) f^OLCEK_
        // KORUNMUS_USSU'ye (USSU>1, "ease-in") degistirildi. Bu fonksiyon
        // SADECE pTemas*0.88 karesinde cagrilir (ilk yari, pTemas*0.5,
        // MEVCUT olcekAra(0.5) ile DEGISMEDEN kalir - o fonksiyona HIC
        // dokunulmadi). USSU>1 oldugu icin f<1 icin f^USSU < f, yani egri
        // 1'e (baslangic buyuklugune) daha uzun sure YAKIN kalip kucculme
        // esas olarak f=1'e (temasa) yaklasirken yogunlasir - "temas-oncesi
        // seyahatin son ~%40-50'sinde DAHA AZ agresif kucculme" hedefi
        // boylece SADECE bu tek karenin (0.88) DEGERINI yukseltir (~0.40 ->
        // ~0.50), erken/orta seyahati (pTemas*0.5 karesi) etkilemeden.
        // seyahatOlcek88/seyahatMerkez88 bu fonksiyonun DONUS DEGERINI
        // OKUYARAK govdeYaricapi(...) uzerinden radius-aware konumu yeniden
        // hesapladigi icin (bkz. asagida seyahatMerkezi cagrisi), bu tek
        // degisiklik otomatik olarak GEOMETRIK OLARAK TUTARLI kalir - ayrica
        // hicbir yer elle guncellenmedi.
        var OLCEK_KORUNMUS_USSU = 2.4;
        function olcekAraKorunmus(f) {
            return 1 - (1 - temasOlcegiKorunmus) * Math.pow(f, OLCEK_KORUNMUS_USSU);
        }

        // CEKIM sabitleri (DEGISMEDI): govde, gelis yonu boyunca (sy, normal
        // eksen) hafifce uzar - "temas noktasina cekiliyor" hissi - dik
        // yonde (sx, teget eksen) hafifce sikisir. Bu bir CARPMA/SICRAMA
        // DEGIL - sapmalar KUCUK tutuldu. Eskiden SADECE temas karesine
        // (p=0) uygulaniyordu; asagida emilimOlcekSy/Sx'in p=0 ucu olarak
        // AYNEN korunuyor (emilimOlcekSy(0) === temasOlcegiKorunmus *
        // PULL_UZUN, eskiki syTemas ile birebir ozdes).
        var PULL_UZUN = 1.16;  // gelis yonunde gerilme (~1.12-1.20)
        var PULL_DIK = 0.925;  // dik yonde sikisma (~0.90-0.95)

        // EMILIM (absorpsiyon) egrisi - temastan (p=0) tam emilmeye (p=1)
        // kadar TEK, paylasilan bir ilerleme degeri. Bu p, asagidaki
        // setTimeout(..., seyahatSure) ile baslatilan cevreAkisiCalistir'in
        // KENDI ilerlemesiyle (0 -> 1, sure=fillSuresi) es zamanlidir:
        // - p=0 GERCEK zamani == offset pTemas'a bu animasyonda ulasilan an
        //   == seyahatSure sonra calisan setTimeout'un ates aldigi an
        //   (yani cevreAkisiCalistir'in KENDI p=0'i).
        // - p=1 GERCEK zamani == offset 1'e ulasilan an == seyahatSure +
        //   fillSuresi (collapseSure artik fillSuresi'ne esit) == cevre
        //   akisinin KENDI p=1'i (sure=fillSuresi sonu).
        // Iki ayri sayac YOK - offset formulu (pTemas + (1-pTemas)*p) AYNI
        // p'yi bu tek WAAPI zaman cizelgesine gomer.
        //
        // Govde her p'de AYNI govdeYaricapi(sy) teknigiyle (yeniden icat
        // edilmedi) balona-BAKAN kenarini temas noktasina SABIT tutar -
        // govde kendi merkezi etrafinda kucculmez, kalan kutle temas
        // noktasina dogru CEKILIR/emilir. Olcek p arttikca duz/monoton
        // azalir (asla buyumez, sicramaz, tek bir "carpma" karesi yok).
        // Opaklik p<=0.8 boyunca 1'de SABIT kalir - kaybolma saf bir
        // "opacity-fade" DEGIL, neredeyse tamamen olcek/konum
        // degisiminden gelir; yalnizca son ~%20'de, gomulmus kucuk kutle
        // noktada gozden kaybolurken opaklik hizla 0'a iner.
        function emilimOlcekSy(p) {
            return temasOlcegiKorunmus * (PULL_UZUN - (PULL_UZUN - 0.05) * Math.pow(p, 1.6));
        }
        function emilimOlcekSx(p) {
            return temasOlcegiKorunmus * (PULL_DIK - (PULL_DIK - 0.18) * Math.pow(p, 1.3));
        }
        function emilimOpaklik(p) {
            return p <= 0.8 ? 1 : 1 - (p - 0.8) / 0.2;
        }
        function emilimKaresi(p) {
            var sy = emilimOlcekSy(p);
            var sx = emilimOlcekSx(p);
            var dxp = temasDx + yonX * govdeYaricapi(sy);
            var dyp = temasDy + yonY * govdeYaricapi(sy);
            return {
                transform: "translate(-50%, -50%) translate(" + dxp + "px, " + dyp + "px) rotate(" + tegetAci + "deg) scale(" + sx + ", " + sy + ") rotate(" + (-tegetAci) + "deg)",
                opacity: emilimOpaklik(p),
                offset: pTemas + (1 - pTemas) * p
            };
        }

        // SEYAHAT (temas-oncesi) merkez konumu - DUZELTME: eskiden merkez,
        // TEK bir SABIT hedef vektorun (dx,dy - SADECE temasOlcegi'nin KUCUK
        // yaricapina gore hesaplanmisti) basit dogrusal kesri (dx*f) olarak
        // hesaplaniyordu. Bu, o karenin GERCEK (cok daha buyuk) olcegini/
        // yaricapini HIC hesaba katmiyordu - govdenin balona-BAKAN GERCEK
        // kenari, "kucuk" yaricap varsayimina gore hesaplanmis merkeze gore,
        // balonun İCİNE dogru erken tasabiliyordu (crescent/occlusion
        // izlenimi). dx/dy/mesafe/seyahatSure KENDILERI DEGISMEDI (hala
        // asagida mesafe/seyahatSure icin kullaniliyor) - SADECE bu iki ara
        // karenin translate'i icin ARTIK kullanilmiyorlar.
        //
        // Duzeltme, emilimKaresi'nin (temas SONRASI) ZATEN kullandigi AYNI
        // "merkez = kenar + yon*yaricap" ozdesligini (bkz. yukaridaki
        // govdeYaricapi yorumu) temas-ONCESI fazina da tasir: govdenin
        // balona-BAKAN kenari, baslangictaki GERCEK kenar konumundan
        // (edgeBaslangicDx/Dy - olcek=1'deki govdeYaricapi ile, f=0'da
        // translate(0,0)'i BIREBIR yeniden uretecek sekilde) temas
        // noktasina (temasDx/Dy) DOGRUSAL olarak ilerler; merkez, HER
        // karede O KARENIN GERCEK olcegine (olcekAra/olcekAraKorunmus,
        // DEGISMEDI) gore govdeYaricapi(...) ile kenardan geriye dogru
        // turetilir. Olcek/deformasyon egrisi, zamanlama (pTemas,
        // offsetler), temas noktasi (s0/temasX/Y) ve emilimKaresi'nin
        // KENDISI HICBIR SEKILDE degismedi - sadece bu iki ara karenin
        // merkez KONUMU artik kendi GERCEK yaricapini hesaba katiyor.
        var edgeBaslangicDx = -yonX * govdeYaricapi(1);
        var edgeBaslangicDy = -yonY * govdeYaricapi(1);

        function seyahatMerkezi(f, olcek) {
            var kenarX = edgeBaslangicDx + (temasDx - edgeBaslangicDx) * f;
            var kenarY = edgeBaslangicDy + (temasDy - edgeBaslangicDy) * f;
            var r = govdeYaricapi(olcek);
            return { x: kenarX + yonX * r, y: kenarY + yonY * r };
        }

        var seyahatOlcek50 = olcekAra(0.5);
        var seyahatOlcek88 = olcekAraKorunmus(0.88);
        var seyahatMerkez50 = seyahatMerkezi(0.5, seyahatOlcek50);
        var seyahatMerkez88 = seyahatMerkezi(0.88, seyahatOlcek88);

        var kareler = [
            { transform: "translate(-50%, -50%) translate(0px, 0px) scale(1, 1)", opacity: 1, offset: 0 },
            { transform: "translate(-50%, -50%) translate(" + seyahatMerkez50.x + "px, " + seyahatMerkez50.y + "px) scale(" + seyahatOlcek50 + ", " + seyahatOlcek50 + ")", opacity: 1, offset: pTemas * 0.5 },
            { transform: "translate(-50%, -50%) translate(" + seyahatMerkez88.x + "px, " + seyahatMerkez88.y + "px) scale(" + seyahatOlcek88 + ", " + seyahatOlcek88 + ")", opacity: 1, offset: pTemas * 0.88 },
            emilimKaresi(0),
            emilimKaresi(0.25),
            emilimKaresi(0.5),
            emilimKaresi(0.75),
            emilimKaresi(0.92),
            emilimKaresi(1)
        ];

        // =====================================================================
        // DETERMINISTIK SON-YAKLASIM + EMILIM (ilk mesaj SADECE). Seyahatin ilk
        // DET_MORPH_BASLANGIC_ORANI orani TAMAMEN prosedurel kalir (#parlama'nin
        // KENDI kareler/WAAPI animasyonu, asagida DEGISMEDI) - govdenin
        // "duzensiz/manyetik karakteri" bu asamada HICBIR SEKILDE etkilenmez.
        // Seyahatin SON diliminde, TAMAMEN AYRI, position:fixed bir viewport
        // canvas'i devralir ve govde/boyun/uc'u KAPALI-FORM Bezier yollarla
        // cizer - alanDegerlendir/metaball/SDF/esik YOK, konum/boyut HER KAREDE
        // acikca bilinen sayilardir. Ayarlanabilir TUM sabitler TEK blokta
        // gruplanmistir - ileride kucuk gorsel ayarlar icin BASKA HICBIR YERE
        // dokunmak GEREKMEZ.
        // DET_MORPH_BASLANGIC_ORANI: TANI (kullanici geri bildirimi, ikinci
        // tur) - 0.42'de bile govde GORULEBILIR bir sure (yolun ~%40'i)
        // SADECE prosedurel/yuvarlak kaliyordu, boylece goz "bu top" diye
        // KILITLENEBILIYORDU - sonra deterministik devraldiginda, RENK/HALE/
        // TITREME AYNI olsa BILE, bu "once A, sonra B" ALGISI "birden
        // donusuyor" gibi okunuyordu. Stil eslestirmesi (hale/3-renk/
        // titreme) dogru yonde ama TEK BASINA yetmiyordu - ASIL sorun
        // GECISIN KENDISI, gozun ayirt edebilecegi bir "ONCE/SONRA" ani
        // olmasi. Cozum: gecisi NEREDEYSE BASA (0.05) cekmek - govde yola
        // ciktiktan HEMEN sonra (seyahatSure'nin ilk ~%5'i, tipik ~35-50ms)
        // deterministik canvas devralir, boylece "kilitlenecek" bir
        // yuvarlak-SADECE donem KALMAZ - govde BASTAN itibaren (m=0'dan)
        // SUREKLI ve kademeli olarak incelirken gorunur, ayrik bir "donusum
        // ani" YOKTUR. detMorphSuresi artik seyahatSure'nin ~%95'i - taper
        // icin cok daha fazla kare/zaman.
        var DET_MORPH_BASLANGIC_ORANI = 0.05;
        // DET_GECIS_SURESI: YENIDEN TANI (kullanici geri bildirimi, on ucuncu
        // tur - "renkler daha da kotu oldu, hepsi farkli yerdeymis gibi") -
        // #parlama'nin (SABIT ekran-kosegeni gradyanli) ve yeni canvas'in
        // (seyahat-yonu gradyanli) eksenleri farkli oldugundan, ikisi ne
        // kadar UZUN sure AYNI ANDA gorunurse renk uyusmazligi o kadar
        // belirgin oluyor (detParlamaDondu ile titreme onlendi ama eksen
        // farki HALA var). 100ms yerine 50ms - cakisma penceresi yariya
        // indi, "pop" riskini detParlamaDondu (donmus/sabit son kare, ani
        // sicrama yok) zaten azaltiyor.
        var DET_GECIS_SURESI = 50;                    // ms - #parlama -> canvas crossfade suresi
        var DET_GOVDE_ARKA_KATSAYI = 1.05;            // govde "arka kutup" mesafesi = govdeYariGenislik * bu
        var DET_GOVDE_KAIDE_PAY_ORANI = 0.5;          // govde merkezi, boyun kaidesinin govdeYariGenislik*bu KADAR gerisinde
        var DET_GOVDE_YARIGENISLIK_BASLANGIC = 1.00;  // m=0'da govde yari-genisligi (handoffYaricap'a gore)
        // DET_GOVDE_YARIGENISLIK_BITIS: TANI (kullanici geri bildirimi) - 0.80
        // ile govde SADECE %20 kuculuyordu, boylece boyun uzayip incelse BILE
        // govdenin KENDISI yaklasma boyunca hep "kocaman" kaliyordu ("yaklastikca
        // cok daha incelsin hala kocaman bisey geliyo"). Simdi govde de (boyun
        // gibi) belirgin sekilde kuculuyor - govde/boyun-kaidesi/uc ORANLARI
        // (DET_BOYUN_KAIDE_ORANI_BITIS vb.) govdeYariGenislik'e GORE tanimli
        // oldugundan, onlarin MUTLAK genislikleri de otomatik olarak orantili
        // kucculur - ayrica degistirilmeleri GEREKMEZ.
        var DET_GOVDE_YARIGENISLIK_BITIS = 0.22;      // m=1'de govde yari-genisligi - TANI (kullanici geri bildirimi, altinci tur) "govde hala buyuk kaliyor", 0.32'den dusuruldu
        // DET_BOYUN_UZUNLUK_BASLANGIC/DET_BOYUN_KAIDE_ORANI_BASLANGIC/
        // DET_UC_YARIGENISLIK_BASLANGIC: TANI (kullanici geri bildirimi,
        // dorduncu tur - "cok inceden baslayip sonra normal olmasi") -
        // ONCEDEN bu ucu, m=0'da boyun NEREDEYSE YOK (0.05) ve uc HALA
        // NISBETEN KALIN (0.42) baslayip govdeyle BIRLIKTE zamanla
        // uzuyor/inceliyordu - ilk birkac karede goz hala "sade, duz bir
        // top" goruyordu, ince/uzun kisim BELIRGINLESMESI biraz zaman
        // aliyordu. O turde BOYUN/UC m=0'da ZATEN BITIS (nihai) degerinde
        // baslayacak sekilde SABITLENMISTI (BASLANGIC=BITIS) - ama bu, ONCEKI
        // (metaball-oncesi, manyetik cekirdek-lob) surumde kullanicinin
        // onayladigi "deformasyon yolun ortasina dogru KADEMELI artar" hissini
        // (bkz. eski MANYETIK_BASLANGIC_ORANI=0.52) kaybetti - govde
        // disindaki HER SEY ilk kareden itibaren zaten ince/uzundu, "gitgide
        // incelme" goruntusu YOKTU. YENIDEN TANI (kullanici geri bildirimi,
        // yedinci tur) - "direkt donusmesin, once hafif cekilsin, sonra
        // gitgide incelesi artsin": BOYUN/UC yeniden BASLANGIC != BITIS
        // yapildi (asagida), boylece DET_OMUZ_ASAMA_*/DET_UC_ASAMA_*
        // pencereleri (asagida) tekrar AKTIF calisir - govde HALA
        // detHandoffYaricap ile sicramasiz baslar, ama boyun/uc de artik
        // govdeyle BIRLIKTE, kendi asama pencerelerinde kademeli inceliyor.
        // DET_BOYUN_UZUNLUK_GOVDE_ORANI: TANI (kullanici geri bildirimi,
        // altinci tur - "ikisinde de 0.5'lerde iyi gibi") - boyun uzunlugu
