<script>
    (function () {
        var baslik = document.getElementById("selamlama-baslik");
        if (!baslik) {
            return;
        }

        var saat = new Date().getHours();
        var metin;

        if (saat >= 5 && saat < 12) {
            metin = "Günaydın";
        } else if (saat >= 12 && saat < 18) {
            metin = "İyi günler";
        } else if (saat >= 18 && saat < 22) {
            metin = "İyi akşamlar";
        } else {
            metin = "İyi geceler";
        }

        baslik.textContent = metin;
    })();
</script>

<script>
    (function () {
        var parlama = document.getElementById("parlama");
        var canvas = parlama && parlama.querySelector(".parlama-canvas");
        if (!parlama || !canvas) {
            return;
        }
        var baglam = canvas.getContext("2d");

        var azaltilmisHareket = window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        // Dusuk cozunurluklu skaler alan icin kucuk, ayri bir tuval (bkz. alanDegerlendir/boyutlandir).
        // 72 gorunur pixelasyona yol aciyordu; 144 hala ucuz ama belirgin sekilde daha pürüzsüz.
        var GRID_W = 144;
        var GRID_H = 144;
        var ESIK = 1;
        var ESIK_YUMUSAKLIGI = 0.35;
        var ALAN_HEDEF_ARALIGI = 1000 / 30; // pahali alan hesaplamasi icin ~30fps hedefi

        // Govde/parlama/kontur yankilari eski kare sinirinda kirpiliyordu. Fizik/parcacik
        // uzayi HER ZAMAN mantiksal alanW/alanH icinde kalir (motion/size DEGISMEZ) - sadece
        // render asamasinda bu oran kadar seffaf, tasan bir dolgu payi eklenir (bkz.
        // boyutlandir, pasoCiz, yankilariCiz, gradyanOlustur).
        var DOLGU_ORANI = 0.35;
        var alanW = 0, alanH = 0, dolguX = 0, dolguY = 0;

        var kucukTuval = document.createElement("canvas");
        kucukTuval.width = GRID_W;
        kucukTuval.height = GRID_H;
        var kucukBaglam = kucukTuval.getContext("2d");
        var alanVerisi = kucukBaglam.createImageData(GRID_W, GRID_H);

        var geciciTuval = document.createElement("canvas");
        var geciciBaglam = geciciTuval.getContext("2d");

        // Cekirdek + tandril zincirleri (bkz. parcaciklariBaslat) - tumu ayni duz listede
        // tutulur ki alanDegerlendir hicbir degisiklik gerektirmeden onlari okuyabilsin.
        var tumParcaciklar = [];
        var baglar = [];   // aktif yay baglantilari: {a, b, dogalMesafe, gerginlikSuresi, kopmaSuresi}
        var uclar = [];    // her tandrilin sabit "uc" parcacigi - guclu itkilerin hedefi
        var cekirdek = null;

        var YAY_SERTLIGI = 9;
        var GERME_ESIGI = 2.4; // dogal mesafenin kac kati asilirsa kopma sayaci islemeye baslar

        var sonrakiUcImpulsu = 0;
        var aktifVorteks = null;
        var sonrakiVorteksKontrolu = 0;
        var esikHedef = 1;
        var sonrakiEsikKarari = 0;

        var sonKareZamani = 0;
        var sonAlanZamani = 0;

        // Kontur yankilari: mevcut siluetin (kucukTuval) donmus, kucuk anlik goruntuleri -
        // yeni bir sekil UYDURULMAZ, sadece o anki govde formu disari dogru yonlu bir
        // sekilde genisletilip bulaniklastirilir ve soner (bkz. yankiOlustur/yankilariCiz).
        var yankilar = [];
        var sonrakiYankiZamani = 0;
        var YANKI_SOGUMA_MS = 550; // enerjik olmayan normal hareket surekli yanki tetiklemesin

        // 1) Kurulum: tuval boyutunu #parlama'nin gercek gorunen kutusundan al.
        // devicePixelRatio kasitli olarak sinirlanir (netlik icin makul bir tavanla) - bu
        // kucuk, susleyici bir gorsel, tam retina cozunurlugu gereksiz maliyet demektir.
        //
        // Canvas'in kendisi #parlama'dan DOLGU_ORANI kadar daha buyuk cizilir ve negatif
        // left/top ile disariya tasirilir, boylece #parlama'nin kendi layout kutusu
        // (clientWidth/clientHeight, getBoundingClientRect - reparenting/loading kodunun
        // guvendigi seyler) hicbir sekilde degismez; sadece render icin fazladan seffaf
        // alan acilir. Fizik hala mantiksal alanW/alanH uzerinde calisir, bu yuzden gorunen
        // boyut/hareket AYNI kalir - degisen sadece tasmaya izin verilen kirpma sinirlaridir.
        function boyutlandir() {
            var dpr = Math.min(window.devicePixelRatio || 1, 2);
            var genislikCss = parlama.clientWidth || 300;
            var yukseklikCss = parlama.clientHeight || 300;
            var dolguXCss = genislikCss * DOLGU_ORANI / 2;
            var dolguYCss = yukseklikCss * DOLGU_ORANI / 2;

            canvas.style.left = (-dolguXCss) + "px";
            canvas.style.top = (-dolguYCss) + "px";
            canvas.style.right = "auto";
            canvas.style.bottom = "auto";
            canvas.style.width = (genislikCss + dolguXCss * 2) + "px";
            canvas.style.height = (yukseklikCss + dolguYCss * 2) + "px";

            alanW = Math.round(genislikCss * dpr);
            alanH = Math.round(yukseklikCss * dpr);
            dolguX = Math.round(dolguXCss * dpr);
            dolguY = Math.round(dolguYCss * dpr);

            canvas.width = alanW + dolguX * 2;
            canvas.height = alanH + dolguY * 2;
            geciciTuval.width = canvas.width;
            geciciTuval.height = canvas.height;

            baglam.imageSmoothingEnabled = true;
            geciciBaglam.imageSmoothingEnabled = true;
        }

        // Tek bir parcacik: cekirdek ya da bir tandril zincirinin bir halkasi.
        // "durum" gorsel/davranissal degil, salt fizik amaclidir: hangi kuvvetlerin
        // uygulanacagini ve yaricabin nasil hedeflenecegini belirler.
        function parcacikOlustur(x, y, r, tur) {
            return {
                tur: tur, // "cekirdek" | "tandril"
                durum: tur === "cekirdek" ? "cekirdek" : "bagli", // "cekirdek" | "bagli" | "serbest"
                x: x, y: y, vx: 0, vy: 0, fx: 0, fy: 0,
                r: r, rTaban: r, rHedef: r, rMin: r * 0.3, rMax: r * 1.35,
                proksimalKenar: null,
                sonrakiZayifKuvvet: 0,
                sonrakiYaricapKarari: 0,
                serbestKaderi: null // "kaybol" | "geriDon" - kopunca rastgele atanir
            };
        }

        // Iki parcacik arasinda yumusak bir yay baglantisi kurar. "b" tarafi "a"ya
        // (merkeze daha yakin olana) bagli kabul edilir; proksimalKenar bu yuzden b'ye yazilir.
        function kenarOlustur(a, b, dogalMesafe) {
            var kenar = {
                a: a, b: b, dogalMesafe: dogalMesafe,
                gerginlikSuresi: 0, kopmaSuresi: 0.35 + Math.random() * 0.4
            };
            b.proksimalKenar = kenar;
            b.durum = "bagli";
            return kenar;
        }

        // 2) Baslangic durumu: 1 cekirdek + 4 tandril (her biri cekirdek -- p1 -- p2 -- p3 -- uc
        // seklinde 4 halkalik bir zincir). Halkalar birbirini gorunmez yay baglantilariyla takip eder.
        function parcaciklariBaslat() {
            var w = alanW;
            var merkezX = alanW / 2, merkezY = alanH / 2;
            var simdi = performance.now();
            var dogalMesafe = w * 0.075;

            cekirdek = parcacikOlustur(merkezX, merkezY, w * 0.17, "cekirdek");
            cekirdek.rMin = w * 0.15;
            cekirdek.rMax = w * 0.19;
            cekirdek.sonrakiYaricapKarari = simdi + 1800 + Math.random() * 1400;

            tumParcaciklar = [cekirdek];
            baglar = [];
            uclar = [];

            var tandrilSayisi = 4;
            var zincirUzunlugu = 4;

            for (var t = 0; t < tandrilSayisi; t++) {
                var aci = (Math.PI * 2 * t) / tandrilSayisi + Math.random() * 0.6;
                var onceki = cekirdek;

                for (var k = 0; k < zincirUzunlugu; k++) {
                    var mesafe = w * 0.05 + k * 2; // baslangicta cekirdege yakin, ic ice
                    var p = parcacikOlustur(
                        merkezX + Math.cos(aci) * mesafe,
                        merkezY + Math.sin(aci) * mesafe,
                        w * 0.045, "tandril");
                    p.sonrakiZayifKuvvet = simdi + 400 + Math.random() * 700;

                    baglar.push(kenarOlustur(onceki, p, dogalMesafe));
                    tumParcaciklar.push(p);
                    onceki = p;
                }

                uclar.push(onceki);
            }
        }

        // 3a) Komsu parcaciklar arasindaki yay kuvveti: dogal mesafeden uzaklasmis her
        // baglanti, iki ucunu da (Newton'un ucuncu yasasi geregi) birbirine dogru ceker/iter.
        // Sertligi dusuk tutuldugu icin zincir kolayca gerilir ve kavis alabilir - rijit degildir.
        function yayKuvvetleriUygula() {
            for (var i = 0; i < baglar.length; i++) {
                var k = baglar[i];
                var dx = k.b.x - k.a.x, dy = k.b.y - k.a.y;
                var mesafe = Math.sqrt(dx * dx + dy * dy) || 0.001;
                var kuvvet = (mesafe - k.dogalMesafe) * YAY_SERTLIGI;
                var ux = dx / mesafe, uy = dy / mesafe;

                k.a.fx += ux * kuvvet; k.a.fy += uy * kuvvet;
                k.b.fx -= ux * kuvvet; k.b.fy -= uy * kuvvet;
            }
        }

        // 3b) Her parcacik icin hafif bir merkeze meyil (cekirdek icin cok daha guclu -
        // bu, cekirdegin sabit kalmasini saglayan asil mekanizmadir) ve sinirin otesinde
        // giderek guclenen, sert olmayan bir geri cagirma (duvar sekmesi degil).
        function merkezVeSinirKuvvetiUygula() {
            var merkezX = alanW / 2, merkezY = alanH / 2;
            var sinirYaricap = alanW * 0.48;

            for (var i = 0; i < tumParcaciklar.length; i++) {
                var p = tumParcaciklar[i];
                var dx = merkezX - p.x, dy = merkezY - p.y;
                var mesafe = Math.sqrt(dx * dx + dy * dy);
                var k = p.tur === "cekirdek" ? 34 : 0.9;

                p.fx += dx * k;
                p.fy += dy * k;

                if (mesafe > sinirYaricap) {
                    var asiri = mesafe - sinirYaricap;
                    p.fx += (dx / (mesafe || 1)) * asiri * 35;
                    p.fy += (dy / (mesafe || 1)) * asiri * 35;
                }
            }
        }

        // 3c) Duzensiz araliklarla, her (cekirdek disi) parcacigin hizina kucuk, rastgele
        // yonlu bir itki eklenir - konum degil hiz degisir, bu yuzden hareket sarsintili degil akicidir.
        function zayifKuvvetleriUygula(zamanMs) {
            for (var i = 0; i < tumParcaciklar.length; i++) {
                var p = tumParcaciklar[i];
                if (p.tur === "cekirdek" || zamanMs < p.sonrakiZayifKuvvet) {
                    continue;
                }
                var aci = Math.random() * Math.PI * 2;
                var guc = alanW * (0.08 + Math.random() * 0.14);
                p.vx += Math.cos(aci) * guc;
                p.vy += Math.sin(aci) * guc;
                p.sonrakiZayifKuvvet = zamanMs + 400 + Math.random() * 700;
            }
        }

        // 3d) Ongorulemeyen araliklarla, rastgele bir tandril ucuna guclu bir itki uygulanir.
        // Buyukluk genis bir aralikta rastgeledir - bazen kucuk bir sicrayis, bazen govdeyi
        // gercekten uzaklara gerecek kadar dramatik. Zincirin geri kalani onu gecikmeli takip eder.
        function ucImpulsuUygula(zamanMs) {
            if (zamanMs < sonrakiUcImpulsu) {
                return;
            }
            var hedef = uclar[Math.floor(Math.random() * uclar.length)];
            var aci = Math.random() * Math.PI * 2;
            var guc = alanW * (0.4 + Math.random() * 1.8);

            // Belirgin sekilde guclu darbelerde, darbenin kendi yonunu ("aci") kontur
            // yankisinin yonlu egilimi olarak kullan - dalganin nereden geldigi belli olsun.
            var gucOrani = (guc / alanW - 0.4) / 1.8;
            if (gucOrani > 0.35) {
                yankiOlustur(zamanMs, Math.cos(aci), Math.sin(aci), gucOrani);
            }

            hedef.vx += Math.cos(aci) * guc;
            hedef.vy += Math.sin(aci) * guc;
            sonrakiUcImpulsu = zamanMs + 1800 + Math.random() * 2700;
        }

        // 3e) Ara sira, gecici bir "vorteks" penceresi acilir: merkez veya rastgele bir
        // parcacigin o anki konumu etrafinda, yakindaki parcaciklara teget (radyal degil)
        // yonde bir kuvvet uygulanir - bu, kollarin duz degil kavisli/donerek hareket
        // etmesini saglar. Etkinken bile sadece yakin parcaciklari, mesafeyle azalarak etkiler.
        function vortexKuvvetiUygula(zamanMs) {
            if (aktifVorteks && zamanMs > aktifVorteks.bitis) {
                aktifVorteks = null;
            }

            if (!aktifVorteks && zamanMs >= sonrakiVorteksKontrolu) {
                var merkezdeMi = Math.random() < 0.5;
                var kaynak = merkezdeMi
                    ? { x: alanW / 2, y: alanH / 2 }
                    : tumParcaciklar[Math.floor(Math.random() * tumParcaciklar.length)];

                aktifVorteks = {
                    x: kaynak.x, y: kaynak.y,
                    bitis: zamanMs + 600 + Math.random() * 1000,
                    yon: Math.random() < 0.5 ? 1 : -1,
                    guc: alanW * (0.5 + Math.random() * 0.8),
                    yaricap: alanW * 0.5
                };
                sonrakiVorteksKontrolu = aktifVorteks.bitis + 800 + Math.random() * 1800;
            }

            if (!aktifVorteks) {
                return;
            }

            for (var i = 0; i < tumParcaciklar.length; i++) {
                var p = tumParcaciklar[i];
                var dx = p.x - aktifVorteks.x, dy = p.y - aktifVorteks.y;
                var mesafe = Math.sqrt(dx * dx + dy * dy);
                if (mesafe > aktifVorteks.yaricap || mesafe < 1) {
                    continue;
                }
                var etki = 1 - mesafe / aktifVorteks.yaricap;
                var tx = -dy / mesafe, ty = dx / mesafe; // yaricap vektorune dik (teget) yon
                var kuvvet = aktifVorteks.guc * etki * aktifVorteks.yon;
                p.fx += tx * kuvvet;
                p.fy += ty * kuvvet;
            }
        }

        // 3f) Yirtilma: bir baglantinin uzunlugu, dogal mesafesinin GERME_ESIGI katini
        // asarsa bir sayac islemeye baslar; bu durum yeterince uzun surerse (kenara ozel,
        // rastgele belirlenmis bir sure) baglanti TAMAMEN kopar. Bu, gecerli parcacik
        // geometrisinden doner - hicbir yerde "simdi kop" diye zamanli bir olay yoktur.
        function baglariKopart(zamanMs, dt) {
            for (var i = baglar.length - 1; i >= 0; i--) {
                var k = baglar[i];
                var dx = k.b.x - k.a.x, dy = k.b.y - k.a.y;
                var mesafe = Math.sqrt(dx * dx + dy * dy) || 1;

                if (mesafe > k.dogalMesafe * GERME_ESIGI) {
                    k.gerginlikSuresi += dt;
                } else {
                    k.gerginlikSuresi = Math.max(0, k.gerginlikSuresi - dt * 2);
                }

                if (k.gerginlikSuresi >= k.kopmaSuresi) {
                    // Kopan baglantinin ekseni boyunca (proksimalden distale) yonlu bir
                    // kontur yankisi baslat - yirtilma da "enerjik" bir olay kabul edilir.
                    yankiOlustur(zamanMs, dx / mesafe, dy / mesafe, 0.45);

                    baglar.splice(i, 1);
                    k.b.proksimalKenar = null;
                    serbestBirakZincirGrubu(k.b);
                }
            }
        }

        // Kopan bir baglantinin distal (uc) tarafindaki tum zinciri "serbest damla grubu"
        // yapar - aralarindaki kendi baglantilari bozulmaz, sadece cekirdege giden yol kesilir.
        // Her serbest parcacik, kendine ozgu rastgele bir kaderle (kaybol / geri don) kaybolur
        // ya da govdeye don meyilli hale gelir - hepsi ayni davranmaz.
        function serbestBirakZincirGrubu(baslangic) {
            var kuyruk = [baslangic];
            while (kuyruk.length) {
                var p = kuyruk.shift();
                p.durum = "serbest";
                p.serbestKaderi = Math.random() < 0.5 ? "kaybol" : "geriDon";
                for (var i = 0; i < baglar.length; i++) {
                    if (baglar[i].a === p) {
                        kuyruk.push(baglar[i].b);
                    }
                }
            }
        }

        // 3g) Yeniden baglanma: proksimal baglantisi olmayan (cekirdek disi) her parcacik,
        // en yakin diger parcacigini arar; yeterince yaklasirsa YENI bir yay baglantisi kurulur.
        // Bu, bir ucun cekirdege, baska bir tandrile ya da bagimsiz bir damlaya "dokunup"
        // yeni bir sivi kopru olusturmasini saglar - kopru hicbir yerde elle cizilmez.
        function yenidenBaglan() {
            var esikMesafe = alanW * 0.075 * 1.25;

            for (var i = 0; i < tumParcaciklar.length; i++) {
                var p = tumParcaciklar[i];
                if (p.tur === "cekirdek" || p.proksimalKenar) {
                    continue;
                }

                var enYakin = null, enYakinMesafe = Infinity;
                for (var j = 0; j < tumParcaciklar.length; j++) {
                    var aday = tumParcaciklar[j];
                    if (aday === p) {
                        continue;
                    }
                    var dx = aday.x - p.x, dy = aday.y - p.y;
                    var mesafe = Math.sqrt(dx * dx + dy * dy);
                    if (mesafe < enYakinMesafe) {
                        enYakinMesafe = mesafe;
                        enYakin = aday;
                    }
                }

                if (enYakin && enYakinMesafe < esikMesafe) {
                    baglar.push(kenarOlustur(enYakin, p, alanW * 0.075));
                }
            }
        }

        // 3h) Yaricap guncellemesi: bagli tandril halkalari, KENDI proksimal baglantilarinin
        // ne kadar gerildigine gore hedef yaricaplarini surekli/yumusak sekilde kucultur -
        // bu, kalin daire dizileri yerine ince sivi boyunlar olusmasini saglar. Serbest
        // damlalar kendi kaderlerine (kaybolma/kurtulma) gore buyur ya da kuculur.
        function yaricaplariGuncelle(zamanMs, dt) {
            for (var i = 0; i < tumParcaciklar.length; i++) {
                var p = tumParcaciklar[i];

                if (p.tur === "tandril" && p.durum === "bagli" && p.proksimalKenar) {
                    var k = p.proksimalKenar;
                    var dx = k.b.x - k.a.x, dy = k.b.y - k.a.y;
                    var mesafe = Math.sqrt(dx * dx + dy * dy);
                    var gerginlik = mesafe / k.dogalMesafe;
                    var oran = 1.3 - Math.min(1, Math.max(0, gerginlik - 1)) * 0.85;
                    p.rHedef = Math.max(p.rMin, Math.min(p.rMax, p.rTaban * oran));
                } else if (p.durum === "serbest") {
                    p.rHedef = p.serbestKaderi === "kaybol" ? p.rMin * 0.3 : p.rTaban;
                } else if (p.tur === "cekirdek" && zamanMs >= p.sonrakiYaricapKarari) {
                    p.rHedef = p.rMin + Math.random() * (p.rMax - p.rMin);
                    p.sonrakiYaricapKarari = zamanMs + 1800 + Math.random() * 1400;
                }

                p.r += (p.rHedef - p.r) * Math.min(1, dt * 2.2);
            }
        }

        // 3i) Esik surdirimi: ESIK, kucuk bir bant icinde (yaklasik 0.88-1.16) yavasca ve
        // duzensiz araliklarla yeni bir hedefe dogru surunur - basit bir sinus dongusu degil.
        // Dusuk ESIK kopruleri daha uzun tutar (yuzey gerilimi zayifmis gibi); yuksek ESIK
        // ince koprulerin daha kolay kopmasina yol acar (yuzey gerilimi guclumus gibi).
        function esigiGuncelle(zamanMs, dt) {
            if (zamanMs >= sonrakiEsikKarari) {
                esikHedef = 0.88 + Math.random() * 0.28;
                sonrakiEsikKarari = zamanMs + 1500 + Math.random() * 2500;
            }
            ESIK += (esikHedef - ESIK) * Math.min(1, dt * 0.5);
        }

        // 3) Fizik dongusu: kuvvetleri biriktir -> hizi entegre et -> konumu entegre et ->
        // yirtilma/yeniden-baglanma/yaricap/esik guncellemelerini uygula. Hicbir yerde
        // "kopru/kopma/vb." adinda ozel, zamanli bir davranis kodlanmaz - sadece parcacik
        // geometrisi ve kuvvetler degisir; gorunen sonuc (uzama, kopru, kopma, birlesme)
        // tamamen alanDegerlendir'in bu geometriyi her karede yeniden yorumlamasindan dogar.
        function fizigiGuncelle(zamanMs, dt) {
            for (var i = 0; i < tumParcaciklar.length; i++) {
                tumParcaciklar[i].fx = 0;
                tumParcaciklar[i].fy = 0;
            }

            yayKuvvetleriUygula();
            merkezVeSinirKuvvetiUygula();
            vortexKuvvetiUygula(zamanMs);

            for (var j = 0; j < tumParcaciklar.length; j++) {
                var p = tumParcaciklar[j];
                p.vx += p.fx * dt;
                p.vy += p.fy * dt;
                var sonum = Math.pow(0.05, dt); // kare hizindan bagimsiz surtunme
                p.vx *= sonum;
                p.vy *= sonum;
            }

            zayifKuvvetleriUygula(zamanMs);
            ucImpulsuUygula(zamanMs);

            for (var m = 0; m < tumParcaciklar.length; m++) {
                var pp = tumParcaciklar[m];
                pp.x += pp.vx * dt;
                pp.y += pp.vy * dt;
            }

            baglariKopart(zamanMs, dt);
            yenidenBaglan();
            yaricaplariGuncelle(zamanMs, dt);
            esigiGuncelle(zamanMs, dt);
        }

        // 4) Alan: dusuk cozunurluklu izgeranin her hucresi icin tum parcaciklarin
        // toplam metaball katkisini hesaplar (r^2/mesafe^2), (yavasca surunen) esik
        // etrafinda yumusatilmis bir alfaya cevirir ve kucuk tuvale yazar. Bu fonksiyon
        // parcaciklarin nereden geldigini (cekirdek/tandril/serbest) bilmez - sadece
        // duz bir x/y/r listesi okur, bu yuzden yeni hareket modeliyle degismeden calisir.
        function alanDegerlendir() {
            var veri = alanVerisi.data;
            var idx = 0;

            for (var gy = 0; gy < GRID_H; gy++) {
                var py = (gy + 0.5) / GRID_H * alanH;
                for (var gx = 0; gx < GRID_W; gx++) {
                    var px = (gx + 0.5) / GRID_W * alanW;
                    var toplam = 0;

                    for (var n = 0; n < tumParcaciklar.length; n++) {
                        var nuk = tumParcaciklar[n];
                        var dx = px - nuk.x;
                        var dy = py - nuk.y;
                        toplam += (nuk.r * nuk.r) / (dx * dx + dy * dy + 1);
                    }

                    var t = (toplam - (ESIK - ESIK_YUMUSAKLIGI)) / (2 * ESIK_YUMUSAKLIGI);
                    t = t < 0 ? 0 : (t > 1 ? 1 : t);
                    var alfa = t * t * (3 - 2 * t);

                    veri[idx] = 255;
                    veri[idx + 1] = 255;
                    veri[idx + 2] = 255;
                    veri[idx + 3] = Math.round(alfa * 255);
                    idx += 4;
                }
            }

            kucukBaglam.putImageData(alanVerisi, 0, 0);
        }

        // 5) Tema: CSS degiskenlerini oku, tek bir gradyan olustur (nukleus basina renk YOK).
        function gradyanOlustur() {
            var stil = getComputedStyle(parlama);
            var renk1 = stil.getPropertyValue("--parlama-1").trim();
            var renk2 = stil.getPropertyValue("--parlama-2").trim();
            var renk3 = stil.getPropertyValue("--parlama-3").trim();

            var g = baglam.createLinearGradient(
                dolguX + alanW * 0.25, dolguY + alanH * 0.25,
                dolguX + alanW * 0.75, dolguY + alanH * 0.75);
            g.addColorStop(0, renk1);
            g.addColorStop(0.55, renk2);
            g.addColorStop(1, renk3);
            return g;
        }

        // Kucuk alan tuvalini (duzgun olceklenerek) gecici tam boy tuvale cizer,
        // gradyani "source-in" ile o maskenin icinden gecirir, sonra hedefe (ana tuvale)
        // AYRI, kendi icinde tutarli bir goruntu olarak bindirir - iki gecis birbirine karismaz.
        function pasoCiz(buyume, bulanikPx, alfa, gradyan) {
            geciciBaglam.clearRect(0, 0, geciciTuval.width, geciciTuval.height);
            geciciBaglam.save();
            if (bulanikPx > 0) {
                geciciBaglam.filter = "blur(" + bulanikPx + "px)";
            }
            geciciBaglam.drawImage(kucukTuval, 0, 0, GRID_W, GRID_H,
                dolguX - buyume / 2, dolguY - buyume / 2, alanW + buyume, alanH + buyume);
            geciciBaglam.filter = "none";
            geciciBaglam.globalCompositeOperation = "source-in";
            geciciBaglam.fillStyle = gradyan;
            geciciBaglam.fillRect(0, 0, canvas.width, canvas.height);
            geciciBaglam.restore();

            baglam.save();
            baglam.globalAlpha = alfa;
            baglam.drawImage(geciciTuval, 0, 0);
            baglam.restore();
        }

        // Su anki alan tuvalinin (kucukTuval) DONMUS bir kopyasini alir. Bu, bir yanki
        // olayinin kaynagi olan gercek siluettir - ayri, uydurulmus bir sekil degildir.
        function silvetSnapshotAl() {
            var t = document.createElement("canvas");
            t.width = GRID_W;
            t.height = GRID_H;
            t.getContext("2d").drawImage(kucukTuval, 0, 0);
            return t;
        }

        // Bir enerjik olay etrafinda 1-3 kontur yankisi katmani olusturur. Katmanlarin
        // hepsi AYNI donmus siluet anlik goruntusunu paylasir (tek bir bozulmadan yayilan
        // kisa bir dizi hissi versin diye); sadece olcek/kayma/bulaniklik/gecikme/opaklik
        // katman indeksine gore kademeli olarak artar/azalir. "yonX/yonY" normallestirilmis
        // bir yon vektorudur - genisleme bu yonde daha belirgin olur (bkz. yankilariCiz).
        function yankiOlustur(zamanMs, yonX, yonY, guc) {
            if (zamanMs < sonrakiYankiZamani) {
                return;
            }
            sonrakiYankiZamani = zamanMs + YANKI_SOGUMA_MS;

            guc = Math.max(0, Math.min(1, guc));
            var anlikGoruntu = silvetSnapshotAl();
            var katmanSayisi = guc > 0.65 ? 3 : (guc > 0.4 ? 2 : 1);

            for (var k = 0; k < katmanSayisi; k++) {
                yankilar.push({
                    tuval: anlikGoruntu,
                    baslangicZamani: zamanMs + k * (55 + Math.random() * 45),
                    omur: 420 + k * 110 + Math.random() * 220,
                    yonX: yonX, yonY: yonY,
                    olcekBitis: 1.2 + k * 0.16 + Math.random() * 0.12,
                    kaymaBitis: alanW * (0.05 + k * 0.045),
                    bulanikBitis: alanW * (0.018 + k * 0.014),
                    alfaBaslangic: (0.24 - k * 0.06) * (0.55 + guc * 0.45)
                });
            }
        }

        // Kontur yankilarini cizer: her katman, donmus siluet anlik goruntusunun olceklenip
        // (merkezden disariya) YONLU olarak kaydirilmis, giderek bulaniklastirilan ve solan
        // bir kopyasidir - ne dolu bir daire, ne de ortalanmis bir halka. Omru dolanlar
        // burada listeden temizlenir; ayrica yeni bir per-frame guncelleme dongusune gerek yoktur.
        function yankilariCiz(zamanMs) {
            if (!yankilar.length) {
                return;
            }

            var renk = getComputedStyle(parlama).getPropertyValue("--parlama-2").trim();
            var merkezX = dolguX + alanW / 2, merkezY = dolguY + alanH / 2;

            for (var i = yankilar.length - 1; i >= 0; i--) {
                var y = yankilar[i];
                var gecenSure = zamanMs - y.baslangicZamani;

                if (gecenSure >= y.omur) {
                    yankilar.splice(i, 1);
                    continue;
                }
                if (gecenSure < 0) {
                    continue; // katman gecikmesi henuz dolmadi
                }

                var t = gecenSure / y.omur;
                var yayilma = 1 - Math.pow(1 - t, 2); // hizli acilir, sonra yavaslar
                var olcek = 1 + (y.olcekBitis - 1) * yayilma;
                var kayma = y.kaymaBitis * yayilma;
                var bulanik = y.bulanikBitis * yayilma;
                var sonum = Math.pow(1 - t, 1.2);
                var alfa = y.alfaBaslangic * sonum;
                if (alfa <= 0.006) {
                    continue;
                }

                var genislik = alanW * olcek;
                var yukseklik = alanH * olcek;
                var hedefX = merkezX - genislik / 2 + y.yonX * kayma;
                var hedefY = merkezY - yukseklik / 2 + y.yonY * kayma;

                geciciBaglam.clearRect(0, 0, geciciTuval.width, geciciTuval.height);
                geciciBaglam.save();
                if (bulanik > 0.5) {
                    geciciBaglam.filter = "blur(" + bulanik + "px)";
                }
                geciciBaglam.drawImage(y.tuval, 0, 0, GRID_W, GRID_H, hedefX, hedefY, genislik, yukseklik);
                geciciBaglam.filter = "none";
                geciciBaglam.globalCompositeOperation = "source-in";
                geciciBaglam.fillStyle = renk;
                geciciBaglam.fillRect(0, 0, canvas.width, canvas.height);
                geciciBaglam.restore();

                baglam.save();
                baglam.globalAlpha = alfa;
                baglam.drawImage(geciciTuval, 0, 0);
                baglam.restore();
            }
        }

        // 6) Render: once kontur yankilari (varsa), sonra kucuk/basit bir parlama gecisi
        // (bulanik, dusuk alfa, hafifce buyutulmus), sonra tanimli ana govde - ikisi de
        // AYNI alan tuvalinden turetilir. Boylece yankilar govdenin ARKASINDAN yayilir.
        function sivyiCiz(zamanMs) {
            var gradyan = gradyanOlustur();
            baglam.clearRect(0, 0, canvas.width, canvas.height);
            yankilariCiz(zamanMs);
            pasoCiz(alanW * 0.08, Math.round(alanW * 0.03), 0.3, gradyan);
            pasoCiz(0, 0, 1, gradyan);
        }

        // 7) Ana dongu: gercek gecen zamana (dt) dayali fizik, #parlama gizliyken atlanir,
        // pahali alan/render adimi ~30fps'e sinirlanir, fizik ise her kare guncellenir.
        function dongu(zamanMs) {
            if (parlama.classList.contains("parlama-gizli")) {
                sonKareZamani = 0; // gorunur oldugunda dt sicramasi yasanmasin
                requestAnimationFrame(dongu);
                return;
            }

            var dt = sonKareZamani ? (zamanMs - sonKareZamani) / 1000 : 0;
            dt = Math.min(dt, 0.05);
            sonKareZamani = zamanMs;

            fizigiGuncelle(zamanMs, dt);

            if (zamanMs - sonAlanZamani >= ALAN_HEDEF_ARALIGI) {
                sonAlanZamani = zamanMs;
                alanDegerlendir();
                sivyiCiz(zamanMs);
            }

            requestAnimationFrame(dongu);
        }

        boyutlandir();
        window.addEventListener("resize", boyutlandir);
        parcaciklariBaslat();
        sonrakiUcImpulsu = performance.now() + 1500 + Math.random() * 2000;
        sonrakiVorteksKontrolu = performance.now() + 1200 + Math.random() * 1500;

        if (azaltilmisHareket) {
            // Tek, statik bir kare: surekli simulasyon calistirilmaz.
            fizigiGuncelle(performance.now(), 0);
            alanDegerlendir();
            sivyiCiz(performance.now());
        } else {
            requestAnimationFrame(dongu);
        }
    })();
</script>

<script>
    // GECICI TANI: temas noktasinda birakilan kucuk "enerji rezervi"
    // elemanini olusturur ve (0.55 -> 1 olcek, 0 -> 1 opaklik) yumusakca
    // belirmesini saglar - SONRA HICBIR SEKILDE gizlenmez/kaldirilmaz (bu
    // asama icin kalici kalmasi istendi). Renkler JS'te SABITLENMEZ - CSS
    // (.temas-enerjisi / [data-bs-theme=dark] .temas-enerjisi) tema-duyarli
    // --temas-1/--temas-2 degiskenlerini zaten tasir, bu yuzden burada
    // sadece konum/boyut/animasyon islenir.
    function temasEnerjisiOlustur(x, y, sure) {
        var el = document.createElement("span");
        el.className = "temas-enerjisi";
        el.setAttribute("aria-hidden", "true");
        el.style.left = x + "px";
        el.style.top = y + "px";
        document.body.appendChild(el);

        if (!el.animate) {
            el.style.opacity = "1";
            el.style.transform = "translate(-50%, -50%) scale(1)";
            return el;
        }

        el.animate(
            [
                { transform: "translate(-50%, -50%) scale(0.55)", opacity: 0 },
                { transform: "translate(-50%, -50%) scale(1)", opacity: 1 }
            ],
            { duration: sure, easing: "ease-out", fill: "forwards" }
        );
        return el;
    }

    // Buyuk merkezi Şey'i TEK, surekli bir WAAPI animasyonuyla (konum + olcek +
    // opaklik AYNI kare dizisinde) yukleme balonunun GERCEK yuvarlatilmis
    // yuzeyindeki EN YAKIN temas noktasina tasir; TEMAS ANINDA (pTemas =
    // seyahatSure) hem collapse baslar hem de AYNI anda cevre akisi
    // (cevreAkisiKur ile EN BASTA kurulmus akis nesnesi, yeniden
    // hesaplanmadan) tetiklenir - ikisi 160ms boyunca ORTUSUR. Akis, s0'dan
    // saat yonu + saat yonunun tersine IKI cephe (govde/iz BUYUR, "uc"
    // katmanlari daha parlak/HAREKETLI iki uc olarak govdenin onunde kosar)
    // balonun karsi noktasinda bulusur, hale (enerjiKatmaniniEkle/
    // enerjiyiCrossfadeEt) fillSuresi'nin son %20'sinde normal siddetine
    // ulasir, temas rezervi (temasEnerjisiOlustur) akisla senkron dogar ve
    // hizla soner, akis tamamlaninca (fillSuresi sonunda) rastgele tutamlar
    // (yaziyorTutamlariBaslat) baslar - hicbir ayri "final skin" katmani
    // eklenmez.
    function parlamayiBalonaTasi(parlama, hedefBalon, satir) {
        var azaltilmisHareket = window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        if (azaltilmisHareket) {
            // Hareketi azalt tercih edilmisse seyahat/temas/akis gorseli YOK -
            // dogrudan gizle, ama kabul edilmis SON DURUMA (kalici dis yuzey +
            // hale + tutam) yine de gec - reduced-motion kullanicisi sonsuza
            // kadar "cikri" bir yaziyor balonunda kalmasin.
            parlama.classList.add("parlama-gizli");
            balonuEtkinlestir(hedefBalon, satir);
            return;
        }

        var baslangic = parlama.getBoundingClientRect();
        var hedef = hedefBalon.getBoundingClientRect();

        var baslangicMerkezX = baslangic.left + baslangic.width / 2;
        var baslangicMerkezY = baslangic.top + baslangic.height / 2;
        var hedefMerkezX = hedef.left + hedef.width / 2;
        var hedefMerkezY = hedef.top + hedef.height / 2;

        // Disariya dogru birim normal: balon merkezinden, Şey'in GELDIGI yone.
        var yonX = baslangicMerkezX - hedefMerkezX;
        var yonY = baslangicMerkezY - hedefMerkezY;
        var yonUzunluk = Math.sqrt(yonX * yonX + yonY * yonY) || 1;
        yonX /= yonUzunluk;
        yonY /= yonUzunluk;

        // Balonun GERCEK yuvarlatilmis yuzeyindeki en yakin temas noktasi
        // (mevcut, sayisal getPointAtLength hesabi - DEGISMEDI). Cevre akis
        // SVG'si burada EN BASTA kurulur (henuz gorunmez - .yaziyor-akis-yol'un
        // dinlenme hali stroke-dasharray:0px 1px) ve ARTIK ERKEN KALDIRILMIYOR -
        // collapse bitince AYNI akis nesnesi (s0/temasX/temasY DAHIL) asagida
        // cevreAkisiCalistir'e verilecek. Boylece iki yonlu akisin baslangic
        // noktasi, Şey'in temas/collapse icin kullandigi noktayla PIKSEL PIKSEL
        // AYNI olur - ikinci bir hesaplama YOK, sicrama YOK.
        var akis = cevreAkisiKur(hedefBalon, hedef, yonX, yonY);

        // IDLE_GORUNUR_PX: #parlama 300x300px'lik bir sunum kutusu ama bu
        // kutunun BUYUK KISMI seffaf bosluktur - fiziksel olarak "govde"
        // sayilan tek sey merkezi cekirdektir (bkz. parcaciklariBaslat:
        // "cekirdek = parcacikOlustur(..., w * 0.17, 'cekirdek')", w=alanW,
        // alanW #parlama'nin clientWidth'ine (300px) 1:1 karsilik gelir -
        // devicePixelRatio hem fizik uzayina hem tuval CSS boyutuna ayni
        // oranda uygulandigi icin birbirini goturur). Yani idle/scale-1
        // durumunda GERCEKTEN goze carpan/"katı" govde capi yaklasik
        // 2 * 0.17 * 300 = 102px'tir - 300px DEGIL. Onceki hata BUNU
        // gormezden gelip dogrudan 300px'ten olcek turetmekti (30/300=0.10),
        // bu da cekirdegi ezip tandrilleri (ince flamalari) gorunmez
        // kilarak Şey'i "kucuk yuvarlak nokta"ya indirgiyordu.
        var IDLE_GORUNUR_PX = 2 * 0.17 * 300;

        // ONCEKI_TEMAS_OLCEGI: bir onceki tani asamasinin temas olcegi
        // (45px hedef / IDLE_GORUNUR_PX). YENI bir 300px/footprint olcum
        // sistemi ICAT EDILMEDI - MEVCUT bu olcek, asagida SADECE bir
        // carpanla kucultuluyor.
        var ONCEKI_HEDEF_GORUNUR_PX = 45;
        var ONCEKI_TEMAS_OLCEGI = ONCEKI_HEDEF_GORUNUR_PX / IDLE_GORUNUR_PX;

        // KUCULTME_ORANI: mevcut temas olcegini %55-65 araligina indirger -
        // muhafazakar/orta bir deger (0.60): hem "kucuk yuvarlak nokta"ya
        // donme riskini (asiri kucultme) hem yetersiz kucultme riskini
        // dengeler.
        var KUCULTME_ORANI = 0.60;
        var temasOlcegi = ONCEKI_TEMAS_OLCEGI * KUCULTME_ORANI;

        // govdeYaricapi(olcek): verilen olcekte GERCEKTEN gorunur yaricap
        // (IDLE_GORUNUR_PX ile AYNI oranti korunarak). Hem temas anindaki
        // hem de (daha kucuk) collapse yaricaplari icin kullanilir - govde
        // HANGI olcekte olursa olsun, balona-BAKAN kenari boylece HER ZAMAN
        // matematiksel olarak ayni temas noktasinda kalir (dx/dy = temasDx/Y
        // + yon * govdeYaricapi(olcek); kenar = merkez - yon*yaricap =
        // temas noktasi, SABIT - olcek ne olursa olsun sadelesir).
        function govdeYaricapi(olcek) {
            return IDLE_GORUNUR_PX * olcek / 2;
        }
        var temasYaricapi = govdeYaricapi(temasOlcegi);

        var temasDx = akis.temasX - baslangicMerkezX;
        var temasDy = akis.temasY - baslangicMerkezY;
        var dx = temasDx + yonX * temasYaricapi;
        var dy = temasDy + yonY * temasYaricapi;
        var mesafe = Math.sqrt(dx * dx + dy * dy);

        var seyahatSure = Math.max(650, Math.min(950, 650 + mesafe * 0.35));

        // Collapse: temastan HEMEN sonra baslayan, 130-190ms araliginda kisa
        // bir faz (160ms - araligin ortasi). toplamSure = seyahat + collapse;
        // pTemas, kare dizisindeki seyahat-fazi offsetlerini (0..pTemas) TEK,
        // surekli animasyonun toplam suresine gore yeniden olcekler.
        var collapseSure = 160;
        var toplamSure = seyahatSure + collapseSure;
        var pTemas = seyahatSure / toplamSure;

        // Teget yonu: rotate(tegetAci) scale(sx,sy) rotate(-tegetAci) deseni
        // icin - bu rotasyondan SONRA sy ekseni disariya-dogru normal (yon)
        // ile hizalanir (asagidaki govdeYaricapi cagrilari HEP sy'ye gore
        // hesaplanir). Onceden kabul edilmis AYNI formul - collapse fazinda
        // yeniden kullanildi, yeniden icat edilmedi.
        var tegetAci = Math.atan2(yonX, -yonY) * 180 / Math.PI;

        // Collapse karesi (orta): govde balona-BAKAN NOKTAYA dogru "tutunumu
        // kaybetmeye" baslar - normal eksen (sy) teget eksenden (sx) daha
        // hizli kucculur, opaklik dusmeye baslar. Ikisi de temasOlcegi'nin
        // ALTINDA kalir (asla buyumez, uzun oval olmaz).
        var syOrta = temasOlcegi * 0.55;
        var sxOrta = temasOlcegi * 0.85;
        var dxOrta = temasDx + yonX * govdeYaricapi(syOrta);
        var dyOrta = temasDy + yonY * govdeYaricapi(syOrta);

        // Collapse karesi (son): govde neredeyse tamamen temas noktasina
        // gomulur (derin normal-eksen sikismasi) ve opaklik 0'a duser.
        var sySon = temasOlcegi * 0.12;
        var sxSon = temasOlcegi * 0.35;
        var dxSon = temasDx + yonX * govdeYaricapi(sySon);
        var dySon = temasDy + yonY * govdeYaricapi(sySon);

        parlama.classList.remove("parlama-gizli");

        // Once, gorunen konumuyla BIREBIR ayni noktaya sabitleyerek absolute'tan
        // fixed'e gec (koordinat sistemi degismez, sicrama olmaz).
        parlama.style.transition = "none";
        parlama.style.position = "fixed";
        parlama.style.top = baslangicMerkezY + "px";
        parlama.style.left = baslangicMerkezX + "px";
        parlama.style.zIndex = "3";

        // 1 -> temasOlcegi arasinda yumusak kuculme (seyahat fazi, DEGISMEDI -
        // sadece offsetleri pTemas ile yeniden olceklendi).
        function olcekAra(f) {
            return 1 - (1 - temasOlcegi) * f;
        }

        var kareler = [
            { transform: "translate(-50%, -50%) translate(0px, 0px) scale(1, 1)", opacity: 1, offset: 0 },
            { transform: "translate(-50%, -50%) translate(" + (dx * 0.5) + "px, " + (dy * 0.5) + "px) scale(" + olcekAra(0.5) + ", " + olcekAra(0.5) + ")", opacity: 1, offset: pTemas * 0.5 },
            { transform: "translate(-50%, -50%) translate(" + (dx * 0.88) + "px, " + (dy * 0.88) + "px) scale(" + olcekAra(0.88) + ", " + olcekAra(0.88) + ")", opacity: 1, offset: pTemas * 0.88 },
            { transform: "translate(-50%, -50%) translate(" + dx + "px, " + dy + "px) scale(" + temasOlcegi + ", " + temasOlcegi + ")", opacity: 1, offset: pTemas },
            { transform: "translate(-50%, -50%) translate(" + dxOrta + "px, " + dyOrta + "px) rotate(" + tegetAci + "deg) scale(" + sxOrta + ", " + syOrta + ") rotate(" + (-tegetAci) + "deg)", opacity: 0.4, offset: pTemas + (1 - pTemas) * 0.55 },
            { transform: "translate(-50%, -50%) translate(" + dxSon + "px, " + dySon + "px) rotate(" + tegetAci + "deg) scale(" + sxSon + ", " + sySon + ") rotate(" + (-tegetAci) + "deg)", opacity: 0, offset: 1 }
        ];

        // Seyahat + temas + KISA collapse TEK bir WAAPI animasyonunda oynar
        // (fill:"forwards" son kareyi - opacity 0, temas noktasina gomulu
        // govde - kalici tutar). toplamSure aninda Şey'in animasyonu biter;
        // asagidaki cevre-akisi/hale/rezerv-sonumu de AYNI ana (toplamSure)
        // gore zamanlanir - bu YUZDEN "collapse biter bitmez" akis baslar.
        // Gercek POST navigasyonu (form submit zaten engellenmiyor) sayfayi
        // normal sekilde degistirecek; burada yapay bir gecikme eklenmedi.
        parlama.animate(kareler, {
            duration: toplamSure,
            easing: "cubic-bezier(0.33, 0, 0.2, 1)",
            fill: "forwards"
        });

        // fillSuresi (650-850ms hedefinin ortasina yakin) - cevre yuzeyinin
        // %0'dan %100'e dolma suresi. DEGISMEDI.
        var fillSuresi = 750;

        // Akis, toplamSure (collapse BITISI) yerine seyahatSure'de (Şey'in
        // balona GERCEKTEN degdigi an - kareler dizisindeki pTemas offset'i)
        // baslar. Collapse (pTemas..1 arasi, 160ms) akisin ilk 160ms'siyle
        // ORTUSUR - Şey collapse olurken cepheler ZATEN ayrilmaya baslamis
        // olur. Collapse'in kendi suresi/geometrisi/transform'lari DEGISMEDI.
        setTimeout(function () {
            // Griyi tasiyan zemin (.yaziyor-arkaplan) + --yuzey-1/2 renk
            // degiskenlerini acan .sonraki-hale sinifi BURADA, akis
            // baslamadan HEMEN once devreye girer - .yaziyor-akis-cw/ccw'nin
            // stroke rengi (rgba(var(--yuzey-1),...)) BU SINIF OLMADAN
            // GECERSIZDIR. .yaziyor-yuzey EKLENMEZ - ilk mesajda kalici dis
            // yuzey rolunu artik asagida buyuyen SVG'nin KENDISI ustlenir.
            // Renkler/gorunum ONCEKI (balon-cevap) ile BIREBIR AYNI
            // oldugundan bu gecis GORSEL OLARAK SESSIZDIR.
            ilkMesajZeminEtkinlestir(hedefBalon, satir);

            // Hale (.yaziyor-parlak/.yaziyor-tutam): akisin ILK ~%80'INDE HIC
            // EKLENMEZ (tamamen etkisiz/yok) - cevre insasi izlenirken genel
            // bir mor pus balonun tamamini KAPLAMAZ. Akisin SON %20'sinde
            // eklenip carprazlanir, akis tamamlandigi anda kabul edilmis
            // normal siddetine ulasir. Fonksiyonlarin KENDISI DEGISMEDI
            // (enerjiKatmaniniEkle/enerjiyiCrossfadeEt).
            setTimeout(function () {
                var enerji = enerjiKatmaniniEkle(hedefBalon);
                enerjiyiCrossfadeEt(enerji, Math.round(fillSuresi * 0.20));
            }, Math.round(fillSuresi * 0.80));

            // Temas rezervi akisla TAM AYNI anda (senkron) olusturulur -
            // cepheler ayrilir ayrilmaz rezerv hemen sonmeye baslar (kisa bir
            // "el degistirme" - uzun sureli yuvarlak mor nokta YOK). Kendi
            // fade-in'i (collapseSure*0.5) ile beliriyor, HEMEN ardindan
            // asagidaki sonme animasyonu (%15'te ~0.30, %32'de 0) UZERINE
            // biner - ikisinin baslangic degeri (opacity:1) AYNI oldugundan
            // gorsel sicrama olmaz.
            var temasEnerjisiEl = temasEnerjisiOlustur(akis.temasX, akis.temasY, Math.round(collapseSure * 0.5));
            if (temasEnerjisiEl && temasEnerjisiEl.animate) {
                temasEnerjisiEl.animate(
                    [
                        { opacity: 1, offset: 0 },
                        { opacity: 0.3, offset: 0.15 },
                        { opacity: 0, offset: 0.32 },
                        { opacity: 0, offset: 1 }
                    ],
                    { duration: fillSuresi, easing: "ease-in", fill: "forwards" }
                );
            }

            // Iki yonlu, KALICI cevre yuzeyi (cwYol/ccwYol - asagida
            // cevreAkisiCalistir) - AYNI s0'dan baslar, s0 + uzunluk/2'de
            // geometrik olarak KESIN bulusur ve BUYUYEN GEOMETRININ KENDISI
            // (SVG hicbir zaman kaldirilmadan/degistirilmeden) ilk mesajin
            // kalici dis derisi olarak kalir. Tamamlaninca SADECE rastgele
            // tutam zamanlayicisi baslar - kabul edilmis
            // yaziyorTutamlariBaslat, DEGISMEDI - baska hicbir katman/switch
            // eklenmez.
            cevreAkisiCalistir(akis, fillSuresi, function () {
                var tutamDurdur = yaziyorTutamlariBaslat(hedefBalon);
                window.addEventListener("pagehide", tutamDurdur, { once: true });
            });
        }, Math.round(seyahatSure));
    }

    // GECICI TANI DEGIL - ilk mesaj icin KALICI: griyi tasiyan zemini
    // (.yaziyor-arkaplan) ve --yuzey-1/2 renk degiskenlerini acan
    // .sonraki-hale sinifini etkinlestirir - balonuEtkinlestir'in AKSINE
    // .yaziyor-yuzey EKLEMEZ (ilk mesajda o rolu buyuyen cevre-akis SVG'si
    // ustlenir - bkz. yukaridaki parlamayiBalonaTasi). Guvenlik agi: zemin
    // zaten varsa (ikinci cagri) hicbir sey yapmaz.
    function ilkMesajZeminEtkinlestir(balon, satir) {
        if (balon.querySelector(".yaziyor-arkaplan")) {
            return;
        }
        balon.classList.add("sonraki-hale");
        if (satir) {
            satir.classList.add("sonraki-hale");
        }
        balon.insertAdjacentHTML("afterbegin", '<span class="yaziyor-arkaplan" aria-hidden="true"></span>');
    }

    // Balonun GERCEK yuvarlatilmis silueti icin gecici bir SVG izleyici kurar ve
    // verilen (yonX,yonY) disa-dogru yonune EN UZAK (yani Şey'in geldigi tarafa
    // en yakin) sinir noktasini, SVG'nin kendi getPointAtLength'i ile SAYISAL
    // olarak orneklem alarak bulur - elle yazilmis kose/kenar geometrisi
    // formullerine gerek yok, tarayicinin kendi dogru yol hesaplamasina guvenilir.
    // DORT AYNI geometrili <rect> olusturulur: iki "govde/iz" (yol) + iki "uc"
    // (parlak, hareketli baslik) - hepsi cevreAkisiCalistir tarafindan yeniden
    // kullanilir (yeniden olusturulmaz).
    function cevreAkisiKur(balon, dikdortgen, yonX, yonY) {
        var w = dikdortgen.width, h = dikdortgen.height;
        var r = parseFloat(getComputedStyle(balon).borderTopLeftRadius) || 0;
        r = Math.max(0, Math.min(r, w / 2 - 1, h / 2 - 1));
        var gecOznitelik = 'x="1.5" y="1.5" width="' + Math.max(0, w - 3) +
            '" height="' + Math.max(0, h - 3) + '" rx="' + r + '" ry="' + r + '"';

        balon.insertAdjacentHTML("afterbegin",
            '<svg class="yaziyor-akis" aria-hidden="true" width="' + w + '" height="' + h +
            '" viewBox="0 0 ' + w + ' ' + h + '">' +
            '<rect class="yaziyor-akis-yol yaziyor-akis-ccw" ' + gecOznitelik + '></rect>' +
            '<rect class="yaziyor-akis-yol yaziyor-akis-cw" ' + gecOznitelik + '></rect>' +
            '<rect class="yaziyor-akis-uc yaziyor-akis-uc-ccw" ' + gecOznitelik + '></rect>' +
            '<rect class="yaziyor-akis-uc yaziyor-akis-uc-cw" ' + gecOznitelik + '></rect>' +
            '</svg>');

        var svg = balon.querySelector(".yaziyor-akis");
        var cwYol = balon.querySelector(".yaziyor-akis-cw");
        var ccwYol = balon.querySelector(".yaziyor-akis-ccw");
        var cwUc = balon.querySelector(".yaziyor-akis-uc-cw");
        var ccwUc = balon.querySelector(".yaziyor-akis-uc-ccw");
        var uzunluk = cwYol.getTotalLength ? cwYol.getTotalLength() : 0;

        var merkezX = w / 2, merkezY = h / 2;
        var enIyiS = 0, enIyiDeger = -Infinity, enIyiNokta = { x: w, y: h / 2 };
        var ORNEK = 96;
        for (var i = 0; i < ORNEK && uzunluk > 0; i++) {
            var s = (i / ORNEK) * uzunluk;
            var p = cwYol.getPointAtLength(s);
            var deger = (p.x - merkezX) * yonX + (p.y - merkezY) * yonY;
            if (deger > enIyiDeger) {
                enIyiDeger = deger;
                enIyiS = s;
                enIyiNokta = p;
            }
        }

        return {
            svg: svg,
            cwYol: cwYol,
            ccwYol: ccwYol,
            cwUc: cwUc,
            ccwUc: ccwUc,
            uzunluk: uzunluk,
            s0: enIyiS,
            temasX: dikdortgen.left + enIyiNokta.x,
            temasY: dikdortgen.top + enIyiNokta.y
        };
    }

    // Temas noktasindan IKI yonde (saat yonu / saat yonunun tersine) esit hizda
    // buyuyen iki stroke-dasharray/-dashoffset animasyonu baslatir (govde/iz).
    // cwYol ve ccwYol GEOMETRIK OLARAK OZDES kapali bir yolu paylastigi icin,
    // ikisinin de YARISINI (uzunluk/2) cizmesi otomatik olarak TAM CEVREYI
    // kapatir ve iki cephe, ayrica hesaplanmasi gerekmeyen, geometrik olarak
    // KESIN karsi noktada (s0 + uzunluk/2) bulusur.
    //
    // MIMARI: bu SVG GECICI BIR IZLEYICI DEGIL. cwYol/ccwYol (govde/iz)
    // HICBIR ZAMAN kaldirilmaz/degistirilmez - %0'dan %100'e buyuyen bu IKI
    // rect'in KENDISI, ilk mesajin KALICI dis derisi olarak kalir - sadece
    // dasharray UZUNLUGU degisir, gercekten TEMAS NOKTASINDAN DISA DOGRU
    // BUYUYEN bir geometri.
    //
    // Govde/iz'in KENDI stroke rengi (CSS'teki rgba(var(--yuzey-1/2), 0.55))
    // SABIT kalir; element opacity'si TAZE_ORAN (~%35) boyunca 1'de kalip,
    // sonra DINGINLESME_OPAKLIGI'na kadar yumusakca duser - akis
    // TAMAMLANDIGINDA govde/iz CSS'teki 0.55 alfanin altina "sogur" ve
    // .yaziyor-yuzey'in ince/kisitli gorunumune yaklasir. AYNI iki
    // geometriden turetilen KISA, daha parlak "uc" segmentleri (cwUc/ccwUc)
    // govdenin o anki HAREKETLI ucunu takip eder (DASHOFFSET SABIT/degisken
    // formullerinden matematiksel olarak turetildi) - bunlar TAZE_ORAN
    // boyunca gecici olarak daha genis (UC_PARLAMA_GENISLIK) cizilip normal
    // genisligine (UC_NORMAL_GENISLIK) daralir, akis tamamlanmadan hemen
    // once SONER (opacity 1->0, son %15) - bu, IKI GORUNUR, HAREKETLI parlak
    // uc noktasi olarak balonun cevresinde CW/CCW dolanir. tamamlaninca geri
    // cagirisi (SADECE rastgele tutam zamanlayicisini baslatir) akis SURESI
    // dolunca calisir; SVG'ye/DOM'a BASKA HICBIR SEKILDE dokunulmaz.
    function cevreAkisiCalistir(akis, sure, tamamlaninca) {
        sure = sure || 750; // 650-850ms araliginda

        // TAZE_ORAN: akisin ilk ~%35'i - hem govde/iz'in "taze" (opacity 1)
        // kaldigi, hem "uc"un gecici olarak genisledigi pencere.
        var TAZE_ORAN = 0.35;
        // DINGINLESME_OPAKLIGI: TAZE_ORAN'dan sonra govde/iz'in element
        // opacity'sinin sondugu carpan - CSS'teki 0.55 alfa ile carpilinca
        // nihai/dinlenme gorunumu .yaziyor-yuzey'in kisitli yogunluguna
        // yaklasir.
        var DINGINLESME_OPAKLIGI = 0.55;

        if (!akis.uzunluk || !akis.cwYol.animate) {
            // WAAPI/getTotalLength desteklenmiyorsa: govde/iz'i dogrudan
            // %100 dolu STATIK duruma getir (CSS ile) - boylece "kalici deri"
            // hala doğru gorunur, sadece animasyonsuz belirir.
            if (akis.uzunluk) {
                var Lf = akis.uzunluk, s0f = akis.s0;
                akis.cwYol.style.strokeDasharray = (Lf / 2) + "px " + (Lf / 2) + "px";
                akis.cwYol.style.strokeDashoffset = (-s0f) + "px";
                akis.cwYol.style.opacity = DINGINLESME_OPAKLIGI;
                akis.ccwYol.style.strokeDasharray = (Lf / 2) + "px " + (Lf / 2) + "px";
                akis.ccwYol.style.strokeDashoffset = (Lf / 2 - s0f) + "px";
                akis.ccwYol.style.opacity = DINGINLESME_OPAKLIGI;
            }
            if (tamamlaninca) {
                tamamlaninca();
            }
            return;
        }

        var L = akis.uzunluk, s0 = akis.s0;

        // "Uc" segment uzunlugu: cevrenin ~%6'si, 6-...px arasinda sikistirilmis -
        // kisa/tanidik bir "baslik", asla bir nokta/parcacik gibi gorunmeyecek
        // kadar uzun degil.
        var ucUzunlugu = Math.max(6, Math.min(L / 6, L * 0.06));
        var UC_PARLAMA_GENISLIK = 6.5; // TAZE_ORAN boyunca gecici "canlanma" genisligi
        var UC_NORMAL_GENISLIK = 4.5;  // CSS'teki .yaziyor-akis-uc stroke-width ile AYNI

        akis.cwYol.animate(
            [
                { strokeDasharray: "0px " + L + "px", strokeDashoffset: (-s0) + "px", opacity: 1, offset: 0 },
                { strokeDasharray: (TAZE_ORAN * L / 2) + "px " + (L - TAZE_ORAN * L / 2) + "px", strokeDashoffset: (-s0) + "px", opacity: 1, offset: TAZE_ORAN },
                { strokeDasharray: (L / 2) + "px " + (L / 2) + "px", strokeDashoffset: (-s0) + "px", opacity: DINGINLESME_OPAKLIGI, offset: 1 }
            ],
            { duration: sure, easing: "ease-out", fill: "forwards" }
        );

        akis.ccwYol.animate(
            [
                { strokeDasharray: "0px " + L + "px", strokeDashoffset: (-s0) + "px", opacity: 1, offset: 0 },
                { strokeDasharray: (TAZE_ORAN * L / 2) + "px " + (L - TAZE_ORAN * L / 2) + "px", strokeDashoffset: (-s0 + TAZE_ORAN * L / 2) + "px", opacity: 1, offset: TAZE_ORAN },
                { strokeDasharray: (L / 2) + "px " + (L / 2) + "px", strokeDashoffset: (L / 2 - s0) + "px", opacity: DINGINLESME_OPAKLIGI, offset: 1 }
            ],
            { duration: sure, easing: "ease-out", fill: "forwards" }
        );

        // "Uc" katmanlari: dasharray SABIT (ucUzunlugu), dashoffset govde ile
        // AYNI matematikten turetilir (senkron kalir). strokeWidth TAZE_ORAN
        // boyunca UC_PARLAMA_GENISLIK'ten UC_NORMAL_GENISLIK'e daralir. Son
        // %15'te opacity 1 -> 0 sonerek ucun kendisi de govdeyle AYNI anda
        // "dinlenme" derisine karisir - bulusma noktasinda kalici parlak bir
        // iz KALMAZ.
        akis.cwUc.style.strokeDasharray = ucUzunlugu + "px " + (L - ucUzunlugu) + "px";
        akis.cwUc.animate(
            [
                { strokeDashoffset: (ucUzunlugu - s0) + "px", strokeWidth: UC_PARLAMA_GENISLIK, opacity: 1, offset: 0 },
                { strokeDashoffset: (ucUzunlugu - s0 - L / 2 * TAZE_ORAN) + "px", strokeWidth: UC_NORMAL_GENISLIK, opacity: 1, offset: TAZE_ORAN },
                { strokeDashoffset: (ucUzunlugu - s0 - L / 2 * 0.85) + "px", strokeWidth: UC_NORMAL_GENISLIK, opacity: 1, offset: 0.85 },
                { strokeDashoffset: (ucUzunlugu - s0 - L / 2) + "px", strokeWidth: UC_NORMAL_GENISLIK, opacity: 0, offset: 1 }
            ],
            { duration: sure, easing: "ease-out", fill: "forwards" }
        );

        akis.ccwUc.style.strokeDasharray = ucUzunlugu + "px " + (L - ucUzunlugu) + "px";
        akis.ccwUc.animate(
            [
                { strokeDashoffset: (-s0) + "px", strokeWidth: UC_PARLAMA_GENISLIK, opacity: 1, offset: 0 },
                { strokeDashoffset: (L / 2 * TAZE_ORAN - s0) + "px", strokeWidth: UC_NORMAL_GENISLIK, opacity: 1, offset: TAZE_ORAN },
                { strokeDashoffset: (L / 2 * 0.85 - s0) + "px", strokeWidth: UC_NORMAL_GENISLIK, opacity: 1, offset: 0.85 },
                { strokeDashoffset: (L / 2 - s0) + "px", strokeWidth: UC_NORMAL_GENISLIK, opacity: 0, offset: 1 }
            ],
            { duration: sure, easing: "ease-out", fill: "forwards" }
        );

        // Iki cephe (geometrik olarak KESIN) burada, s0 + uzunluk/2 noktasinda
        // bulusmus olur. SVG'ye/govde-iz'e HICBIR SEKILDE dokunulmaz (fade
        // YOK, kaldirma YOK, degistirme YOK) - sadece cagirana haber verilir
        // (SADECE rastgele tutam zamanlayicisini baslatir, bkz. cagiran).
        setTimeout(function () {
            if (tamamlaninca) {
                tamamlaninca();
            }
        }, sure);
    }

    // (Duzeltme) .yaziyor-parlak/.yaziyor-tutam'i (KENDI opacity/transform'u
    // zaten parlakSuzulme/tutam olaylariyla surekli degistigi icin) crossfade
    // edilebilecek ayri bir sarmalayicinin (.yaziyor-enerji) icine ekler. SADECE
    // bu ikisi sarmalayici icindedir - .yaziyor-yuzey ARTIK BURAYA EKLENMEZ (bkz.
    // balonuEtkinlestir'deki duzeltme notu). Balon basina yalnizca BIR kez
    // eklenir (guvenlik agi). Cagiran, dondurulen elemanin crossfade'ini AYRICA
    // (enerjiyiCrossfadeEt ile) baslatmalidir - boylece Asama 3 akisinin, hale'yi
    // Şey'in seyahati SIRASINDA degil, temastan SONRA baslatmasina izin verilir.
    function enerjiKatmaniniEkle(balon) {
        var mevcut = balon.querySelector(".yaziyor-enerji");
        if (mevcut) {
            return mevcut;
        }
        balon.insertAdjacentHTML("afterbegin",
            '<span class="yaziyor-enerji" aria-hidden="true">' +
                '<span class="yaziyor-parlak"></span>' +
                '<span class="yaziyor-tutam"></span>' +
                '<span class="yaziyor-tutam"></span>' +
                '<span class="yaziyor-tutam"></span>' +
            '</span>');
        return balon.querySelector(".yaziyor-enerji");
    }

    function enerjiyiCrossfadeEt(enerji, sure) {
        if (!enerji) {
            return;
        }
        var azaltilmisHareket = window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (azaltilmisHareket) {
            enerji.style.opacity = "1";
        } else {
            enerji.animate(
                [{ opacity: 0 }, { opacity: 1 }],
                { duration: sure || 650, easing: "ease", fill: "forwards" }
            );
        }
    }

    // Yukleme balonunu Asama 1A/1C ile AYNI hale+tutam+yuzey sistemiyle
    // etkinlestirir - sonraki mesajlarin kullandigi TAM AYNI CSS siniflari ve
    // TAM AYNI JS fonksiyonu (yaziyorTutamlariBaslat) burada da kullanilir, ayri
    // bir kopya YOK.
    //
    // (Duzeltme - kare/dortgen hale hatasi) .yaziyor-yuzey artik .yaziyor-enerji
    // SARMALAYICISININ ICINE eklenmiyor. Nedeni: .yaziyor-yuzey'in
    // "border-radius: inherit" kurali KENDI EBEVEYNININ hesaplanmis degerini
    // alir. Sonraki mesajlarda .yaziyor-yuzey .yaziyor-balonu'nun DOGRUDAN
    // cocugudur, bu yuzden 1.25rem'i dogru miras alir. Ama .yaziyor-enerji'nin
    // KENDI border-radius'u YOK (bu ozellik miras alinmaz, baslangic degeri 0'dir)
    // - .yaziyor-yuzey o sarmalayicinin icine konunca "inherit" 0 aliyordu, bu da
    // kare/dortgen goruntuye yol aciyordu. Cozum: burada da .yaziyor-yuzey,
    // sonraki-mesaj yapisiyla BIREBIR ayni sekilde .yaziyor-balonu'nun DOGRUDAN
    // cocugu olarak eklenir (.yaziyor-enerji'nin DISINDA, kardes olarak).
    // .yaziyor-yuzey'in KENDI gorsel degerleri (box-shadow vb.) DEGISMEDI.
    //
    // Griyi tasiyan .yaziyor-arkaplan katmani, balonun kendi seffaflasan arka
    // planiyla AYNI senkron adimda degistigi icin (Asama 1'den beri kanitlanmis
    // teknik) gorsel bir sicrama olmaz.
    function balonuEtkinlestir(balon, satir) {
        if (balon.querySelector(".yaziyor-arkaplan")) {
            return; // zaten etkinlestirilmis (guvenlik agi ikinci kez tetiklenirse)
        }

        balon.classList.add("sonraki-hale");
        if (satir) {
            satir.classList.add("sonraki-hale");
        }

        var enerjiZatenVardi = !!balon.querySelector(".yaziyor-enerji");
        var enerji = enerjiKatmaniniEkle(balon);
        if (!enerjiZatenVardi) {
            // Buraya sadece azaltilmis-hareket guvenlik yolundan (Şey seyahati
            // hic calismadan) ulasildiysa girilir - normal Asama 3 akisinda
            // enerji katmani ve carprazlamasi ZATEN temastan hemen sonra
            // baslatilmis olur (bkz. parlamayiBalonaTasi -> temasAni).
            enerjiyiCrossfadeEt(enerji, 650);
        }

        // .yaziyor-yuzey (kalici dis yuzey) DOGRUDAN balonun cocugu olarak
        // eklenir - .yaziyor-enerji'nin DISINDA (yukaridaki duzeltme notuna bkz.).
        balon.insertAdjacentHTML("afterbegin",
            '<span class="yaziyor-yuzey" aria-hidden="true"></span>' +
            '<span class="yaziyor-arkaplan" aria-hidden="true"></span>');

        var tutamDurdur = yaziyorTutamlariBaslat(balon);
        window.addEventListener("pagehide", tutamDurdur, { once: true });
    }

    // Asama 1C: sonraki mesaj yukleme balonu icin rastgele plazma tutam olaylari.
    // Sabit @@keyframes YOK - her olay, uc yeniden-kullanilabilir #yaziyor-tutam
    // elemanindan BOSTA olan birini secip Element.animate() ile TAMAMEN
    // rastgelestirilmis bir kare dizisiyle canlandirir, sonra elemani havuza
    // iade eder. Yeni bir requestAnimationFrame dongusu YOK - zamanlama, her
    // olaydan sonra kendini yeniden kuran ozyineli bir setTimeout ile yapilir
    // (canvas/#parlama motoru burada hic devrede degil).
    function yaziyorTutamlariBaslat(balon) {
        var tutamlar = balon.querySelectorAll(".yaziyor-tutam");
        if (!tutamlar.length || !tutamlar[0].animate) {
            return function () {};
        }

        var azaltilmisHareket = window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (azaltilmisHareket) {
            return function () {};
        }

        var havuz = Array.prototype.map.call(tutamlar, function (el) {
            return { el: el, mesgul: false };
        });

        // Balonun cevresinde 6 organik bolge - her biri kendi "disa dogru" aci
        // merkezine (0=sag, 90=asagi, 180=sol, 270/-90=yukari) ve balonun kendi
        // kutusuna gore yaklasik bir baslangic konumuna (%) sahip. Tam dortluk
        // (yalnizca yukarı/sag/asagi/sol) kasitli olarak KULLANILMADI.
        var BOLGELER = [
            { ad: "sag-ust", aci: -50, sol: [68, 90], ust: [-6, 20] },
            { ad: "sag", aci: 0, sol: [90, 104], ust: [30, 68] },
            { ad: "sag-alt", aci: 55, sol: [68, 90], ust: [76, 102] },
            { ad: "sol-alt", aci: 125, sol: [8, 30], ust: [76, 102] },
            { ad: "sol", aci: 180, sol: [-6, 8], ust: [30, 68] },
            { ad: "sol-ust", aci: 235, sol: [8, 30], ust: [-6, 20] }
        ];

        var sonBolgeAdi = null;
        var zamanlayiciId = null;
        var durduruldu = false;

        function rastgele(min, max) {
            return min + Math.random() * (max - min);
        }

        function bolgeSec() {
            var adaylar = BOLGELER.filter(function (b) { return b.ad !== sonBolgeAdi; });
            var havuzSecim = adaylar.length ? adaylar : BOLGELER;
            return havuzSecim[Math.floor(Math.random() * havuzSecim.length)];
        }

        function bosSlotBul() {
            for (var i = 0; i < havuz.length; i++) {
                if (!havuz[i].mesgul) {
                    return havuz[i];
                }
            }
            return null;
        }

        // Tek bir rastgele tutam olayi: konum/boyut/gradyan JS'ten dogrudan
        // stil olarak yazilir (statik), yalnizca transform/opacity Element.animate()
        // ile canlandirilir. Kok (baslangic konumu + gradyanin guclu ucu) SABIT
        // kalir; sadece disa tasan UC buyuyup/kucularak "uzanma" hissi verir -
        // boylece hicbir zaman balondan kopup giden bir parcacik gibi gorunmez.
        function birOlayCalistir() {
            var slot = bosSlotBul();
            if (!slot) {
                return; // uc tutam da mesgul - bu turu atla, sonraki zamanlanmis denemeye birak
            }

            var bolge = bolgeSec();
            sonBolgeAdi = bolge.ad;

            var el = slot.el;
            var stil = getComputedStyle(el);
            var renk1 = stil.getPropertyValue("--tutam-1").trim();
            var renk2 = stil.getPropertyValue("--tutam-2").trim();

            var solYuzde = rastgele(bolge.sol[0], bolge.sol[1]);
            var ustYuzde = rastgele(bolge.ust[0], bolge.ust[1]);
            var aciSon = (bolge.aci + rastgele(-18, 18)) * Math.PI / 180;
            var aciOrta = (bolge.aci + rastgele(-30, 30)) * Math.PI / 180;

            var uzunluk = rastgele(8, 22);
            var ortaUzunluk = uzunluk * rastgele(0.55, 0.72);

            var dxSon = Math.cos(aciSon) * uzunluk;
            var dySon = Math.sin(aciSon) * uzunluk;
            var dxOrta = Math.cos(aciOrta) * ortaUzunluk;
            var dyOrta = Math.sin(aciOrta) * ortaUzunluk;

            var kokX = rastgele(10, 24);
            var kokY = 50 + rastgele(-12, 12);
            var karisim = rastgele(26, 46);
            var sonum = rastgele(64, 78);

            el.style.left = solYuzde + "%";
            el.style.top = ustYuzde + "%";
            el.style.width = rastgele(16, 32) + "px";
            el.style.height = rastgele(8, 18) + "px";
            el.style.transformOrigin = kokX + "% " + kokY + "%";
            el.style.background =
                "radial-gradient(ellipse at " + kokX + "% " + kokY + "%, " +
                renk1 + " 0%, " + renk2 + " " + karisim + "%, transparent " + sonum + "%)";

            var donusOrta = rastgele(-16, 16);
            var donusSon = donusOrta + rastgele(-10, 10);
            var tepeOpaklik = rastgele(0.3, 0.62);

            var kareler = [
                { transform: "translate(0px, 0px) rotate(0deg) scale(0.5, 0.6)", opacity: 0 },
                {
                    transform: "translate(" + (dxOrta * 0.5) + "px, " + (dyOrta * 0.5) + "px) rotate(" +
                        (donusOrta * 0.4) + "deg) scale(" + rastgele(0.85, 1.05) + ", " + rastgele(0.55, 0.75) + ")",
                    opacity: tepeOpaklik * 0.7,
                    offset: 0.3
                },
                {
                    transform: "translate(" + dxOrta + "px, " + dyOrta + "px) rotate(" + donusOrta +
                        "deg) scale(" + rastgele(1.05, 1.3) + ", " + rastgele(0.5, 0.68) + ")",
                    opacity: tepeOpaklik,
                    offset: 0.55
                },
                {
                    transform: "translate(" + dxSon + "px, " + dySon + "px) rotate(" + donusSon +
                        "deg) scale(" + rastgele(0.55, 0.75) + ", " + rastgele(0.4, 0.55) + ")",
                    opacity: 0
                }
            ];

            slot.mesgul = true;
            var animasyon = el.animate(kareler, {
                duration: rastgele(700, 1600),
                easing: "ease-in-out",
                fill: "none"
            });

            function serbestBirak() {
                slot.mesgul = false;
                el.style.opacity = "0";
            }
            animasyon.onfinish = serbestBirak;
            animasyon.oncancel = serbestBirak;
        }

        function sonrakiZamanlayiciyiKur() {
            if (durduruldu) {
                return;
            }
            zamanlayiciId = setTimeout(function () {
                birOlayCalistir();
                sonrakiZamanlayiciyiKur();
            }, rastgele(350, 1800));
        }

        sonrakiZamanlayiciyiKur();

        return function durdur() {
            durduruldu = true;
            if (zamanlayiciId) {
                clearTimeout(zamanlayiciId);
            }
        };
    }

    document.getElementById("soru-formu").addEventListener("submit", function () {
        var selamlama = document.getElementById("selamlama");
        var ilkMesajMi = !!selamlama;
        if (selamlama) {
            selamlama.style.display = "none";
        }

        var dugme = document.getElementById("sor-dugmesi");
        dugme.disabled = true;
        dugme.textContent = "Bekleyin...";

        var kutu = document.getElementById("mesajKutusu");
        var soruMetni = document.getElementById("Soru").value;

        var soruBalonu = document.createElement("div");
        soruBalonu.className = "d-flex justify-content-end mb-3 mesaj-satiri";
        soruBalonu.innerHTML = '<div class="alert mb-0 chat-balon balon-soru" style="max-width:70%;"></div>';
        soruBalonu.querySelector("div").textContent = soruMetni;
        kutu.appendChild(soruBalonu);

        setTimeout(function () {
            document.getElementById("Soru").value = "";
        }, 0);

        var yaziyorSatiri = document.createElement("div");
        // "sonraki-hale" satira da eklenir: #mesajKutusu (overflow-y:auto) her
        // sonraki-mesaj gonderiminde scroll-to-bottom yapildigi icin bu satirin
        // ALTINDA hemen hemen hic bosluk kalmiyor - hale disariya tastiginda
        // #mesajKutusu'nun kirpma sinirina carpip duz bir cizgide kesiliyordu.
        // Bu satira ozel (yalnizca .sonraki-hale) fazladan padding-bottom, hale
        // tamamen sonmeden o sinira ulasmasini engeller (bkz. asagidaki CSS).
        yaziyorSatiri.className = "d-flex justify-content-start mb-3 yaziyor-satiri mesaj-satiri" +
            (ilkMesajMi ? "" : " sonraki-hale");
        // Ilk mesaj: balon TAMAMEN ORIJINAL/degismemis - #parlama FLIP ile buraya
        // gezinecek (bkz. asagi), asama 2'ye kadar boyle kalacak. Sonraki mesajlar:
        // balon ayni gorunumu korur (ayni .chat-balon/.balon-cevap/max-width:70%),
        // ama ekstra dekoratif katmanlar icerir: .yaziyor-parlak (Asama 1A temel
        // hale), uc ozdes .yaziyor-tutam (Asama 1C: sabit siniflar/keyframes YOK -
        // hepsi JS tarafindan yaziyorTutamlariBaslat ile rastgele canlandirilan,
        // yeniden kullanilabilir bir havuz), .yaziyor-yuzey (tamamlanmis, ince dis
        // enerji yuzeyi - balonun silueti boyunca box-shadow ile, tutamlardan
        // SONRA/uzerinde durur ki aktif bir tutam bu yuzeyden cikiyormus gibi
        // gorunsun) ve .yaziyor-arkaplan (griyi tasiyan katman, hepsinin ustunde,
        // noktalarin altinda) - #parlama'ya hic dokunulmaz.
        yaziyorSatiri.innerHTML = ilkMesajMi
            ? '<div class="alert mb-0 chat-balon balon-cevap yaziyor-balonu" style="max-width:70%;">' +
              '<span class="nokta">.</span><span class="nokta">.</span><span class="nokta">.</span>' +
              '</div>'
            : '<div class="alert mb-0 chat-balon balon-cevap yaziyor-balonu sonraki-hale" style="max-width:70%;">' +
              '<span class="yaziyor-parlak" aria-hidden="true"></span>' +
              '<span class="yaziyor-tutam" aria-hidden="true"></span>' +
              '<span class="yaziyor-tutam" aria-hidden="true"></span>' +
              '<span class="yaziyor-tutam" aria-hidden="true"></span>' +
              '<span class="yaziyor-yuzey" aria-hidden="true"></span>' +
              '<span class="yaziyor-arkaplan" aria-hidden="true"></span>' +
              '<span class="nokta">.</span><span class="nokta">.</span><span class="nokta">.</span>' +
              '</div>';
        kutu.appendChild(yaziyorSatiri);

        if (ilkMesajMi) {
            var parlama = document.getElementById("parlama");
            var yaziyorBalonu = yaziyorSatiri.querySelector(".chat-balon");
            if (parlama && yaziyorBalonu) {
                parlamayiBalonaTasi(parlama, yaziyorBalonu, yaziyorSatiri);
            }
        } else {
            var sonrakiBalon = yaziyorSatiri.querySelector(".chat-balon");
            if (sonrakiBalon) {
                var tutamDurdur = yaziyorTutamlariBaslat(sonrakiBalon);
                window.addEventListener("pagehide", tutamDurdur, { once: true });
            }
        }

        kutu.scrollTop = kutu.scrollHeight;
    });
</script>
