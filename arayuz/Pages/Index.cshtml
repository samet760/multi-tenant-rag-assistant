        var detGovdeRenk1 = "", detGovdeRenkOrta = "", detGovdeRenk2 = "";

        // detAlanKucukTuval/detAlanVerisi: alanDegerlendir'in KENDI (kucukTuval/
        // alanVerisi) desenini yansitan, dusuk-cozunurluklu yerel maske tuvali -
        // her karede detAlanDegerlendir tarafindan YENIDEN doldurulur, boyutu
        // SABITTIR (DET_ALAN_GRID_U/V). detGeciciTuval/detGeciciCtx: pasoCiz'in
        // KENDI gecici-tuval teknigini yansitan, ekran boyutunda AYRI bir
        // offscreen tuval - detMorphBaslat'ta (asagida) detCanvas ile BIRLIKTE
        // olusturulur, DOM'a hic eklenmez (procedural gecici Tuval gibi).
        var detAlanKucukTuval = document.createElement("canvas");
        detAlanKucukTuval.width = DET_ALAN_GRID_U;
        detAlanKucukTuval.height = DET_ALAN_GRID_V;
        var detAlanKucukBaglam = detAlanKucukTuval.getContext("2d");
        var detAlanVerisi = detAlanKucukBaglam.createImageData(DET_ALAN_GRID_U, DET_ALAN_GRID_V);
        var detGeciciTuval = null, detGeciciCtx = null;

        function detSmoothstep(x) {
            x = x < 0 ? 0 : (x > 1 ? 1 : x);
            return x * x * (3 - 2 * x);
        }

        // detPencere: m<=baslangic'ta 0, m>=bitis'te 1, arada smoothstep -
        // detMorphCiz'in omuz/boyun/uc icin AYRI, KENDI m-pencerelerinde
        // (istek #7) ilerlemesini saglayan kucuk, saf yardimci. Eski
        // (kaldirilmis) skaler-alan sisteminin BIR PARCASI DEGIL - SADECE
        // deterministik canvas'in KENDI zamanlama-evresi icin.
        function detPencere(m, baslangic, bitis) {
            return detSmoothstep((m - baslangic) / (bitis - baslangic));
        }

        // detKubikBezier/detEase: emilim (p) icin, cevreAkisiCalistir'in KENDI
        // "ease-out" (CSS cubic-bezier(0,0,0.58,1)) egrisiyle AYNI SEKLI kucuk
        // bir Newton-Raphson cozucuyle uretir (istek #10 - govde-tuketimi ve
        // cevre-doluşu AYNI orani paylassin). cevreAkisiCalistir'in KENDISI
        // (asagida) HICBIR SEKILDE degistirilmedi/yeniden yazilmadi - bu SADECE
        // AYNI egri SEKLINI, canvas-cizim rAF dongusu icin bagimsizca yeniden
        // hesaplayan kucuk bir yardimci.
        function detKubikBezier(x1, y1, x2, y2) {
            function nokta(t, a, b) {
                var it = 1 - t;
                return 3 * it * it * t * a + 3 * it * t * t * b + t * t * t;
            }
            function egim(t, a, b) {
                var it = 1 - t;
                return 3 * it * it * a + 6 * it * t * (b - a) + 3 * t * t * (1 - b);
            }
            return function (x) {
                if (x <= 0) { return 0; }
                if (x >= 1) { return 1; }
                var t = x;
                for (var i = 0; i < 6; i++) {
                    var fx = nokta(t, x1, x2) - x;
                    var d = egim(t, x1, x2);
                    if (Math.abs(d) < 1e-6) { break; }
                    t -= fx / d;
                    t = t < 0 ? 0 : (t > 1 ? 1 : t);
                }
                return nokta(t, y1, y2);
            };
        }
        var detEase = detKubikBezier(0, 0, 0.58, 1); // CSS "ease-out" ile AYNI sekil

        function detCanvasOlustur() {
            var dpr = Math.min(window.devicePixelRatio || 1, 2);
            var c = document.createElement("canvas");
            c.setAttribute("aria-hidden", "true");
            c.style.position = "fixed";
            c.style.left = "0";
            c.style.top = "0";
            c.style.width = "100vw";
            c.style.height = "100vh";
            c.style.pointerEvents = "none";
            c.style.zIndex = "1000";
            c.width = Math.max(1, Math.round(window.innerWidth * dpr));
            c.height = Math.max(1, Math.round(window.innerHeight * dpr));
            document.body.appendChild(c);
            var ctx = c.getContext("2d");
            ctx.scale(dpr, dpr);
            return c;
        }

        // detGeciciOlustur: detCanvasOlustur ile AYNI dpr/olcek kuralini
        // izleyen ama DOM'a HIC eklenmeyen (procedural gecicTuval gibi, SADECE
        // offscreen composite icin) bir yardimci tuval.
        function detGeciciOlustur() {
            var dpr = Math.min(window.devicePixelRatio || 1, 2);
            var c = document.createElement("canvas");
            c.width = Math.max(1, Math.round(window.innerWidth * dpr));
            c.height = Math.max(1, Math.round(window.innerHeight * dpr));
            var ctx = c.getContext("2d");
            ctx.scale(dpr, dpr);
            return c;
        }

        function detYerelNokta(merkez, u, v) {
            return {
                x: merkez.x + detDirX * u + detPerpX * v,
                y: merkez.y + detDirY * u + detPerpY * v
            };
        }

        // detGeometriUret: EXPLICIT tip-first insa (istek #5) - "center +
        // guessed extended radius = tip" YERINE, ONCE tipWorld verilir, govde
        // merkezi GERIYE DOGRU (boyunUzunluk + kaide-payi kadar) turetilir.
        // Boylece govde/omuz asla tipin ONUNE gecemez (istek #6).
        function detGeometriUret(tipWorld, boyunUzunluk, govdeYariGenislik, boyunKaideYariGenislik, ucYariGenislik) {
            var kaidePay = govdeYariGenislik * DET_GOVDE_KAIDE_PAY_ORANI;
            var merkez = {
                x: tipWorld.x - detDirX * (boyunUzunluk + kaidePay),
                y: tipWorld.y - detDirY * (boyunUzunluk + kaidePay)
            };
            return {
                merkez: merkez,
                govdeYariGenislik: govdeYariGenislik,
                kaideU: kaidePay,
                boyunKaideYariGenislik: boyunKaideYariGenislik,
                ucU: kaidePay + boyunUzunluk,
                ucYariGenislik: ucYariGenislik
            };
        }

        // detTitreme: KUCUK, zamanla dalgalanan bir sapma dondurur - genlik
        // "taban" (o kaynagin KENDI yaricapi) bir orani olarak turetilir,
        // boylece govde genisken buyuk, uc incelmisken kucuk mutlak sapma
        // uretir. "tuz" (farkli sabit her kaynak icin) kaynaklarin BIRBIRINDEN
        // BAGIMSIZ/farkli fazda dalgalanmasini saglar. TANI (kullanici geri
        // bildirimi, "kararsiz olsun, direkt geliyor") - TEK bir sinus cok
        // DUZENLI/mekanik gorunuyordu ("direkt" hissi); IKI FARKLI frekans/
        // fazdaki sinusun (birbirine tam-sayi orantili OLMAYAN 1.7 katsayisi
        // ile) toplami, gercek periyodik OLMAYAN, cok daha organik/ongorulemez
        // bir titreklik uretir - gercek Perlin/simplex gurultusu YOK (asiri
        // muhendislik), ama AYNI etkiyi ucuza taklit eder.
        function detTitreme(zamanMs, taban, tuz) {
            var s1 = Math.sin(zamanMs * DET_TITREME_HIZI + tuz);
            var s2 = Math.sin(zamanMs * DET_TITREME_HIZI * 1.7 + tuz * 2.3 + 1.1);
            return (s1 * 0.7 + s2 * 0.3) * taban * DET_TITREME_GENISLIK_ORANI;
        }

        // detSalinim: detTitreme'nin AKSINE, HER kaynak icin AYRI/bagimsiz
        // FAZ degil - TEK, PAYLASILAN, yavas bir sinus dondurur (bkz. yukarida
        // DET_SALINIM_* yorumu, TANI). detAlanKaynaklariUret'te BUTUN
        // kaynaklara AYNI ANDA eklenerek TUM govde/boyunun BIR ARADA saga-sola
        // sallanmasini (kirbac benzeri) saglar - genlik CARI govdeYariGenislik'e
        // GORE (SABIT detHandoffYaricap'a DEGIL - govde/uc emilimde kuculdukce
        // sallanti da ORANTILI kuculur, koprulenme garantisi HER ZAMAN korunur,
        // bkz. yukarida TANI).
        function detSalinim(zamanMs, govdeYariGenislik) {
            return Math.sin(zamanMs * DET_SALINIM_HIZI) * govdeYariGenislik * DET_SALINIM_GENISLIK_ORANI;
        }

        // detYaricapAt: g'nin (govde/boyun-kaidesi/uc) tanimladigi genislik
        // profilini, verilen HERHANGI bir u'da (0..ucU) degerlendirir - hem
        // detAlanKaynaklariUret'in adaptif adimlama dongusunde HEM DE
        // uretilen her kaynagin KENDI yaricabini hesaplarken kullanilir (TEK
        // dogruluk kaynagi, iki kez yazilmis kopya formul YOK).
        function detYaricapAt(g, u) {
            if (u <= g.kaideU) {
                var t1 = g.kaideU > 0 ? u / g.kaideU : 1;
                return g.govdeYariGenislik + (g.boyunKaideYariGenislik - g.govdeYariGenislik) * detSmoothstep(t1);
            }
            // TANI (kullanici geri bildirimi, dorduncu tur - "ucun yuzde
            // 20'si ipince olsun sonra buyusun") - ONCEKI surumde bu segment
            // (boyunKaide->uc) TEK bir ease-in egrisiyle (t2^KUVVET) BASTAN
            // SONA surekli inceliyordu - kullanici bunu YETERSIZ buldu; asil
            // istedigi: govdeye YAKIN buyuk kisim (segmentin ilk
            // DET_UC_INCELME_BASLANGIC_T'si, ör. %80) NEREDEYSE SABIT/kalin
            // ("buyusun") kalsin, SADECE UCA EN YAKIN kisim (son %20) HIZLA
            // ipince bir noktaya cöksün - inceligin TAMAMI, uzunlugun kucuk
            // bir kismina SIKISTIRILIR. Govde/omuz tarafi (t1, yukarida) YINE
            // smoothstep/yuvarlak kalir, SADECE bu son bolum degisir.
            var boyunPay = g.ucU - g.kaideU;
            var t2 = boyunPay > 0 ? (u - g.kaideU) / boyunPay : 1;
            if (t2 <= DET_UC_INCELME_BASLANGIC_T) {
                return g.boyunKaideYariGenislik;
            }
            var t2i = DET_UC_INCELME_BASLANGIC_T < 1 ? (t2 - DET_UC_INCELME_BASLANGIC_T) / (1 - DET_UC_INCELME_BASLANGIC_T) : 1;
            var t2ie = Math.pow(t2i, DET_UC_EASE_KUVVETI);
            return g.boyunKaideYariGenislik + (g.ucYariGenislik - g.boyunKaideYariGenislik) * t2ie;
        }

        // detAlanKaynaklariUret: g (detGeometriUret'in ciktisi) tarafindan
        // tanimlanan genislik profilini, govdeden (u=0) uca (u=ucU) DOGRU
        // dizilmis dairesel metaball kaynaklarina (u, v, r) donusturur.
        // TANI (kullanici geri bildirimi, ucuncu tur - "cidden bi ince yap"):
        // ONCEKI surumde TEK bir global "en kucuk yaricap" HER YERDE ayni
        // (esit) araligi zorluyordu - uc COK incelince (ör. 0.02) bu, TUM
        // govde/boyun boyunca (kalin govde dahil) ayni asiri-sik araligi
        // gerektirip DET_ALAN_KAYNAK_SAYISI tavanini govde tarafinda
        // (gereksiz yere) tuketiyor, tam da yogunluga en cok ihtiyac duyulan
        // ince uc boglesinde YETERSIZ kaliyordu (koprulenme garantisi
        // bozuluyordu). Simdi ADAPTIF ADIMLAMA: u=0'dan baslanir, HER adimda
        // O ANKI (yerel) yaricapa gore (detYaricapAt) bir sonraki adim boyu
        // belirlenir (kalin govdede BUYUK adimlar/az nokta, ince uca
        // yaklasirken KUCUK adimlar/cok nokta) - boylece kaynak yogunlugu
        // TAM ihtiyac duyulan yerde (nerede ince orada sik) birikir, sabit
        // toplam kaynak sayisi govde tarafinda ISRAF edilmez. Son adim HER
        // ZAMAN tam u=ucU'ya (temas noktasina) varir - kesinlik BOZULMAZ.
        function detAlanKaynaklariUret(g, zamanMs, ekstraKaymaV) {
            ekstraKaymaV = ekstraKaymaV || 0;
            var noktalar = [0];
            var u = 0;
            var guard = 0;
            while (u < g.ucU && guard < DET_ALAN_KAYNAK_SAYISI - 1) {
                // Sadece BASLANGIC noktasinin yaricapina gore adim atmak,
                // yaricap adim ICINDE HIZLA (ör. sivri ucun hemen oncesinde)
                // dusuyorsa araligi OLDUGUNDAN AZ tahmin edip koprulenmeyi
                // riske atar - once bu yaricapla bir DENEME adimi atilir,
                // VARDIGI noktanin yaricabi da olculur, ikisinin KUCUGU
                // (rMin) ile adim YENIDEN (daha guvenli, kucuk) hesaplanir.
                // TANI (sayisal dogrulama, "cidden ince yap" turu): adim
                // tabani ONCEDEN sabit "1" idi (MUTLAK piksel) - govde/uc
                // kucuk olcekli/cok ince oldugunda (ör. yaricap <2.5px) bu,
                // GERCEK yerel yaricaptan BUYUK kalip adaptif mantigi
                // GECERSIZ kiliyor, koprulenmeyi bozuyordu. Taban artik
                // ucU'nun KENDI olcegine gore (SIFIRA bolme/sonsuz donguyu
                // ONLEMEK icin sadece) COK KUCUK bir epsilon.
                var adimTabani = Math.max(1e-4, g.ucU * 1e-4);
                var rBurada = detYaricapAt(g, u);
                var adimTahmini = Math.max(adimTabani, rBurada * DET_ALAN_KAYNAK_ARALIK_ORANI);
                var uTahmini = Math.min(g.ucU, u + adimTahmini);
                var rSonra = detYaricapAt(g, uTahmini);
                var rMin = Math.min(rBurada, rSonra);
                var adim = Math.max(adimTabani, rMin * DET_ALAN_KAYNAK_ARALIK_ORANI);
                u = Math.min(g.ucU, u + adim);
                noktalar.push(u);
                guard++;
            }
            if (noktalar[noktalar.length - 1] < g.ucU) {
                noktalar.push(g.ucU);
            }
            if (noktalar.length < DET_ALAN_MIN_KAYNAK_SAYISI) {
                noktalar = [];
                for (var mi = 0; mi < DET_ALAN_MIN_KAYNAK_SAYISI; mi++) {
                    noktalar.push((mi / (DET_ALAN_MIN_KAYNAK_SAYISI - 1)) * g.ucU);
                }
            }

            var kaynaklar = [];
            for (var i = 0; i < noktalar.length; i++) {
                var uu = noktalar[i];
                var r = detYaricapAt(g, uu);
                // Titremeyi/salinimi ucA yaklastikca sondur (DET_TITREME_
                // SAKINLESME_BASLANGIC_ORANI, TANI) - govde/orta-boyun
                // kararsiz/enerjik kalirken tam uc sakin/duz durur (sivri ucun
                // netligi BOZULMAZ), TAM uctaki kaynak (u===ucU) HER ZAMAN
                // v=0'da kalir (temas noktasi kesinligi KORUNUR). detSalinim
                // (TEK, paylasilan faz - TUM kaynaklarda AYNI) detTitreme'nin
                // (her kaynak KENDI/bagimsiz fazinda) UZERINE eklenir - biri
                // yerel mikro-titreklik, digeri govdenin BIR ARADA saga-sola
                // calkalanmasi (istek: "giderken oynasin, calkalansin").
                var sakinlikT = g.ucU > 0 ? uu / g.ucU : 1;
                var sakinlik = 1 - detPencere(sakinlikT, DET_TITREME_SAKINLESME_BASLANGIC_ORANI, 1.0);
                var v = (detTitreme(zamanMs, r, i * 1.9 + 0.6) + detSalinim(zamanMs, g.govdeYariGenislik) + ekstraKaymaV) * sakinlik;
                kaynaklar.push({ u: uu, v: v, r: r });
            }
            return kaynaklar;
        }

        // detAlanKutusu: kaynaklarin (u,v) bounding-box'i, en buyuk yaricapa
        // oranli bir kenar payiyla (DET_ALAN_PAY_ORANI - blur/hale icin yer)
        // buyutulmus. detAlanDegerlendir'in orneklemesi VE detPasoCiz'in
        // hedef dikdortgeni BUNUN UZERINDEN turetilir.
        function detAlanKutusu(kaynaklar) {
            var uMin = Infinity, uMax = -Infinity, vMax = 0;
            for (var i = 0; i < kaynaklar.length; i++) {
                var k = kaynaklar[i];
                uMin = Math.min(uMin, k.u - k.r);
                uMax = Math.max(uMax, k.u + k.r);
                vMax = Math.max(vMax, Math.abs(k.v) + k.r);
            }
            var pay = vMax * DET_ALAN_PAY_ORANI;
            return { uMin: uMin - pay, uMax: uMax + pay, vMin: -vMax - pay, vMax: vMax + pay };
        }

        // detAlanDegerlendir: alanDegerlendir (yukarida, ana prosedurel motor)
        // ile MATEMATIKSEL OLARAK AYNI teknik - r^2/(d^2+1) alanlarinin toplami,
        // smoothstep esikle alfaya cevrilir - ama tumParcaciklar/alanW/alanH
        // YERINE kaynaklar/kutu (detAlanKaynaklariUret/detAlanKutusu) uzerinde,
        // TAMAMEN BAGIMSIZ calisir. Cikti detAlanKucukTuval'e (kucukTuval'in
        // KENDI karsiligi) yazilir.
        function detAlanDegerlendir(kaynaklar, kutu) {
            var veri = detAlanVerisi.data;
            var idx = 0;
            var bw = kutu.uMax - kutu.uMin;
            var bh = kutu.vMax - kutu.vMin;
            for (var gy = 0; gy < DET_ALAN_GRID_V; gy++) {
                var pv = kutu.vMin + (gy + 0.5) / DET_ALAN_GRID_V * bh;
                for (var gx = 0; gx < DET_ALAN_GRID_U; gx++) {
                    var pu = kutu.uMin + (gx + 0.5) / DET_ALAN_GRID_U * bw;
                    var toplam = 0;
                    for (var n = 0; n < kaynaklar.length; n++) {
                        var k = kaynaklar[n];
                        var du = pu - k.u;
                        var dv = pv - k.v;
                        toplam += (k.r * k.r) / (du * du + dv * dv + 1);
                    }
                    var t = (toplam - (DET_ALAN_ESIK - DET_ALAN_ESIK_YUMUSAKLIGI)) / (2 * DET_ALAN_ESIK_YUMUSAKLIGI);
                    t = t < 0 ? 0 : (t > 1 ? 1 : t);
                    var alfa = t * t * (3 - 2 * t);

                    veri[idx] = 255;
                    veri[idx + 1] = 255;
                    veri[idx + 2] = 255;
                    veri[idx + 3] = Math.round(alfa * 255);
                    idx += 4;
                }
            }
            detAlanKucukBaglam.putImageData(detAlanVerisi, 0, 0);
        }

        // detPasoCiz: pasoCiz'in (yukarida, ana prosedurel motor) KENDI
        // teknigini birebir yansitir - dusuk-cozunurluklu maskeyi (buyume/blur
        // ile) gecici tam-ekran tuvale ciz, gradyani "source-in" ile o
        // maskenin icinden gecir, sonra ana detCtx'e (KENDI globalAlpha'siyla)
        // bindir. detCizimYap bunu iki kez cagirir: once buyutulmus+bulanik+
        // dusuk-alfa "hale" pasi, sonra buyume/blur olmadan keskin pas -
        // pasoCiz(buyume,bulanik,alfa,gradyan)'in AYNI cift-pasli deseni.
        function detPasoCiz(g, kutu, buyumePx, bulanikPx, alfa, gradyan) {
            if (alfa <= 0) { return; }

            detGeciciCtx.clearRect(0, 0, window.innerWidth, window.innerHeight);
            detGeciciCtx.save();
            if (bulanikPx > 0) {
                detGeciciCtx.filter = "blur(" + bulanikPx + "px)";
            }
            detGeciciCtx.translate(g.merkez.x, g.merkez.y);
            detGeciciCtx.rotate(detAci);
            var bw = kutu.uMax - kutu.uMin;
            var bh = kutu.vMax - kutu.vMin;
            detGeciciCtx.drawImage(detAlanKucukTuval, 0, 0, DET_ALAN_GRID_U, DET_ALAN_GRID_V,
                kutu.uMin - buyumePx / 2, kutu.vMin - buyumePx / 2, bw + buyumePx, bh + buyumePx);
            detGeciciCtx.restore();

            detGeciciCtx.save();
            detGeciciCtx.globalCompositeOperation = "source-in";
            detGeciciCtx.fillStyle = gradyan;
            detGeciciCtx.fillRect(0, 0, window.innerWidth, window.innerHeight);
            detGeciciCtx.restore();

            detCtx.save();
            detCtx.globalAlpha = alfa;
            detCtx.drawImage(detGeciciTuval, 0, 0, window.innerWidth, window.innerHeight);
            detCtx.restore();
        }

        // detCizimYap: viewport'u temizler, g'den (varsa) metaball
        // kaynaklarini/kutusunu/maskesini uretir (detAlanKaynaklariUret/
        // detAlanKutusu/detAlanDegerlendir) ve #parlama ile AYNI --parlama-
        // 1/2/3 CSS degiskenlerinden (istek #7 - tema-duyarli, kabul edilmis
        // SICAK/SOGUK renk ailesi) turetilmis 3 RENKLI (gradyanOlustur ile
        // BIREBIR AYNI sıra/durak) bir gradyanla, prosedurel pasoCiz'in KENDI
        // iki-pasli (buyutulmus+bulanik+dusuk-alfa "hale", SONRA keskin/tam-
        // alfa) tekniginde (bkz. detPasoCiz) boyar.
        function detCizimYap(g, alfa, zamanMs, ekstraKaymaV) {
            detCtx.clearRect(0, 0, window.innerWidth, window.innerHeight);
            if (!g || alfa <= 0) { return; }

            var kaynaklar = detAlanKaynaklariUret(g, zamanMs, ekstraKaymaV);
            var kutu = detAlanKutusu(kaynaklar);
            detAlanDegerlendir(kaynaklar, kutu);

            // arkaNoktasi/ucNoktasi: YENIDEN TANI (kullanici geri bildirimi,
            // on besinci tur, ekran goruntusuyle DOGRULANDI - "iki ayri
            // renkte iki parca yan yana konmus gibi") - ONCEKI iki tur da
            // (g.ucU, sonra max(g.ucU,govdeYariGenislik)) gradyanin nerede
            // bitecegini TAHMIN ediyordu - GERCEK cizilen sekille HER ZAMAN
            // birebir ORTUSMEK ZORUNDA DEGILDI. Ama detAlanKutusu (kutu,
            // YUKARIDA zaten hesaplanmis) kaynaklarin GERCEK u-r..u+r
            // sinirlarindan turetiliyor - alan degerlendirmesi (yukarida,
            // detAlanDegerlendir) zaten TAM bu sinirlar icinde ciziyor. Artik
            // TAHMIN YOK - gradyan dogrudan bu GERCEK sinira (kutu.uMin/uMax)
            // baglaniyor, boylece sekil ne kadar kisa/uzun olursa olsun HER
            // KAREDE TAM gorunen sekli kaplar - gradyanin erken bitip geri
            // kalanin duz renge kilitlenmesi (sert kenar/iki-parca gorunumu)
            // KOK NEDENiyle ortadan kalkar.
            var arkaNoktasi = detYerelNokta(g.merkez, kutu.uMin, 0);
            var ucNoktasi = detYerelNokta(g.merkez, kutu.uMax, 0);
            var gradyan = detCtx.createLinearGradient(arkaNoktasi.x, arkaNoktasi.y, ucNoktasi.x, ucNoktasi.y);
            // ortaDurak: TANI (kullanici geri bildirimi, on birinci tur) -
            // SABIT 0.55 (gradyanOlustur'un, KOMPAKT idle top icin durağı)
            // govde/uc arasindaki BUYUK uzunluk asimetrisinde turuncu->kirmizi
            // gecisini ince kuyruga sikistiriyordu. Orta durak artik kaideU ile
            // ucU'nun ORTASINA, GERCEK kutu span'ina (uMin..uMax) oranla
            // yerlestiriliyor, 0.35-0.80 arasinda sikistirilarak (on ucuncu
            // tur) coken/cakisan durak ve asiri erken sikisma onleniyor.
            var span = kutu.uMax - kutu.uMin;
            var ortaDurakHam = span > 0 ? (((g.kaideU + g.ucU) / 2) - kutu.uMin) / span : 0.5;
            var ortaDurak = Math.min(0.80, Math.max(0.35, ortaDurakHam));
            gradyan.addColorStop(0, detGovdeRenk1);
            gradyan.addColorStop(ortaDurak, detGovdeRenkOrta);
            gradyan.addColorStop(1, detGovdeRenk2);

            var haleBuyumePx = Math.max(1, detHandoffYaricap * DET_HALE_BUYUME_ORANI);
            var haleBulanikPx = Math.max(1, detHandoffYaricap * DET_HALE_BULANIKLIK_ORANI);
            detPasoCiz(g, kutu, haleBuyumePx, haleBulanikPx, alfa * DET_HALE_ALFA, gradyan);
            detPasoCiz(g, kutu, 0, 0, alfa, gradyan);
        }

        // detMorphCiz: m=0..1 - istek #7: govde (me, BUTUN m boyunca) hafifce
        // kuculurken, omuz/boyun/uc AYNI "me" ile DEGIL, HER BIRI KENDI ayri
        // m-penceresinde (detPencere, yukarida DET_*_ASAMA_* sabitleri)
        // ilerler - ONCE omuz daralir (erken pencere), SONRA boyun uzar
        // (orta pencere), SONRA uc incelir (gec pencere) - goz bu sirayi
        // ayirt edebilir, hepsi birden "patlamaz". TIP (istek #5)
        // tipBaslangic'tan (govdenin handoff anindaki GERCEK on kenari)
        // MEVCUT/DEGISTIRILMEMIS temas noktasina dogru me ile ilerler. m=1'de
        // govde/boyun/uc degerleri, emilim fazinin BASLANGIC referansi olarak
        // saklanir (sicramasiz devir).
        function detMorphCiz(zamanMs) {
            var gecen = zamanMs - detMorphBaslangicZamani;
            var t = gecen / detMorphSuresi;
            var m = t < 0 ? 0 : (t > 1 ? 1 : t);
            // mSonrasi: TANI (yukarida DET_ANTICIPASYON_* yorumu) - m'nin ILK
            // DET_ANTICIPASYON_ORANI'si boyunca 0'da SABIT kalir (govde/boyun/
            // uc HENUZ degismez - sadece asagidaki ekstraKaymaV ile bir
            // kerelik yanal "cil" olur), SONRA (m > ORANI) KALAN sureye
            // yayilarak 0'dan 1'e smoothstep ile ilerler - SEKIL donusumu
            // (govdeYariGenislik/boyunUzunluk/omuzE/ucE) BUNUN UZERINDEN
            // devam eder.
            var mSonrasi = detPencere(m, DET_ANTICIPASYON_ORANI, 1.0);
            var me = detSmoothstep(mSonrasi);
            var omuzE = detPencere(mSonrasi, DET_OMUZ_ASAMA_BASLANGIC, DET_OMUZ_ASAMA_BITIS);
            var ucE = detPencere(mSonrasi, DET_UC_ASAMA_BASLANGIC, DET_UC_ASAMA_BITIS);
            // konumE: YENIDEN TANI (kullanici geri bildirimi, dokuzuncu tur -
            // "hala bekliyo, sonra hareket etmeye basliyo" + "cok hizli
            // gelmeye baslamis gibi") - tipWorld (asagida) ONCEDEN de `me`
            // (anticipasyon-geçitli) kullaniyordu, yani govde/boyun GIBI
            // KONUM da bekleme boyunca (m<ANTICIPASYON_ORANI) TAMAMEN
            // DONUYORDU - govde merkezi tipWorld'den turedigi icin (bkz.
            // detGeometriUret) top ortada donup kaliyor, SONRA kalan mesafeyi
            // SADECE geri kalan kisa surede kat ediyordu (ani/hizli
            // hissettiriyordu). Konum ile sekil AYRI eksenler: kullanici
            // SEKLIN (incelmenin) kademeli baslamasini istiyor, KONUMUN
            // durup beklemesini DEGIL. Simdi konum HAM m'nin smoothstep'i -
            // anticipasyon penceresinden GECMIYOR - m=0'dan itibaren
            // KESINTISIZ ilerliyor; sadece sekil (me uzerinden) hala
            // gecikmeli/kademeli.
            var konumE = detSmoothstep(m);

            var govdeYariGenislik = detHandoffYaricap * (DET_GOVDE_YARIGENISLIK_BASLANGIC + (DET_GOVDE_YARIGENISLIK_BITIS - DET_GOVDE_YARIGENISLIK_BASLANGIC) * me);
            // boyunUzunluk artik SABIT DEGIL - CARI govdeYariGenislik'e
            // ORANLI (TANI, yukarida) - govde kuculdukce kuyruk da ORANTILI
            // kisalir, govde:kuyruk gorunumu m boyunca TUTARLI kalir.
            // YENIDEN TANI (kullanici geri bildirimi, sekizinci tur - "bekleme
            // sirasinda yay gibi uzun kocaman bisey gorunuyor, duz topcuk
            // olsun") - bu formul govdeYariGenislik'e oranli olsa da HICBIR
            // ZAMAN me ile geçitlenmiyordu; bekleme fazinda (m<ANTICIPASYON_
            // ORANI, me=0) govdeYariGenislik ZATEN tam boyutta oldugundan
            // boyun da HER ZAMAN tam uzunlukta (2.8x) ÇİZİLİYORDU - gorunmez
            // degil, aktif olarak "uzun ve (besinci turden beri kalinlasmis)
            // kalin" bir boyun bekleme boyunca sabit duruyordu. Simdi govde/
            // tipWorld gibi (asagida) *me ile geçitlendi - bekleme boyunca
            // boyunUzunluk=0 (govde SADECE kendi kaidePay'i kadar bir uc'a
            // sahip, duz yuvarlak "topcuk" gorunumu), me 0'dan 1'e ilerledikce
            // boyun SIFIRDAN kademeli uzuyor/inceliyor.
            var boyunUzunluk = govdeYariGenislik * DET_BOYUN_UZUNLUK_GOVDE_ORANI * me;
            var kaideOrani = DET_BOYUN_KAIDE_ORANI_BASLANGIC + (DET_BOYUN_KAIDE_ORANI_BITIS - DET_BOYUN_KAIDE_ORANI_BASLANGIC) * omuzE;
            var boyunKaideYariGenislik = govdeYariGenislik * kaideOrani;
            var ucYariGenislik = detHandoffYaricap * (DET_UC_YARIGENISLIK_BASLANGIC + (DET_UC_YARIGENISLIK_BITIS - DET_UC_YARIGENISLIK_BASLANGIC) * ucE);

            var tipWorld = {
                x: detTipBaslangic.x + (detTemasWorld.x - detTipBaslangic.x) * konumE,
                y: detTipBaslangic.y + (detTemasWorld.y - detTipBaslangic.y) * konumE
            };

            var g = detGeometriUret(tipWorld, boyunUzunluk, govdeYariGenislik, boyunKaideYariGenislik, ucYariGenislik);

            // ekstraKaymaV: IKI asamali hazirlik penceresi (TANI, yukarida).
            // "cil" suresi = ORANI*CIL_ORANI - SADECE bu kisa ilk dilimde
            // yari-sinus bir tumsek (m=0'da ve cil bitiminde SIFIR, ortasinda
            // tepe). Cil bitince (m > cilSuresi) DET_ANTICIPASYON_ORANI'ya
            // kadar ekstraKaymaV TAM SIFIR - govde/boyun/uc zaten SABIT (me
            // hala 0), goz belirgin bir DURGUNLUK anini gorur.
            var ekstraKaymaV = 0;
            var cilSuresi = DET_ANTICIPASYON_ORANI * DET_ANTICIPASYON_CIL_ORANI;
            if (m < cilSuresi) {
                var anticipasyonBiciimi = Math.sin(Math.PI * m / cilSuresi);
                ekstraKaymaV = -anticipasyonBiciimi * detHandoffYaricap * DET_ANTICIPASYON_GENISLIK_ORANI;
            }

            var crossfadeT = gecen / DET_GECIS_SURESI;
            var alfa = crossfadeT < 0 ? 0 : (crossfadeT > 1 ? 1 : crossfadeT);
            detCizimYap(g, alfa, zamanMs, ekstraKaymaV);

            if (m >= 1) {
                detGovdeYariGenislikM1 = govdeYariGenislik;
                detUcYariGenislikM1 = ucYariGenislik;
            }
        }

        // detEmilimCiz: p=0..1 - TIP HER ZAMAN detTemasWorld'de SABIT kalir
        // (yeniden hesaplanmaz - istek #9). Boyun uzunlugu 0'a iner (kaide
        // UCA dogru ilerler - "boyun ARKADAN kisalir"), govde/uc genisligi
        // AYNI hizda (govde tabani 0.10, uc tabani 0.22 - istek #9, boyun
        // giderken govde bir TOP gibi kalmasin) kucuk bir kalintiya kadar
        // YUMUSAK azalir. Son ~%4'te (DET_EMILIM_OPAKLIK_BASLANGIC_ORANI,
        // istek #10 - onceki ~%7'den KISALTILDI) kalan GERCEKTEN kucuk
        // kalinti SADECE opaklikla temizlenir - birincil mekanizma HER ZAMAN
        // geometri, opaklik degil.
        function detEmilimCiz(zamanMs) {
            var gecen = zamanMs - detEmilimBaslangicZamani;
            var t = gecen / fillSuresi;
            var pHam = t < 0 ? 0 : (t > 1 ? 1 : t);
            var p = detEase(pHam);

            var govdeYariGenislik = detGovdeYariGenislikM1 * (1 - (1 - DET_EMILIM_GOVDE_TABAN_ORANI) * p);
            // boyunUzunluk: morph ile AYNI govde-oranli ilke (TANI, yukarida)
            // - govde kuculdukce kuyruk ORANTILI kisalir - AMA emilimde ayrica
            // (1-p) ile carpilir, boylece p=1'de (tam emilim) tam SIFIRA iner
            // ("boyun ARKADAN kisalir" - istek #9 - HALA gecerli).
            var boyunUzunluk = govdeYariGenislik * DET_BOYUN_UZUNLUK_GOVDE_ORANI * (1 - p);
            var boyunKaideYariGenislik = govdeYariGenislik * DET_BOYUN_KAIDE_ORANI_BITIS;
            var ucYariGenislik = detUcYariGenislikM1 * (1 - (1 - DET_EMILIM_UC_TABAN_ORANI) * p);

            var g = detGeometriUret(detTemasWorld, boyunUzunluk, govdeYariGenislik, boyunKaideYariGenislik, ucYariGenislik);

            var alfa = 1;
            if (pHam > DET_EMILIM_OPAKLIK_BASLANGIC_ORANI) {
                alfa = 1 - (pHam - DET_EMILIM_OPAKLIK_BASLANGIC_ORANI) / (1 - DET_EMILIM_OPAKLIK_BASLANGIC_ORANI);
            }
            detCizimYap(g, alfa, zamanMs);

            if (pHam >= 1) {
                detTemizle();
            }
        }

        function detDongu(zamanMs) {
            if (detFaz === "morph") {
                detMorphCiz(zamanMs);
            } else if (detFaz === "emilim") {
                detEmilimCiz(zamanMs);
            }
            if (detFaz !== "bitti") {
                detRafId = requestAnimationFrame(detDongu);
            }
        }

        // detTemizle: gecici canvas'i kaldirir, rAF dongusunu durdurur - hicbir
        // requestAnimationFrame/DOM dugumu SIZDIRILMAZ (istek #13). #parlama
        // zaten .parlama-gizli SINIFIYLA (asagida detMorphBaslat) KALICI
        // olarak gizlenmis durumda - buradan AYRICA dokunulmaz.
        function detTemizle() {
            detFaz = "bitti";
            if (detRafId !== null) {
                cancelAnimationFrame(detRafId);
                detRafId = null;
            }
            if (detCanvas && detCanvas.parentNode) {
                detCanvas.parentNode.removeChild(detCanvas);
            }
            detCanvas = null;
            detCtx = null;
            detGeciciTuval = null;
            detGeciciCtx = null;
        }

        // detMorphBaslat: PROSEDUREL #parlama'dan DETERMINISTIK canvas'a el
        // degistirme (istek #1). MEVCUT gorunen (WAAPI ile canli guncellenen)
        // #parlama kutusu getBoundingClientRect() ile OKUNUR - govdenin
        // konumu/boyutu TAHMIN edilmez, olcum edilir. seyahatAnim ONCE
        // pause()+commitStyles() ile MEVCUT karesine SABITLENIR (boylece
        // cancel() cagrildiginda BASA SICRAMAZ), sonra cancel() edilip TEK
        // basina, cakismayan YENI bir opaklik-fade ile kisa surede (istek #6 -
        // 80-120ms) sondurulur - boylece #parlama, canvas govdeyi
        // devraldiktan sonra ASLA altta gorunur sekilde YARISMAZ.
        function detMorphBaslat() {
            var r = parlama.getBoundingClientRect();
            var handoffMerkez = { x: r.left + r.width / 2, y: r.top + r.height / 2 };
            var handoffOlcek = r.width / 300; // #parlama'nin TRANSFORM-ONCESI genisligi HER ZAMAN 300px
            detHandoffYaricap = govdeYaricapi(handoffOlcek);
            detTipBaslangic = {
                x: handoffMerkez.x + detDirX * detHandoffYaricap,
                y: handoffMerkez.y + detDirY * detHandoffYaricap
            };

            // 3 renk de gradyanOlustur() ile AYNI kaynaktan (--parlama-1/2/3)
            // ve AYNI sırayla okunur - istek: govde artik 2 renkli DUZ bir
            // dolgu degil, prosedurel govdeyle BIREBIR AYNI 3 renkli gecis.
            var stil = getComputedStyle(parlama);
            detGovdeRenk1 = stil.getPropertyValue("--parlama-1").trim();
            detGovdeRenkOrta = stil.getPropertyValue("--parlama-2").trim();
            detGovdeRenk2 = stil.getPropertyValue("--parlama-3").trim();

            detCanvas = detCanvasOlustur();
            detCtx = detCanvas.getContext("2d");
            detGeciciTuval = detGeciciOlustur();
            detGeciciCtx = detGeciciTuval.getContext("2d");

            // detParlamaDondu: TANI (yukarida, tanim yerinde) - #parlama'nin
            // KENDI dongu()'sunu burada, opaklik solmasi baslamadan HEMEN
            // ONCE durduruyoruz - solan kare ARTIK SABIT (donmus), yeni
            // canvas'in FARKLI eksenli gradyaniyla cakisirken bile TITREMEDEN
            // kisa/statik bir capraz-solma olarak gorunur.
            detParlamaDondu = true;

            if (seyahatAnim.pause) { seyahatAnim.pause(); }
            try {
                if (seyahatAnim.commitStyles) { seyahatAnim.commitStyles(); }
            } catch (e) {
                // guvenlik agi: commitStyles bazi kenar durumlarda (ör. eleman
                // gecici olarak render-disi) istisna atabilir - yoksayilir,
                // asagidaki cancel() + yeni opaklik animasyonu yine de calisir.
            }
            seyahatAnim.cancel();
            if (parlama.animate) {
                parlama.animate(
                    [{ opacity: 1 }, { opacity: 0 }],
                    { duration: DET_GECIS_SURESI, easing: "linear", fill: "forwards" }
                );
            } else {
                parlama.style.opacity = "0";
            }
            setTimeout(function () {
                parlama.classList.add("parlama-gizli");
            }, DET_GECIS_SURESI);

            detMorphBaslangicZamani = performance.now();
            detMorphSuresi = Math.max(1, seyahatSure - Math.round(seyahatSure * DET_MORPH_BASLANGIC_ORANI));
            detFaz = "morph";
            detRafId = requestAnimationFrame(detDongu);
        }

        // detEmilimBaslat: TAM temas aninda (asagidaki, DEGISMEMIS
        // setTimeout(...,seyahatSure) icinden) cagrilir - AYNI KARE, AYNI
        // "p" mantigiyla suction+perimeter'i baslatan tek nokta (istek #8/#10).
        function detEmilimBaslat() {
            detEmilimBaslangicZamani = performance.now();
            detFaz = "emilim";
            if (detRafId === null) {
                detRafId = requestAnimationFrame(detDongu);
            }
        }

        // Seyahat + temas + emilim TEK bir WAAPI animasyonunda oynar
        // (fill:"forwards" son kareyi - opacity 0, temas noktasina gomulu
        // govde - kalici tutar). toplamSure aninda Şey'in animasyonu biter;
        // asagidaki cevre-akisi/hale/rezerv-sonumu de AYNI ana (seyahatSure)
        // baslar ve AYNI sureyi (fillSuresi) paylasir - bu YUZDEN emilim ve
        // cevre-guc-yayilimi birlikte ilerler ve birlikte tamamlanir. SADECE
        // seyahatin ilk DET_MORPH_BASLANGIC_ORANI'si boyunca GORUNUR kalir -
        // detMorphBaslat (asagida, ayri bir setTimeout ile) devraldiktan sonra
        // pause/commitStyles/cancel edilir (yukarida) - kareler/emilimKaresi/
        // seyahatMerkezi'nin KENDISI hicbir sekilde degismedi.
        // Gercek POST navigasyonu (form submit zaten engellenmiyor) sayfayi
        // normal sekilde degistirecek; burada yapay bir gecikme eklenmedi.
        var seyahatAnim = parlama.animate(kareler, {
            duration: toplamSure,
            easing: "cubic-bezier(0.33, 0, 0.2, 1)",
            fill: "forwards"
        });

        // Prosedurel govdeye (ayri <script> blogundaki fizik motoruna)
        // manyetik-cekim yonunu/suresini bildirir - SADECE ilk mesaj
        // seyahati bu kancayi cagirir, bu yuzden idle/sonraki mesaj
        // davranisi ETKILENMEDI. Yon, "yonX/yonY" (disariya-dogru, balonun
        // GELDIGI yon) ile TERS (-yonX,-yonY) verilir - manyetik cekim
        // balonun/temas noktasinin bulundugu yone dogru olmali. Sure olarak
        // seyahatSure verilir ki cekim TAM temas anina denk gelecek sekilde
        // tepe noktasina ulassin (bkz. window.__parlamaManyetikBaslat).
        // Fonksiyon yoksa (beklenmedik durum) sessizce atlanir - govde
        // yine de DUZGUN seyahat eder, sadece manyetik bukulme olmaz.
        if (window.__parlamaManyetikBaslat) {
            window.__parlamaManyetikBaslat(-yonX, -yonY, seyahatSure);
        }

        // Deterministik son-yaklasim el degistirmesi (istek #1) - seyahatin
        // DET_MORPH_BASLANGIC_ORANI'sinda (yukarida tanimli sabit) tetiklenir.
        // Bagimsiz bir zamanlayici - asagidaki temas setTimeout'unu (seyahatSure)
        // HICBIR SEKILDE degistirmez/geciktirmez.
        setTimeout(detMorphBaslat, Math.round(seyahatSure * DET_MORPH_BASLANGIC_ORANI));

        // fillSuresi zaten yukarida (collapseSure'un da paylastigi deger
        // olarak) tanimlandi - burada YENIDEN bildirilmiyor.
        //
        // Akis, toplamSure (emilim BITISI) yerine seyahatSure'de (Şey'in
        // balona GERCEKTEN degdigi an - kareler dizisindeki pTemas offset'i,
        // p=0) baslar ve fillSuresi kadar surer - emilim de (collapseSure =
        // fillSuresi) TAM AYNI p=0..1 penceresini kapladigi icin ikisi
        // BASTAN SONA ORTUSUR, sadece son 160ms'lik bir kesisim degil.
        setTimeout(function () {
            // Manyetik cekimi TAM temas aninda notre dondurur - guc() zaten
            // bu noktadan sonra bir daha okunmayacaktir (govde emiliyor),
            // ama "aktif" bayragini burada kapatmak, gecici seyahat
            // durumunun baska HICBIR SEKILDE (kaza/yeniden kullanim)
            // sizamayacagini garanti eder (bkz. window.__parlamaManyetikBitir).
            if (window.__parlamaManyetikBitir) {
                window.__parlamaManyetikBitir();
            }

            // Deterministik emilim (istek #8/#9/#10) TAM BU KAREDE baslar -
            // cevreAkisiCalistir (asagida, birkaç satir sonra, AYNI senkron
            // cagri yigininda) ile TAM AYNI ani paylasir; ikisi de fillSuresi
            // kullanir - "ayni baslangic/ayni sure" boylece INSA GEREGI
            // saglanir (bkz. yukarida detEmilimBaslat/detEase).
            detEmilimBaslat();

            // Griyi tasiyan zemin (.yaziyor-arkaplan) + --yuzey-1/2 renk
            // degiskenlerini acan .sonraki-hale sinifi BURADA, akis
            // baslamadan HEMEN once devreye girer - .yaziyor-akis-cw/ccw'nin
            // stroke rengi (rgba(var(--yuzey-1),...)) BU SINIF OLMADAN
            // GECERSIZDIR. .yaziyor-yuzey EKLENMEZ - ilk mesajda kalici dis
            // yuzey rolunu artik asagida buyuyen SVG'nin KENDISI ustlenir.
            // Renkler/gorunum ONCEKI (balon-cevap) ile BIREBIR AYNI
            // oldugundan bu gecis GORSEL OLARAK SESSIZDIR.
            ilkMesajZeminEtkinlestir(hedefBalon, satir);

            // Hale (.yaziyor-parlak/.yaziyor-tutam): akisin ILK ~%80'INDE HIC
            // EKLENMEZ (tamamen etkisiz/yok) - cevre insasi izlenirken genel
            // bir mor pus balonun tamamini KAPLAMAZ. Akisin SON %20'sinde
            // eklenip carprazlanir, akis tamamlandigi anda kabul edilmis
            // normal siddetine ulasir. Fonksiyonlarin KENDISI DEGISMEDI
            // (enerjiKatmaniniEkle/enerjiyiCrossfadeEt).
            setTimeout(function () {
                var enerji = enerjiKatmaniniEkle(hedefBalon);
                enerjiyiCrossfadeEt(enerji, Math.round(fillSuresi * 0.20));
            }, Math.round(fillSuresi * 0.80));

            // Temas rezervi akisla TAM AYNI anda (senkron) olusturulur -
            // cepheler ayrilir ayrilmaz rezerv hemen sonmeye baslar (kisa bir
            // "el degistirme" - uzun sureli yuvarlak mor nokta YOK). Kendi
            // fade-in'i (TEMAS_REZERV_FADE_SURE, bu kapsam disi elemanin
            // ESKI 160ms'lik collapseSure*0.5'ine denk gelen SABIT 80ms -
            // ARTIK fillSuresi'yle esitlenen collapseSure'a BAGLI DEGIL,
            // boylece emilim suresi uzasa da bu kucuk noktanin belirme hizi
            // DEGISMEZ) ile beliriyor, HEMEN ardindan asagidaki sonme
            // animasyonu (%15'te ~0.30, %32'de 0) UZERINE biner - ikisinin
            // baslangic degeri (opacity:1) AYNI oldugundan gorsel sicrama
            // olmaz.
            var TEMAS_REZERV_FADE_SURE = 80;
            var temasEnerjisiEl = temasEnerjisiOlustur(akis.temasX, akis.temasY, TEMAS_REZERV_FADE_SURE);
            if (temasEnerjisiEl && temasEnerjisiEl.animate) {
                temasEnerjisiEl.animate(
                    [
                        { opacity: 1, offset: 0 },
                        { opacity: 0.3, offset: 0.15 },
                        { opacity: 0, offset: 0.32 },
                        { opacity: 0, offset: 1 }
                    ],
                    { duration: fillSuresi, easing: "ease-in", fill: "forwards" }
                );
            }

            // Iki yonlu, KALICI cevre yuzeyi (cwYol/ccwYol - asagida
            // cevreAkisiCalistir) - AYNI s0'dan baslar, s0 + uzunluk/2'de
            // geometrik olarak KESIN bulusur ve BUYUYEN GEOMETRININ KENDISI
            // (SVG hicbir zaman kaldirilmadan/degistirilmeden) ilk mesajin
            // kalici dis derisi olarak kalir. Tamamlaninca SADECE rastgele
            // tutam zamanlayicisi baslar - kabul edilmis
            // yaziyorTutamlariBaslat, DEGISMEDI - baska hicbir katman/switch
            // eklenmez.
            cevreAkisiCalistir(akis, fillSuresi, function () {
                var tutamDurdur = yaziyorTutamlariBaslat(hedefBalon);
                window.addEventListener("pagehide", tutamDurdur, { once: true });
            });
        }, Math.round(seyahatSure));
    }

    // GECICI TANI DEGIL - ilk mesaj icin KALICI: griyi tasiyan zemini
    // (.yaziyor-arkaplan) ve --yuzey-1/2 renk degiskenlerini acan
    // .sonraki-hale sinifini etkinlestirir - balonuEtkinlestir'in AKSINE
    // .yaziyor-yuzey EKLEMEZ (ilk mesajda o rolu buyuyen cevre-akis SVG'si
    // ustlenir - bkz. yukaridaki parlamayiBalonaTasi). Guvenlik agi: zemin
    // zaten varsa (ikinci cagri) hicbir sey yapmaz.
    function ilkMesajZeminEtkinlestir(balon, satir) {
        if (balon.querySelector(".yaziyor-arkaplan")) {
            return;
        }
        balon.classList.add("sonraki-hale");
        if (satir) {
            satir.classList.add("sonraki-hale");
        }
        balon.insertAdjacentHTML("afterbegin", '<span class="yaziyor-arkaplan" aria-hidden="true"></span>');
    }

    // Balonun GERCEK yuvarlatilmis silueti icin gecici bir SVG izleyici kurar ve
    // verilen (yonX,yonY) disa-dogru yonune EN UZAK (yani Şey'in geldigi tarafa
    // en yakin) sinir noktasini, SVG'nin kendi getPointAtLength'i ile SAYISAL
    // olarak orneklem alarak bulur - elle yazilmis kose/kenar geometrisi
    // formullerine gerek yok, tarayicinin kendi dogru yol hesaplamasina guvenilir.
    // DORT AYNI geometrili <rect> olusturulur: iki "govde/iz" (yol) + iki "uc"
    // (parlak, hareketli baslik) - hepsi cevreAkisiCalistir tarafindan yeniden
    // kullanilir (yeniden olusturulmaz).
    function cevreAkisiKur(balon, dikdortgen, yonX, yonY) {
        var w = dikdortgen.width, h = dikdortgen.height;
        var r = parseFloat(getComputedStyle(balon).borderTopLeftRadius) || 0;
        r = Math.max(0, Math.min(r, w / 2 - 1, h / 2 - 1));
        // KENAR_ICE_PAY: yol/uc dortgeninin SVG kutusunun kendi kenarindan
        // ne kadar ice cekildigi - ONCEDEN 1.5px idi, bu balonun GERCEK dis
        // sinirinin biraz ICINDE, ince acik/beyaz bir bosluk birakiyordu
        // (govde artik blur() ile bulaniklastirilmadigindan - bkz. yukarida
        // CEKIRDEK/HALE notu - bu bosluk daha belirgin gorunuyordu). Deger
        // 0.75'e indirilerek yol/uc SADECE disariya dogru KUCUK bir miktar
        // kaydirildi - r/getPointAtLength/s0/dasharray formulleri DEGISMEDI,
        // sadece BU rect'in kendi konumu/boyutu (dolayisiyla akisin calisma-
        // zamaninda olctugu uzunluk) hafifce degisti.
        var KENAR_ICE_PAY = 0.75;
        var gecOznitelik = 'x="' + KENAR_ICE_PAY + '" y="' + KENAR_ICE_PAY + '" width="' + Math.max(0, w - KENAR_ICE_PAY * 2) +
            '" height="' + Math.max(0, h - KENAR_ICE_PAY * 2) + '" rx="' + r + '" ry="' + r + '"';

        balon.insertAdjacentHTML("afterbegin",
            '<svg class="yaziyor-akis" aria-hidden="true" width="' + w + '" height="' + h +
            '" viewBox="0 0 ' + w + ' ' + h + '">' +
            '<rect class="yaziyor-akis-yol yaziyor-akis-ccw" ' + gecOznitelik + '></rect>' +
            '<rect class="yaziyor-akis-yol yaziyor-akis-cw" ' + gecOznitelik + '></rect>' +
            '<rect class="yaziyor-akis-uc yaziyor-akis-uc-ccw" ' + gecOznitelik + '></rect>' +
            '<rect class="yaziyor-akis-uc yaziyor-akis-uc-cw" ' + gecOznitelik + '></rect>' +
            '</svg>');

        var svg = balon.querySelector(".yaziyor-akis");
        var cwYol = balon.querySelector(".yaziyor-akis-cw");
        var ccwYol = balon.querySelector(".yaziyor-akis-ccw");
        var cwUc = balon.querySelector(".yaziyor-akis-uc-cw");
        var ccwUc = balon.querySelector(".yaziyor-akis-uc-ccw");
        var uzunluk = cwYol.getTotalLength ? cwYol.getTotalLength() : 0;

        var merkezX = w / 2, merkezY = h / 2;
        var enIyiS = 0, enIyiDeger = -Infinity, enIyiNokta = { x: w, y: h / 2 };
        var ORNEK = 96;
        for (var i = 0; i < ORNEK && uzunluk > 0; i++) {
            var s = (i / ORNEK) * uzunluk;
            var p = cwYol.getPointAtLength(s);
            var deger = (p.x - merkezX) * yonX + (p.y - merkezY) * yonY;
            if (deger > enIyiDeger) {
                enIyiDeger = deger;
                enIyiS = s;
                enIyiNokta = p;
            }
        }

        return {
            svg: svg,
            cwYol: cwYol,
            ccwYol: ccwYol,
            cwUc: cwUc,
            ccwUc: ccwUc,
            uzunluk: uzunluk,
            s0: enIyiS,
            temasX: dikdortgen.left + enIyiNokta.x,
            temasY: dikdortgen.top + enIyiNokta.y
        };
    }

    // Temas noktasindan IKI yonde (saat yonu / saat yonunun tersine) esit hizda
    // buyuyen iki stroke-dasharray/-dashoffset animasyonu baslatir (govde/iz).
    // cwYol ve ccwYol GEOMETRIK OLARAK OZDES kapali bir yolu paylastigi icin,
    // ikisinin de YARISINI (uzunluk/2) cizmesi otomatik olarak TAM CEVREYI
    // kapatir ve iki cephe, ayrica hesaplanmasi gerekmeyen, geometrik olarak
    // KESIN karsi noktada (s0 + uzunluk/2) bulusur.
    //
    // MIMARI: bu SVG GECICI BIR IZLEYICI DEGIL. cwYol/ccwYol (govde/iz)
    // HICBIR ZAMAN kaldirilmaz/degistirilmez - %0'dan %100'e buyuyen bu IKI
    // rect'in KENDISI, ilk mesajin KALICI dis derisi olarak kalir - sadece
    // dasharray UZUNLUGU degisir, gercekten TEMAS NOKTASINDAN DISA DOGRU
    // BUYUYEN bir geometri.
    //
    // Govde/iz'in KENDI stroke rengi (CSS'teki rgba(var(--yuzey-1/2), 0.85) -
    // ilk mesaja OZEL, sonraki mesajlarin kullandigi hicbir renk/katmanla
    // PAYLASILMAZ) SABIT kalir; element opacity'si de TUM akis boyunca
    // (baslangictan tamamlanmaya kadar) 1'de SABIT kalir - ONCEDEN burada
    // TAZE_ORAN'dan sonra dusuk bir "dinlenme" opakligina soner, gecmis
    // rotanin GORUNMEZ/SOLUK bir "deri"ye donusmesine yol acardi (perimeter
    // gucun kaybolmus gibi gorunmesi). ARTIK govde/iz bir kere cizildikten
    // sonra HICBIR SEKILDE dimlenmez - kablo, akim gectikce SUREKLI yuklu
    // kalir. AYNI iki geometriden turetilen KISA, daha parlak "uc" segmentleri (cwUc/ccwUc)
    // govdenin o anki HAREKETLI ucunu takip eder (DASHOFFSET SABIT/degisken
    // formullerinden matematiksel olarak turetildi) - bunlar TAZE_ORAN
    // boyunca gecici olarak daha genis (UC_PARLAMA_GENISLIK) cizilip normal
    // genisligine (UC_NORMAL_GENISLIK) daralir, akis tamamlanmadan hemen
    // once SONER (opacity 1->0, son %15) - bu, IKI GORUNUR, HAREKETLI parlak
    // uc noktasi olarak balonun cevresinde CW/CCW dolanir. tamamlaninca geri
    // cagirisi (SADECE rastgele tutam zamanlayicisini baslatir) akis SURESI
    // dolunca calisir; SVG'ye/DOM'a BASKA HICBIR SEKILDE dokunulmaz.
    function cevreAkisiCalistir(akis, sure, tamamlaninca) {
        sure = sure || 750; // 650-850ms araliginda

        // TAZE_ORAN: akisin ilk ~%35'i - "uc"un gecici olarak genisledigi
        // pencere (govde/iz icin ARTIK bir "taze/dinlenme" ayrimi yok, bkz.
        // asagi).
        var TAZE_ORAN = 0.35;
        // KALICI_GUC_OPAKLIGI: govde/iz'in element opacity'si - BASTAN SONA
        // (0 -> 1 offset) SABIT 1. ONCEDEN (DINGINLESME_OPAKLIGI) bu deger
        // TAZE_ORAN'dan sonra 0.55'e dusuyordu; bu, CSS'teki stroke alfasiyla
        // carpilinca gecmiste cizilmis butun rotanin (yeni cizilen kisim
        // DAHIL) giderek soluklasmasina yol aciyordu - "kablo" akim
        // gectikten sonra sonuyormus gibi gorunuyordu. Artik govde/iz bir
        // kere cizildikten sonra HICBIR SEKILDE dimlenmiyor.
        var KALICI_GUC_OPAKLIGI = 1;

        if (!akis.uzunluk || !akis.cwYol.animate) {
            // WAAPI/getTotalLength desteklenmiyorsa: govde/iz'i dogrudan
            // %100 dolu STATIK duruma getir (CSS ile) - boylece "kalici deri"
            // hala doğru gorunur, sadece animasyonsuz belirir.
            if (akis.uzunluk) {
                var Lf = akis.uzunluk, s0f = akis.s0;
                akis.cwYol.style.strokeDasharray = (Lf / 2) + "px " + (Lf / 2) + "px";
                akis.cwYol.style.strokeDashoffset = (-s0f) + "px";
                akis.cwYol.style.opacity = KALICI_GUC_OPAKLIGI;
                akis.ccwYol.style.strokeDasharray = (Lf / 2) + "px " + (Lf / 2) + "px";
                akis.ccwYol.style.strokeDashoffset = (Lf / 2 - s0f) + "px";
                akis.ccwYol.style.opacity = KALICI_GUC_OPAKLIGI;
            }
            if (tamamlaninca) {
                tamamlaninca();
            }
            return;
        }

        var L = akis.uzunluk, s0 = akis.s0;

        // "Uc" segment uzunlugu: cevrenin ~%6'si, 6-...px arasinda sikistirilmis -
        // kisa/tanidik bir "baslik", asla bir nokta/parcacik gibi gorunmeyecek
        // kadar uzun degil.
        var ucUzunlugu = Math.max(6, Math.min(L / 6, L * 0.06));
        var UC_PARLAMA_GENISLIK = 6.5; // TAZE_ORAN boyunca gecici "canlanma" genisligi
        var UC_NORMAL_GENISLIK = 4.5;  // CSS'teki .yaziyor-akis-uc stroke-width ile AYNI

        akis.cwYol.animate(
            [
                { strokeDasharray: "0px " + L + "px", strokeDashoffset: (-s0) + "px", opacity: 1, offset: 0 },
                { strokeDasharray: (TAZE_ORAN * L / 2) + "px " + (L - TAZE_ORAN * L / 2) + "px", strokeDashoffset: (-s0) + "px", opacity: 1, offset: TAZE_ORAN },
                { strokeDasharray: (L / 2) + "px " + (L / 2) + "px", strokeDashoffset: (-s0) + "px", opacity: KALICI_GUC_OPAKLIGI, offset: 1 }
            ],
            { duration: sure, easing: "ease-out", fill: "forwards" }
        );

        akis.ccwYol.animate(
            [
                { strokeDasharray: "0px " + L + "px", strokeDashoffset: (-s0) + "px", opacity: 1, offset: 0 },
                { strokeDasharray: (TAZE_ORAN * L / 2) + "px " + (L - TAZE_ORAN * L / 2) + "px", strokeDashoffset: (-s0 + TAZE_ORAN * L / 2) + "px", opacity: 1, offset: TAZE_ORAN },
                { strokeDasharray: (L / 2) + "px " + (L / 2) + "px", strokeDashoffset: (L / 2 - s0) + "px", opacity: KALICI_GUC_OPAKLIGI, offset: 1 }
            ],
            { duration: sure, easing: "ease-out", fill: "forwards" }
        );

        // "Uc" katmanlari: dasharray SABIT (ucUzunlugu), dashoffset govde ile
        // AYNI matematikten turetilir (senkron kalir). strokeWidth TAZE_ORAN
        // boyunca UC_PARLAMA_GENISLIK'ten UC_NORMAL_GENISLIK'e daralir. Son
        // %15'te opacity 1 -> 0 sonerek ucun kendisi de govdeyle AYNI anda
        // "dinlenme" derisine karisir - bulusma noktasinda kalici parlak bir
        // iz KALMAZ.
        akis.cwUc.style.strokeDasharray = ucUzunlugu + "px " + (L - ucUzunlugu) + "px";
        akis.cwUc.animate(
            [
                { strokeDashoffset: (ucUzunlugu - s0) + "px", strokeWidth: UC_PARLAMA_GENISLIK, opacity: 1, offset: 0 },
                { strokeDashoffset: (ucUzunlugu - s0 - L / 2 * TAZE_ORAN) + "px", strokeWidth: UC_NORMAL_GENISLIK, opacity: 1, offset: TAZE_ORAN },
                { strokeDashoffset: (ucUzunlugu - s0 - L / 2 * 0.85) + "px", strokeWidth: UC_NORMAL_GENISLIK, opacity: 1, offset: 0.85 },
                { strokeDashoffset: (ucUzunlugu - s0 - L / 2) + "px", strokeWidth: UC_NORMAL_GENISLIK, opacity: 0, offset: 1 }
            ],
            { duration: sure, easing: "ease-out", fill: "forwards" }
        );

        akis.ccwUc.style.strokeDasharray = ucUzunlugu + "px " + (L - ucUzunlugu) + "px";
        akis.ccwUc.animate(
            [
                { strokeDashoffset: (-s0) + "px", strokeWidth: UC_PARLAMA_GENISLIK, opacity: 1, offset: 0 },
                { strokeDashoffset: (L / 2 * TAZE_ORAN - s0) + "px", strokeWidth: UC_NORMAL_GENISLIK, opacity: 1, offset: TAZE_ORAN },
                { strokeDashoffset: (L / 2 * 0.85 - s0) + "px", strokeWidth: UC_NORMAL_GENISLIK, opacity: 1, offset: 0.85 },
                { strokeDashoffset: (L / 2 - s0) + "px", strokeWidth: UC_NORMAL_GENISLIK, opacity: 0, offset: 1 }
            ],
            { duration: sure, easing: "ease-out", fill: "forwards" }
        );

        // Iki cephe (geometrik olarak KESIN) burada, s0 + uzunluk/2 noktasinda
        // bulusmus olur. SVG'ye/govde-iz'e HICBIR SEKILDE dokunulmaz (fade
        // YOK, kaldirma YOK, degistirme YOK) - sadece cagirana haber verilir
        // (SADECE rastgele tutam zamanlayicisini baslatir, bkz. cagiran).
        setTimeout(function () {
            if (tamamlaninca) {
                tamamlaninca();
            }
        }, sure);
    }

    // (Duzeltme) .yaziyor-parlak/.yaziyor-tutam'i (KENDI opacity/transform'u
    // zaten parlakSuzulme/tutam olaylariyla surekli degistigi icin) crossfade
    // edilebilecek ayri bir sarmalayicinin (.yaziyor-enerji) icine ekler. SADECE
    // bu ikisi sarmalayici icindedir - .yaziyor-yuzey ARTIK BURAYA EKLENMEZ (bkz.
    // balonuEtkinlestir'deki duzeltme notu). Balon basina yalnizca BIR kez
    // eklenir (guvenlik agi). Cagiran, dondurulen elemanin crossfade'ini AYRICA
    // (enerjiyiCrossfadeEt ile) baslatmalidir - boylece Asama 3 akisinin, hale'yi
    // Şey'in seyahati SIRASINDA degil, temastan SONRA baslatmasina izin verilir.
    function enerjiKatmaniniEkle(balon) {
        var mevcut = balon.querySelector(".yaziyor-enerji");
        if (mevcut) {
            return mevcut;
        }
        balon.insertAdjacentHTML("afterbegin",
            '<span class="yaziyor-enerji" aria-hidden="true">' +
                '<span class="yaziyor-parlak"></span>' +
                '<span class="yaziyor-tutam"></span>' +
                '<span class="yaziyor-tutam"></span>' +
                '<span class="yaziyor-tutam"></span>' +
            '</span>');
        return balon.querySelector(".yaziyor-enerji");
    }

    function enerjiyiCrossfadeEt(enerji, sure) {
        if (!enerji) {
            return;
        }
        var azaltilmisHareket = window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (azaltilmisHareket) {
            enerji.style.opacity = "1";
        } else {
            enerji.animate(
                [{ opacity: 0 }, { opacity: 1 }],
                { duration: sure || 650, easing: "ease", fill: "forwards" }
            );
        }
    }

    // Yukleme balonunu Asama 1A/1C ile AYNI hale+tutam+yuzey sistemiyle
    // etkinlestirir - sonraki mesajlarin kullandigi TAM AYNI CSS siniflari ve
    // TAM AYNI JS fonksiyonu (yaziyorTutamlariBaslat) burada da kullanilir, ayri
    // bir kopya YOK.
    //
    // (Duzeltme - kare/dortgen hale hatasi) .yaziyor-yuzey artik .yaziyor-enerji
    // SARMALAYICISININ ICINE eklenmiyor. Nedeni: .yaziyor-yuzey'in
    // "border-radius: inherit" kurali KENDI EBEVEYNININ hesaplanmis degerini
    // alir. Sonraki mesajlarda .yaziyor-yuzey .yaziyor-balonu'nun DOGRUDAN
    // cocugudur, bu yuzden 1.25rem'i dogru miras alir. Ama .yaziyor-enerji'nin
    // KENDI border-radius'u YOK (bu ozellik miras alinmaz, baslangic degeri 0'dir)
    // - .yaziyor-yuzey o sarmalayicinin icine konunca "inherit" 0 aliyordu, bu da
    // kare/dortgen goruntuye yol aciyordu. Cozum: burada da .yaziyor-yuzey,
    // sonraki-mesaj yapisiyla BIREBIR ayni sekilde .yaziyor-balonu'nun DOGRUDAN
    // cocugu olarak eklenir (.yaziyor-enerji'nin DISINDA, kardes olarak).
    // .yaziyor-yuzey'in KENDI gorsel degerleri (box-shadow vb.) DEGISMEDI.
    //
    // Griyi tasiyan .yaziyor-arkaplan katmani, balonun kendi seffaflasan arka
    // planiyla AYNI senkron adimda degistigi icin (Asama 1'den beri kanitlanmis
    // teknik) gorsel bir sicrama olmaz.
    function balonuEtkinlestir(balon, satir) {
        if (balon.querySelector(".yaziyor-arkaplan")) {
            return; // zaten etkinlestirilmis (guvenlik agi ikinci kez tetiklenirse)
        }

        balon.classList.add("sonraki-hale");
        if (satir) {
            satir.classList.add("sonraki-hale");
        }

        var enerjiZatenVardi = !!balon.querySelector(".yaziyor-enerji");
        var enerji = enerjiKatmaniniEkle(balon);
        if (!enerjiZatenVardi) {
            // Buraya sadece azaltilmis-hareket guvenlik yolundan (Şey seyahati
            // hic calismadan) ulasildiysa girilir - normal Asama 3 akisinda
            // enerji katmani ve carprazlamasi ZATEN temastan hemen sonra
            // baslatilmis olur (bkz. parlamayiBalonaTasi -> temasAni).
            enerjiyiCrossfadeEt(enerji, 650);
        }

        // .yaziyor-yuzey (kalici dis yuzey) DOGRUDAN balonun cocugu olarak
        // eklenir - .yaziyor-enerji'nin DISINDA (yukaridaki duzeltme notuna bkz.).
        balon.insertAdjacentHTML("afterbegin",
            '<span class="yaziyor-yuzey" aria-hidden="true"></span>' +
            '<span class="yaziyor-arkaplan" aria-hidden="true"></span>');

        var tutamDurdur = yaziyorTutamlariBaslat(balon);
        window.addEventListener("pagehide", tutamDurdur, { once: true });
    }

    // Asama 1C: sonraki mesaj yukleme balonu icin rastgele plazma tutam olaylari.
    // Sabit @@keyframes YOK - her olay, uc yeniden-kullanilabilir #yaziyor-tutam
    // elemanindan BOSTA olan birini secip Element.animate() ile TAMAMEN
    // rastgelestirilmis bir kare dizisiyle canlandirir, sonra elemani havuza
    // iade eder. Yeni bir requestAnimationFrame dongusu YOK - zamanlama, her
    // olaydan sonra kendini yeniden kuran ozyineli bir setTimeout ile yapilir
    // (canvas/#parlama motoru burada hic devrede degil).
    function yaziyorTutamlariBaslat(balon) {
        var tutamlar = balon.querySelectorAll(".yaziyor-tutam");
        if (!tutamlar.length || !tutamlar[0].animate) {
            return function () {};
        }

        var azaltilmisHareket = window.matchMedia &&
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (azaltilmisHareket) {
            return function () {};
        }

        var havuz = Array.prototype.map.call(tutamlar, function (el) {
            return { el: el, mesgul: false };
        });

        // Balonun cevresinde 6 organik bolge - her biri kendi "disa dogru" aci
        // merkezine (0=sag, 90=asagi, 180=sol, 270/-90=yukari) ve balonun kendi
        // kutusuna gore yaklasik bir baslangic konumuna (%) sahip. Tam dortluk
        // (yalnizca yukarı/sag/asagi/sol) kasitli olarak KULLANILMADI.
        var BOLGELER = [
            { ad: "sag-ust", aci: -50, sol: [68, 90], ust: [-6, 20] },
            { ad: "sag", aci: 0, sol: [90, 104], ust: [30, 68] },
            { ad: "sag-alt", aci: 55, sol: [68, 90], ust: [76, 102] },
            { ad: "sol-alt", aci: 125, sol: [8, 30], ust: [76, 102] },
            { ad: "sol", aci: 180, sol: [-6, 8], ust: [30, 68] },
            { ad: "sol-ust", aci: 235, sol: [8, 30], ust: [-6, 20] }
        ];

        var sonBolgeAdi = null;
        var zamanlayiciId = null;
        var durduruldu = false;

        function rastgele(min, max) {
            return min + Math.random() * (max - min);
        }

        function bolgeSec() {
            var adaylar = BOLGELER.filter(function (b) { return b.ad !== sonBolgeAdi; });
            var havuzSecim = adaylar.length ? adaylar : BOLGELER;
            return havuzSecim[Math.floor(Math.random() * havuzSecim.length)];
        }

        function bosSlotBul() {
            for (var i = 0; i < havuz.length; i++) {
                if (!havuz[i].mesgul) {
                    return havuz[i];
                }
            }
            return null;
        }

        // Tek bir rastgele tutam olayi: konum/boyut/gradyan JS'ten dogrudan
        // stil olarak yazilir (statik), yalnizca transform/opacity Element.animate()
        // ile canlandirilir. Kok (baslangic konumu + gradyanin guclu ucu) SABIT
        // kalir; sadece disa tasan UC buyuyup/kucularak "uzanma" hissi verir -
        // boylece hicbir zaman balondan kopup giden bir parcacik gibi gorunmez.
        function birOlayCalistir() {
            var slot = bosSlotBul();
            if (!slot) {
                return; // uc tutam da mesgul - bu turu atla, sonraki zamanlanmis denemeye birak
            }

            var bolge = bolgeSec();
            sonBolgeAdi = bolge.ad;

            var el = slot.el;
            var stil = getComputedStyle(el);
            var renk1 = stil.getPropertyValue("--tutam-1").trim();
            var renk2 = stil.getPropertyValue("--tutam-2").trim();

            var solYuzde = rastgele(bolge.sol[0], bolge.sol[1]);
            var ustYuzde = rastgele(bolge.ust[0], bolge.ust[1]);
            var aciSon = (bolge.aci + rastgele(-18, 18)) * Math.PI / 180;
            var aciOrta = (bolge.aci + rastgele(-30, 30)) * Math.PI / 180;

            var uzunluk = rastgele(8, 22);
            var ortaUzunluk = uzunluk * rastgele(0.55, 0.72);

            var dxSon = Math.cos(aciSon) * uzunluk;
            var dySon = Math.sin(aciSon) * uzunluk;
            var dxOrta = Math.cos(aciOrta) * ortaUzunluk;
            var dyOrta = Math.sin(aciOrta) * ortaUzunluk;

            var kokX = rastgele(10, 24);
            var kokY = 50 + rastgele(-12, 12);
            var karisim = rastgele(26, 46);
            var sonum = rastgele(64, 78);

            el.style.left = solYuzde + "%";
            el.style.top = ustYuzde + "%";
            el.style.width = rastgele(16, 32) + "px";
            el.style.height = rastgele(8, 18) + "px";
            el.style.transformOrigin = kokX + "% " + kokY + "%";
            el.style.background =
                "radial-gradient(ellipse at " + kokX + "% " + kokY + "%, " +
                renk1 + " 0%, " + renk2 + " " + karisim + "%, transparent " + sonum + "%)";

            var donusOrta = rastgele(-16, 16);
            var donusSon = donusOrta + rastgele(-10, 10);
            var tepeOpaklik = rastgele(0.3, 0.62);

            var kareler = [
                { transform: "translate(0px, 0px) rotate(0deg) scale(0.5, 0.6)", opacity: 0 },
                {
                    transform: "translate(" + (dxOrta * 0.5) + "px, " + (dyOrta * 0.5) + "px) rotate(" +
                        (donusOrta * 0.4) + "deg) scale(" + rastgele(0.85, 1.05) + ", " + rastgele(0.55, 0.75) + ")",
                    opacity: tepeOpaklik * 0.7,
                    offset: 0.3
                },
                {
                    transform: "translate(" + dxOrta + "px, " + dyOrta + "px) rotate(" + donusOrta +
                        "deg) scale(" + rastgele(1.05, 1.3) + ", " + rastgele(0.5, 0.68) + ")",
                    opacity: tepeOpaklik,
                    offset: 0.55
                },
                {
                    transform: "translate(" + dxSon + "px, " + dySon + "px) rotate(" + donusSon +
                        "deg) scale(" + rastgele(0.55, 0.75) + ", " + rastgele(0.4, 0.55) + ")",
                    opacity: 0
                }
            ];

            slot.mesgul = true;
            var animasyon = el.animate(kareler, {
                duration: rastgele(700, 1600),
                easing: "ease-in-out",
                fill: "none"
            });

            function serbestBirak() {
                slot.mesgul = false;
                el.style.opacity = "0";
            }
            animasyon.onfinish = serbestBirak;
            animasyon.oncancel = serbestBirak;
        }

        function sonrakiZamanlayiciyiKur() {
            if (durduruldu) {
                return;
            }
            zamanlayiciId = setTimeout(function () {
                birOlayCalistir();
                sonrakiZamanlayiciyiKur();
            }, rastgele(350, 1800));
        }

        sonrakiZamanlayiciyiKur();

        return function durdur() {
            durduruldu = true;
            if (zamanlayiciId) {
                clearTimeout(zamanlayiciId);
            }
        };
    }

    // Sag-ust departman secicisi composer'in DISINDA (bkz. gorev talimati -
    // composer'a yeni bir kontrol eklenmiyor/composer yeniden tasarlanmiyor).
    // Secim, composer formunun icindeki gizli #departman-id-girdi alanina
    // senkronlanir - tam sayfa yenilemesi GEREKMEZ, sadece o an doldurulan
    // Soru'nun yaninda gonderilecek deger guncellenir. SohbetId hidden
    // input'u ile AYNI desen (bkz. asagidaki composer IIFE'si).
    (function () {
        var secici = document.getElementById("departman-secici");
        var gizliGirdi = document.getElementById("departman-id-girdi");
        if (!secici || !gizliGirdi) {
            return;
        }
        secici.addEventListener("change", function () {
            gizliGirdi.value = secici.value;
        });
    })();

    (function () {
        var soruFormu = document.getElementById("soru-formu");
        var soruGirdisi = document.getElementById("Soru");
        var sorDugmesi = document.getElementById("sor-dugmesi");

        // Tam bir satirlik textarea yuksekligi (line-height + dikey padding).
        // Sayfa yuklenirken BIR KEZ olculup onbellege ALINMAZ, her cagride
        // hesaplanmis stilden turer - web fontu gec yuklense, pencere yeniden
        // boyutlansa veya tarayici zoom'u degisse de referans bayatlamaz.
        //
        // DIKKAT: line-height "normal" ise parseFloat NaN doner ve NaN ile
        // yapilan her aritmetik/karsilastirma sessizce bozulur.
        // .soru-formu-girdi line-height'i 1.5 olarak acikca veriyor ama o
        // satir bir gun kalkarsa hata fark edilmez; bu yuzden yaklasik bir
        // yedek (1.2 x font-size, tarayicilarin "normal" icin kullandigi
        // tipik oran) konuluyor.
        function tekSatirYuksekligi() {
            var stil = getComputedStyle(soruGirdisi);
            var satirPx = parseFloat(stil.lineHeight);
            if (!satirPx) {
                satirPx = parseFloat(stil.fontSize) * 1.2;
            }
            return satirPx + parseFloat(stil.paddingTop) + parseFloat(stil.paddingBottom);
        }

        // Metin buyudukce textarea'yi SADECE asagi dogru buyutur. Yatay
        // geometri (genislik, padding'ler, buton konumu) satir sayisindan
        // BAGIMSIZ olarak sabittir - bkz. CSS'teki "MODU YOKTUR" notu. Bu
        // yuzden burada olculen ile uygulanan geometri her zaman ayni;
        // "dar'da olc, genis'te uygula" geri besleme dongusu (eski koddaki
        // titreme) olusamaz.
        function otomatikBoyutlandir() {
            // "tasiyor" karari HER ZAMAN class KALDIRILMIS haldeki (yani TAM,
            // dusurulmemis) tavana gore verilir - class SU AN eklenmis olsa
            // bile ONCE kaldirilip OYLE olculur. Bunun sebebi width/wrapping
            // DEGIL (.tasiyor sadece max-height/margin degistirir, ikisi de
            // scrollHeight'i ETKILEMEZ - eski koddaki padding-right/wrapping
            // dongusuyle KARISTIRILMASIN): sadece getComputedStyle(...).maxHeight
            // OKUMASI class'a gore FARKLI deger dondurur (class varken kucuk
            // tavan) - class kaldirilmadan olculse yanlislikla kucuk tavana
            // gore "hala tasiyor" denip class hicbir zaman kalkamazdi.
            soruGirdisi.classList.remove("tasiyor");
            soruGirdisi.style.height = "auto";
            var tamTavanPx = parseFloat(getComputedStyle(soruGirdisi).maxHeight) || Infinity;
            soruGirdisi.classList.toggle("tasiyor", soruGirdisi.scrollHeight > tamTavanPx);

            // max-height (.tasiyor eklendiyse dusurulmus tavan) asilinca
            // tavanda kalir ve overflow-y "auto"ya gecer (kutu icinde
            // kaydirma) - kaydirma cubugu artik textarea'nin KENDI kutusunun
            // disinda kalan (.tasiyor'un ekledigi margin-bottom) buton
            // seridine hic uzanmaz, bkz. CSS'teki .tasiyor yorumu.
            var maksYukseklikPx = parseFloat(getComputedStyle(soruGirdisi).maxHeight) || Infinity;
            var yeniYukseklikPx = Math.min(soruGirdisi.scrollHeight, maksYukseklikPx);
            soruGirdisi.style.height = yeniYukseklikPx + "px";
            soruGirdisi.style.overflowY = soruGirdisi.scrollHeight > maksYukseklikPx ? "auto" : "hidden";
            return yeniYukseklikPx;
        }

        otomatikBoyutlandir();

        soruGirdisi.addEventListener("input", otomatikBoyutlandir);

        // Enter -> gonder, Shift+Enter -> yeni satir. requestSubmit()
        // kullanilir (form.submit() DEGIL) - boylece "submit" olayi/required
        // ve maxlength dogrulamasi ve asagidaki mevcut submit dinleyicisi
        // AYNEN calisir, Soru==null riski olusmaz.
        soruGirdisi.addEventListener("keydown", function (e) {
            if (e.key === "Enter" && !e.shiftKey && !e.isComposing) {
                e.preventDefault();
                // Bir gonderim zaten islemdeyse (bkz. asagidaki submit
                // dinleyicisindeki dugme.disabled kilidi) Enter'a basili
                // kalma/tekrar basma YENI bir requestSubmit() TETIKLEMEZ.
                if (sorDugmesi.disabled) {
                    return;
                }
                if (typeof soruFormu.requestSubmit === "function") {
                    soruFormu.requestSubmit();
                } else {
                    sorDugmesi.click();
                }
            }
        });

        // Mevcut submit dinleyicisindeki gorsel-temizleme (soru-girdi-temizlendi,
        // "value"ya DOKUNMUYOR) korunuyor - burada SADECE yukseklik/scroll
        // sifirlanir, bu da "value" ile ilgisiz, POST'u hicbir sekilde etkilemez.
        soruFormu.addEventListener("submit", function () {
            // Bir gonderim zaten islemdeyse (asagidaki dinleyicideki
            // dugme.disabled kilidi) bu submit olayi orada TAMAMEN yok
            // sayilacak - kutuyu da sifirlamayiz. Bu dinleyici once kayitli
            // oldugu icin kilidi burada ayrica kontrol etmek gerekiyor.
            if (sorDugmesi.disabled) {
                return;
            }
            // Kutu gorsel olarak tek-satir/kompakt haline doner. Geometri
            // (genislik/padding) zaten satir sayisindan bagimsiz oldugu icin
            // sifirlanacak sey yukseklik ve (varsa) .tasiyor'un ekledigi
            // buton-seridi boslugu.
            soruGirdisi.classList.remove("tasiyor");
            soruGirdisi.style.height = tekSatirYuksekligi() + "px";
            soruGirdisi.style.overflowY = "hidden";
            soruGirdisi.scrollTop = 0;
        });
    })();

    document.getElementById("soru-formu").addEventListener("submit", function (event) {
        var dugme = document.getElementById("sor-dugmesi");

        // Bir gonderim zaten islemdeyse (dugme.disabled) bu ikinci/ucuncu/...
        // submit olayini (Enter tekrari, dugmeye art arda tiklama, vb.)
        // TAMAMEN yok say - ne yeni balon eklenir ne native POST devam eder.
        // Kilit BURADA, hicbir baska koddan once, senkron olarak kontrol
        // edilir; bir kere kilitlendikten sonra ayni JS turunda/sonrasinda
        // gelen her ek submit olayi bunu gorur.
        if (dugme.disabled) {
            event.preventDefault();
            return;
        }

        dugme.disabled = true;
        // Ok simgesi -> donen spinner (CSS: #sor-dugmesi.yukleniyor). Metin
        // YOK ("Bekleyin..." kaldirildi) - buton boyutu/sekli DEGISMEZ,
        // sadece ic simge CSS ile degisir.
        dugme.classList.add("yukleniyor");

        var selamlama = document.getElementById("selamlama");
        var ilkMesajMi = !!selamlama;
        if (selamlama) {
            selamlama.style.display = "none";
        }

        var kutu = document.getElementById("mesajKutusu");
        // Ilk mesajda #mesajKutusu hala sayfa yuklendiginde (0 mesajken) sunucudan
        // gelen "mesaj-kutusu-bos" class'ini (overflow-y:hidden) tasiyor - artik
        // gercek icerik eklenecegi icin bunu hemen kaldiriyoruz, yoksa asagidaki
        // kutu.scrollTop=kutu.scrollHeight yanlis/eksik bir konuma kayiyordu.
        kutu.classList.remove("mesaj-kutusu-bos");
        var soruGirdisi = document.getElementById("Soru");
        var soruMetni = soruGirdisi.value;

        // Girdiyi SADECE gorsel olarak bosaltir (rengi seffaf yapar) - "value"
        // ozelligine DOKUNULMAZ. Native POST'un form-data listesi bu "submit"
        // dinleyicisi bittikten SONRA olusturulur; onceden buraya "value = ''"
        // yazilmasi Soru'nun null/bos gitmesine (duzeltilen hataya) yol acmisti.
        soruGirdisi.classList.add("soru-girdi-temizlendi");

        // soruMetni YUKARIDA zaten guvenle okundu - "Soru" simdi kilitlenebilir.
        // disabled DEGIL readOnly kullanilir: disabled bir form kontrolunun
        // degeri native POST'un form-data listesine HIC dahil edilmez (bu da
        // Soru==null hatasini GERI GETIRIR), readOnly ise degeri POST'a
        // aynen dahil eder - sadece kullanicinin yazmasini engeller. Boylece
        // istek surerken (spinner gosterilirken) kullanici "gorunmez" yeni
        // metin yazip auto-grow'u tetikleyemez; Enter/Shift+Enter da zaten
        // asagidaki dugme.disabled kilidiyle etkisiz kalir.
        soruGirdisi.readOnly = true;

        var soruBalonu = document.createElement("div");
        soruBalonu.className = "d-flex justify-content-end mb-3 mesaj-satiri";
        soruBalonu.innerHTML = '<div class="alert mb-0 chat-balon balon-soru" style="max-width:70%;"></div>';
        soruBalonu.querySelector("div").textContent = soruMetni;
        kutu.appendChild(soruBalonu);

        var yaziyorSatiri = document.createElement("div");
        // "sonraki-hale" satira da eklenir: #mesajKutusu (overflow-y:auto) her
        // sonraki-mesaj gonderiminde scroll-to-bottom yapildigi icin bu satirin
        // ALTINDA hemen hemen hic bosluk kalmiyor - hale disariya tastiginda
        // #mesajKutusu'nun kirpma sinirina carpip duz bir cizgide kesiliyordu.
        // Bu satira ozel (yalnizca .sonraki-hale) fazladan padding-bottom, hale
        // tamamen sonmeden o sinira ulasmasini engeller (bkz. asagidaki CSS).
        yaziyorSatiri.className = "d-flex justify-content-start mb-3 yaziyor-satiri mesaj-satiri" +
            (ilkMesajMi ? "" : " sonraki-hale");
        // Ilk mesaj: balon TAMAMEN ORIJINAL/degismemis - #parlama FLIP ile buraya
        // gezinecek (bkz. asagi), asama 2'ye kadar boyle kalacak. Sonraki mesajlar:
        // balon ayni gorunumu korur (ayni .chat-balon/.balon-cevap/max-width:70%),
        // ama ekstra dekoratif katmanlar icerir: .yaziyor-parlak (Asama 1A temel
        // hale), uc ozdes .yaziyor-tutam (Asama 1C: sabit siniflar/keyframes YOK -
        // hepsi JS tarafindan yaziyorTutamlariBaslat ile rastgele canlandirilan,
        // yeniden kullanilabilir bir havuz), .yaziyor-yuzey (tamamlanmis, ince dis
        // enerji yuzeyi - balonun silueti boyunca box-shadow ile, tutamlardan
        // SONRA/uzerinde durur ki aktif bir tutam bu yuzeyden cikiyormus gibi
        // gorunsun) ve .yaziyor-arkaplan (griyi tasiyan katman, hepsinin ustunde,
        // noktalarin altinda) - #parlama'ya hic dokunulmaz.
        yaziyorSatiri.innerHTML = ilkMesajMi
            ? '<div class="alert mb-0 chat-balon balon-cevap yaziyor-balonu" style="max-width:70%;">' +
              '<span class="nokta">.</span><span class="nokta">.</span><span class="nokta">.</span>' +
              '</div>'
            : '<div class="alert mb-0 chat-balon balon-cevap yaziyor-balonu sonraki-hale" style="max-width:70%;">' +
              '<span class="yaziyor-parlak" aria-hidden="true"></span>' +
              '<span class="yaziyor-tutam" aria-hidden="true"></span>' +
              '<span class="yaziyor-tutam" aria-hidden="true"></span>' +
              '<span class="yaziyor-tutam" aria-hidden="true"></span>' +
              '<span class="yaziyor-yuzey" aria-hidden="true"></span>' +
              '<span class="yaziyor-arkaplan" aria-hidden="true"></span>' +
              '<span class="nokta">.</span><span class="nokta">.</span><span class="nokta">.</span>' +
              '</div>';
        kutu.appendChild(yaziyorSatiri);

        // parlamayiBalonaTasi #parlama'yi "su an gorunen konumuyla birebir
        // ayni noktaya" sabitleyerek absolute'tan fixed'e gecirir (bkz. o
        // fonksiyondaki yorum) - bu yuzden BURADA, herhangi bir scroll
        // olmadan HEMEN cagrilir; scroll'u ondan ONCEYE almak #parlama'yi
        // yanlis/kaymis bir noktada dondurup gorunur bir sicramaya yol
        // aciyordu (kisa mesajlarda bile). scroll-to-bottom ONDAN SONRA.
        if (ilkMesajMi) {
            var parlama = document.getElementById("parlama");
            var yaziyorBalonu = yaziyorSatiri.querySelector(".chat-balon");
            if (parlama && yaziyorBalonu) {
                parlamayiBalonaTasi(parlama, yaziyorBalonu, yaziyorSatiri);
            }
        } else {
            var sonrakiBalon = yaziyorSatiri.querySelector(".chat-balon");
            if (sonrakiBalon) {
                var tutamDurdur = yaziyorTutamlariBaslat(sonrakiBalon);
                window.addEventListener("pagehide", tutamDurdur, { once: true });
            }
        }

        kutu.scrollTop = kutu.scrollHeight;
    });
</script>
