@page
@model arayuz.Pages.IndexModel

@{
    ViewData["Title"] = "Sorgu";
    ViewData["TamGenislik"] = true;
}

<style>
    .chat-balon {
        border-radius: 1.25rem;
        padding: 1rem 1.4rem;
    }

    .yaziyor-balonu .nokta {
        display: inline-block;
        font-size: 1.5rem;
        line-height: 0;
        animation: noktaYanipSon 1.4s infinite ease-in-out both;
        position: relative;
        z-index: 1;
    }

    .yaziyor-balonu .nokta:nth-child(1) {
        animation-delay: -0.32s;
    }

    .yaziyor-balonu .nokta:nth-child(2) {
        animation-delay: -0.16s;
    }

    @@keyframes noktaYanipSon {
        0%, 80%, 100% {
            opacity: 0.2;
        }

        40% {
            opacity: 1;
        }
    }

    .yaziyor-balonu {
        position: relative;
        z-index: 0;
        overflow: visible;
    }

    .soru-formu-girdi {
        border-radius: 999px;
        padding: 0.75rem 1.25rem;
    }

    .soru-formu-dugme {
        border-radius: 999px;
        padding: 0.75rem 1.5rem;
    }

    #mesajKutusu {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        position: relative;
        z-index: 0;
        scrollbar-width: thin;
        scrollbar-color: var(--bs-secondary-color) transparent;
    }

    .mesaj-satiri {
        width: 100%;
        max-width: 800px;
    }

    .balon-soru {
        background-color: var(--bs-secondary-bg);
        color: var(--bs-body-color);
    }

    .balon-cevap {
        background-color: var(--bs-tertiary-bg);
        color: var(--bs-body-color);
        border: 1px solid var(--bs-border-color);
    }

    #selamlama {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 1;
        text-align: center;
        width: max-content;
        max-width: 90%;
    }

    #selamlama-baslik {
        font-size: 1.6rem;
        color: var(--bs-body-color);
    }

    #selamlama-alt {
        font-size: 0.95rem;
        color: var(--bs-secondary-color);
        margin-top: 0.25rem;
    }

    #parlama {
        --parlama-1: #60a5fa;
        --parlama-2: #a78bfa;
        --parlama-3: #38bdf8;
        position: absolute;
        top: 50%;
        left: 50%;
        width: 240px;
        height: 240px;
        pointer-events: none;
        z-index: -1;
        filter: blur(20px);
        opacity: 0.95;
        transform: translate(-50%, -50%);
        animation: parlamaSalinim 11s ease-in-out infinite;
        transition: top 1s ease, left 1s ease, right 1s ease, bottom 1s ease,
                    width 1s ease, height 1s ease, filter 1s ease, opacity 0.8s ease;
    }

    [data-bs-theme="dark"] #parlama {
        --parlama-1: #4f46e5;
        --parlama-2: #9333ea;
        --parlama-3: #7c3aed;
    }

    #parlama.parlama-gizli {
        opacity: 0;
    }

    .parlama-katman {
        position: absolute;
    }

    .parlama-katman-1 {
        inset: 8% 38% 32% 6%;
        background: var(--parlama-1);
        border-radius: 58% 42% 65% 35% / 45% 55% 40% 60%;
        transform: translate(-10%, -6%) scale(1);
        animation: parlamaKatman1 3s ease-in-out infinite;
    }

    .parlama-katman-2 {
        inset: 28% 6% 10% 32%;
        background: var(--parlama-2);
        border-radius: 42% 58% 40% 60% / 55% 45% 60% 40%;
        transform: translate(10%, 6%) rotate(0deg);
        animation: parlamaKatman2 5s ease-out infinite;
    }

    .parlama-katman-3 {
        inset: 18% 20% 16% 22%;
        background: var(--parlama-3);
        border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
        transform: translate(-4%, 8%) scale(0.9);
        animation: parlamaKatman3 7s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    }

    #parlama.parlama-balonda {
        inset: -30%;
        top: auto;
        left: auto;
        width: auto;
        height: auto;
        filter: blur(10px);
        opacity: 0.95;
        animation: parlamaSalinimKucuk 4s ease-in-out infinite;
    }

    .parlama-balonda .parlama-katman-1 {
        animation-duration: 1.2s;
    }

    .parlama-balonda .parlama-katman-2 {
        animation-duration: 2s;
    }

    .parlama-balonda .parlama-katman-3 {
        animation-duration: 2.8s;
    }

    @@keyframes parlamaKatman1 {
        0% {
            transform: translate(-10%, -6%) scale(1) rotate(0deg);
            border-radius: 58% 42% 65% 35% / 45% 55% 40% 60%;
        }

        17% {
            transform: translate(6%, 8%) scale(1.15) rotate(-12deg);
            border-radius: 40% 60% 45% 55% / 60% 35% 65% 40%;
        }

        38% {
            transform: translate(-14%, 4%) scale(0.88) rotate(10deg);
            border-radius: 65% 35% 55% 45% / 40% 60% 35% 65%;
        }

        61% {
            transform: translate(8%, -12%) scale(1.2) rotate(-6deg);
            border-radius: 45% 55% 35% 65% / 55% 45% 60% 40%;
        }

        83% {
            transform: translate(-4%, 10%) scale(0.95) rotate(14deg);
            border-radius: 55% 45% 60% 40% / 35% 65% 45% 55%;
        }

        100% {
            transform: translate(-10%, -6%) scale(1) rotate(0deg);
            border-radius: 58% 42% 65% 35% / 45% 55% 40% 60%;
        }
    }

    @@keyframes parlamaKatman2 {
        0% {
            transform: translate(10%, 6%) scale(0.95) rotate(0deg);
            border-radius: 42% 58% 40% 60% / 55% 45% 60% 40%;
        }

        17% {
            transform: translate(-8%, -10%) scale(1.1) rotate(40deg);
            border-radius: 60% 40% 55% 45% / 40% 60% 35% 65%;
        }

        38% {
            transform: translate(12%, 4%) scale(0.85) rotate(-30deg);
            border-radius: 35% 65% 60% 40% / 65% 35% 55% 45%;
        }

        61% {
            transform: translate(-6%, 12%) scale(1.18) rotate(60deg);
            border-radius: 55% 45% 35% 65% / 45% 55% 40% 60%;
        }

        83% {
            transform: translate(9%, -6%) scale(0.92) rotate(-15deg);
            border-radius: 48% 52% 58% 42% / 52% 48% 62% 38%;
        }

        100% {
            transform: translate(10%, 6%) scale(0.95) rotate(0deg);
            border-radius: 42% 58% 40% 60% / 55% 45% 60% 40%;
        }
    }

    @@keyframes parlamaKatman3 {
        0% {
            transform: translate(-4%, 8%) scale(0.9) rotate(0deg);
            border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
        }

        17% {
            transform: translate(10%, -8%) scale(1.22) rotate(-20deg);
            border-radius: 35% 65% 65% 35% / 40% 40% 60% 60%;
        }

        38% {
            transform: translate(-12%, -4%) scale(0.82) rotate(18deg);
            border-radius: 55% 45% 40% 60% / 65% 35% 45% 55%;
        }

        61% {
            transform: translate(6%, 12%) scale(1.1) rotate(-8deg);
            border-radius: 40% 60% 55% 45% / 35% 65% 50% 50%;
        }

        83% {
            transform: translate(-8%, -10%) scale(0.95) rotate(25deg);
            border-radius: 65% 35% 45% 55% / 55% 45% 35% 65%;
        }

        100% {
            transform: translate(-4%, 8%) scale(0.9) rotate(0deg);
            border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
        }
    }

    @@keyframes parlamaSalinim {
        0%, 100% {
            transform: translate(-50%, -50%) rotate(-4deg);
        }

        50% {
            transform: translate(-50%, -50%) rotate(4deg);
        }
    }

    @@keyframes parlamaSalinimKucuk {
        0%, 100% {
            transform: rotate(-6deg);
        }

        50% {
            transform: rotate(6deg);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        #parlama,
        #parlama.parlama-balonda,
        .parlama-katman-1,
        .parlama-katman-2,
        .parlama-katman-3,
        .parlama-balonda .parlama-katman-1,
        .parlama-balonda .parlama-katman-2,
        .parlama-balonda .parlama-katman-3 {
            animation: none;
        }
    }
</style>

<div class="d-flex" style="height:100%;">
    <div class="border-end" style="width:260px;">
        <div class="p-3 h-100">
            @await Component.InvokeAsync("SohbetPaneli")
        </div>
    </div>
    <div class="flex-grow-1 ps-3 d-flex flex-column" style="min-width:0;">
        <div id="mesajKutusu" class="mb-4">
            @if (Model.Mesajlar.Count == 0)
            {
                <div id="selamlama">
                    <div id="selamlama-baslik"></div>
                    <div id="selamlama-alt">Nasıl yardımcı olabilirim?</div>
                </div>
            }
            <div id="parlama" class="@(Model.Mesajlar.Count > 0 ? "parlama-gizli" : "")">
                <div class="parlama-katman parlama-katman-1"></div>
                <div class="parlama-katman parlama-katman-2"></div>
                <div class="parlama-katman parlama-katman-3"></div>
            </div>
            @foreach (var m in Model.Mesajlar)
            {
                if (m.Rol == "soru")
                {
                    <div class="d-flex justify-content-end mb-3 mesaj-satiri">
                        <div class="alert mb-0 chat-balon balon-soru" style="max-width:70%;">@m.Metin</div>
                    </div>
                }
                else
                {
                    <div class="d-flex justify-content-start mb-3 mesaj-satiri">
                        <div class="alert mb-0 chat-balon balon-cevap" style="max-width:70%;">@m.Metin</div>
                    </div>
                }
            }
        </div>

        <form method="post" id="soru-formu" class="d-flex gap-2 mx-auto mb-5 px-3" style="max-width:800px; width:100%;">
            <input type="hidden" name="SohbetId" value="@Model.SohbetId" />
            <input asp-for="Soru" class="form-control soru-formu-girdi flex-grow-1" placeholder="Sorunuzu yazın" />
            <button type="submit" class="btn btn-primary soru-formu-dugme" id="sor-dugmesi">Sor</button>
        </form>
    </div>
</div>

<script>
    (function () {
        var kutu = document.getElementById("mesajKutusu");
        kutu.scrollTop = kutu.scrollHeight;
    })();
</script>

<script>
    (function () {
        var baslik = document.getElementById("selamlama-baslik");
        if (!baslik) {
            return;
        }

        var saat = new Date().getHours();
        var metin;

        if (saat >= 5 && saat < 12) {
            metin = "Günaydın";
        } else if (saat >= 12 && saat < 18) {
            metin = "İyi günler";
        } else if (saat >= 18 && saat < 22) {
            metin = "İyi akşamlar";
        } else {
            metin = "İyi geceler";
        }

        baslik.textContent = metin;
    })();
</script>

<script>
    document.getElementById("soru-formu").addEventListener("submit", function () {
        var dugme = document.getElementById("sor-dugmesi");
        dugme.disabled = true;
        dugme.textContent = "Bekleyin...";

        var kutu = document.getElementById("mesajKutusu");
        var soruMetni = document.getElementById("Soru").value;

        var soruBalonu = document.createElement("div");
        soruBalonu.className = "d-flex justify-content-end mb-3 mesaj-satiri";
        soruBalonu.innerHTML = '<div class="alert mb-0 chat-balon balon-soru" style="max-width:70%;"></div>';
        soruBalonu.querySelector("div").textContent = soruMetni;
        kutu.appendChild(soruBalonu);

        setTimeout(function () {
            document.getElementById("Soru").value = "";
        }, 0);

        var yaziyorSatiri = document.createElement("div");
        yaziyorSatiri.className = "d-flex justify-content-start mb-3 yaziyor-satiri mesaj-satiri";
        yaziyorSatiri.innerHTML =
            '<div class="alert mb-0 chat-balon balon-cevap yaziyor-balonu" style="max-width:70%;">' +
            '<span class="nokta">.</span><span class="nokta">.</span><span class="nokta">.</span>' +
            '</div>';
        kutu.appendChild(yaziyorSatiri);

        var parlama = document.getElementById("parlama");
        console.log("[parlama] eleman bulundu mu:", !!parlama);
        if (parlama) {
            var yaziyorBalonu = yaziyorSatiri.querySelector(".chat-balon");
            console.log("[parlama] hedef balon bulundu mu:", !!yaziyorBalonu);
            if (yaziyorBalonu) {
                yaziyorBalonu.appendChild(parlama);
                parlama.classList.remove("parlama-gizli");
                parlama.classList.add("parlama-balonda");
                console.log("[parlama] tasindi, yeni ebeveyn balon mu:", parlama.parentElement === yaziyorBalonu);
            }
        }

        kutu.scrollTop = kutu.scrollHeight;
    });
</script>
